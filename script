do
  if G.POCKETESP and G.POCKETESP.Off then pcall(function() G.POCKETESP.Off() end) end
  G.POCKETESP = nil

  local Players = game:GetService("Players")
  local RUS     = game:GetService("RunService")
  local WS      = game:GetService("Workspace")
  local LP      = Players.LocalPlayer

  local E = {
    Enabled = true,
    Doors   = 0,
    Status  = "等待 PocketDimension",
    Conn    = nil,
  }
  G.POCKETESP = E

  local GREEN = Color3.fromRGB(60, 255, 140)
  local RED   = Color3.fromRGB(255, 70, 90)
  local GREY  = Color3.fromRGB(200, 205, 215)

  local ui = {}
  local doorsModel, roomsModel, roomParts
  local rpBack
  local acc, retryT = 0, 0

  local function clearUI()
    for _, u in pairs(ui) do
      pcall(function() if u.bb then u.bb:Destroy() end end)
    end
    ui = {}
    E.Doors = 0
  end

  local function roomOf(inst)
    local cur = inst
    while cur and cur ~= roomsModel do
      if cur.Parent == roomsModel then return cur.Name end
      cur = cur.Parent
    end
    return "?"
  end

  local function build(portal)
    local bb = Instance.new("BillboardGui")
    bb.Name = "PocketESP_UI"
    bb.Adornee = portal
    bb.Size = UDim2.fromOffset(150, 36)
    bb.StudsOffsetWorldSpace = Vector3.new(0, 6.8, 0)
    bb.AlwaysOnTop = true
    bb.MaxDistance = 420
    bb.LightInfluence = 0
    bb.ResetOnSpawn = false
    bb.Parent = portal

    local lbl = Instance.new("TextLabel")
    lbl.Name = "Lbl"
    lbl.Size = UDim2.fromScale(1, 1)
    lbl.BackgroundColor3 = Color3.fromRGB(6, 8, 10)
    lbl.BackgroundTransparency = 0.42
    lbl.BorderSizePixel = 0
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 19
    lbl.TextColor3 = GREY
    lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    lbl.TextStrokeTransparency = 0.35
    lbl.Text = ""
    lbl.Parent = bb

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 7)
    corner.Parent = lbl

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1.6
    stroke.Color = GREY
    stroke.Transparency = 0.25
    stroke.Parent = lbl

    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 2)
    pad.PaddingBottom = UDim.new(0, 2)
    pad.Parent = lbl

    return bb, lbl, stroke
  end

  local function buildAll()
    clearUI()
    local pd = WS:FindFirstChild("PocketDimension")
    if not pd then E.Status = "等待 PocketDimension"; return false end
    doorsModel = pd:FindFirstChild("Doors")
    roomsModel = pd:FindFirstChild("Rooms")
    if not doorsModel or not roomsModel then
      E.Status = "PocketDimension 缺 Doors/Rooms"
      return false
    end
    roomParts = {}
    for _, r in ipairs(roomsModel:GetChildren()) do
      for _, c in ipairs(r:GetDescendants()) do
        if c:IsA("BasePart") then roomParts[#roomParts + 1] = c end
      end
    end
    rpBack = RaycastParams.new()
    rpBack.FilterType = Enum.RaycastFilterType.Include
    rpBack.FilterDescendantsInstances = roomParts

    for _, d in ipairs(doorsModel:GetChildren()) do
      local portal = d:FindFirstChild("Portal")
      if portal then
        local bb, lbl, stroke = build(portal)
        ui[d] = { bb = bb, lbl = lbl, stroke = stroke, portal = portal }
        E.Doors = E.Doors + 1
      end
    end
    E.Status = string.format("已挂 %d 扇门", E.Doors)
    return E.Doors > 0
  end

  local function judge(portal, void)
    if void and void.Transparency >= 0.5 then return true end
    if not rpBack or not portal then return false end
    local back = -portal.CFrame.LookVector
    local hit = WS:Raycast(portal.Position + back * 7.4, back * 330, rpBack)
    if hit then
      if roomOf(hit.Instance) == "Abyss" then return false end
      return true
    end
    return false
  end
  E.Judge = judge

  local function refresh()
    if not doorsModel or not doorsModel.Parent then
      if os.clock() - retryT < 2 then return end
      retryT = os.clock()
      if not buildAll() then return end
    end
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local pos = root and root.Position or Vector3.new()
    for d, u in pairs(ui) do
      if u.bb.Parent then
        local isTrue = judge(u.portal, d:FindFirstChild("Void"))
        local dist = math.floor((pos - u.portal.Position).Magnitude)
        if isTrue then
          u.lbl.Text = "真  " .. dist .. "m"
          u.lbl.TextColor3 = GREEN
          u.stroke.Color = GREEN
        else
          u.lbl.Text = "假  " .. dist .. "m"
          u.lbl.TextColor3 = RED
          u.stroke.Color = RED
        end
        u.lbl.TextSize = dist < 40 and 22 or (dist < 100 and 19 or 16)
        u.bb.Size = UDim2.fromOffset(dist < 100 and 150 or 130, dist < 100 and 36 or 30)
      end
    end
  end

  E.SetEnabled = function(v)
    E.Enabled = v and true or false
    if E.Enabled then
      if not doorsModel or E.Doors == 0 then buildAll() end
      E.Status = string.format("已挂 %d 扇门", E.Doors)
    else
      clearUI()
      E.Status = "已关闭"
    end
    return E.Enabled
  end

  E.Dump = function()
    local alive = 0
    for _, u in pairs(ui) do if u.bb.Parent then alive = alive + 1 end end
    return string.format("PocketESP Enabled=%s Doors=%d Alive=%d Status=%s",
      tostring(E.Enabled), E.Doors, alive, tostring(E.Status))
  end

  E.Off = function()
    E.Enabled = false
    if E.Conn then pcall(function() E.Conn:Disconnect() end) end
    E.Conn = nil
    clearUI()
    if G.POCKETESP == E then G.POCKETESP = nil end
  end

  buildAll()
  E.Conn = RUS.Heartbeat:Connect(function(dt)
    if not E.Enabled then return end
    acc = acc + dt
    if acc < 0.15 then return end
    acc = 0
    refresh()
  end)
  print("[POCKETESP] 已加载 · 只做门后虚空透视 · 门 " .. tostring(E.Doors))
end

-- ==========
-- ==========
do
  if G.GUARD173 and G.GUARD173.Off then pcall(function() G.GUARD173.Off() end) end
  G.GUARD173 = nil

  local RS = game:GetService("ReplicatedStorage")
  local CS = game:GetService("CollectionService")
  local WS = game:GetService("Workspace")

  local L = {
    Enabled = false, Stopped = false, Running = false, Paused = false,
    Patched = false,
    NoBlink = true,
    FreezeLids = true,
    Esp = true,
    Interval = 1000000000,
    OrigInterval = 4,
    StartAt = 0,
    Has173 = false, Observed = nil, Watchers = 0, Controller = nil,
    Dist173 = -1, TeleportIn = -1, BurstIn = -1,
    BlinkSuppressed = 0, BlinkDetected = 0,
    SnapWarns = 0, BurstWarns = 0,
    Status = "待命（默认关闭）", Error = nil, Log = {},
  }
  G.GUARD173 = L

  local function log(s)
    L.Log[#L.Log + 1] = s
    if #L.Log > 80 then table.remove(L.Log, 1) end
  end

  local configs = {}
  local function findConfigs()
    if #configs > 0 then return end
    local getters = {
      function() return RS.SharedModules.SCP173Config end,
      function() return RS.ReusableSCPsFolder.Shared.SCP173Config end,
    }
    for _, f in ipairs(getters) do
      pcall(function()
        local m = f()
        if m and m:IsA("ModuleScript") then
          local ok, cfg = pcall(require, m)
          if ok and type(cfg) == "table" and type(cfg.Blink) == "table" then
            configs[#configs + 1] = { tab = cfg.Blink, orig = cfg.Blink.INTERVAL }
          end
        end
      end)
    end
    if configs[1] and type(configs[1].orig) == "number" then
      L.OrigInterval = configs[1].orig
    end
  end

  local function patchConfig()
    findConfigs()
    if #configs == 0 then return false end
    local n = 0
    for _, c in ipairs(configs) do
      pcall(function() c.tab.INTERVAL = L.Interval; n = n + 1 end)
    end
    L.Patched = n > 0
    return L.Patched
  end

  local function restoreConfig()
    for _, c in ipairs(configs) do
      pcall(function() c.tab.INTERVAL = c.orig end)
    end
    L.Patched = false
  end

  local action, effects = nil, nil
  local overlay, lids, blinkBar = nil, {}, nil
  local model173 = nil
  local marks = {}
  local conns = {}
  local lastSeg = -1

  local function findAction()
    if action and effects then return end
    pcall(function()
      local r = RS:FindFirstChild("Remotes")
      action = r and r:FindFirstChild("SCP173Action")
      effects = r and r:FindFirstChild("SCP173Effects")
    end)
  end

  local function scan173()
    local found = nil
    pcall(function()
      local t = CS:GetTagged("SCP173")
      if #t > 0 then found = t[1] end
    end)
    if not found then pcall(function() found = WS:FindFirstChild("SCP-173") end) end
    model173 = found
    L.Has173 = found ~= nil
    return found
  end

  local function eligible()
    if not P then return false end
    local bad = false
    pcall(function()
      if P:GetAttribute("Role") == "SCP" or P:GetAttribute("SCP") ~= nil then
        bad = true; return
      end
      local t = P.Team
      if t then
        local n = string.lower(tostring(t.Name))
        if string.find(n, "spectat", 1, true) or string.find(n, "旁观", 1, true)
          or string.find(n, "观众", 1, true) or string.find(n, "lobby", 1, true)
          or string.find(n, "dead", 1, true) then bad = true; return end
      end
      local ch = P.Character
      if not ch then bad = true; return end
      local h = ch:FindFirstChildOfClass("Humanoid")
      if not h or h.Health <= 0 then bad = true; return end
    end)
    return not bad
  end

  local function clearMarks()
    for m, rec in pairs(marks) do
      pcall(function() if rec.hl then rec.hl:Destroy() end end)
      pcall(function() if rec.bb then rec.bb:Destroy() end end)
      marks[m] = nil
    end
  end

  local function ensureMark(m)
    if not L.Esp or marks[m] then return end
    pcall(function()
      local root = m.PrimaryPart or m:FindFirstChild("HumanoidRootPart")
        or m:FindFirstChildOfClass("BasePart")
      if not root then return end
      local hl = Instance.new("Highlight")
      hl.Name = "MCP173_HL"
      hl.FillColor = Color3.fromRGB(255, 70, 70)
      hl.OutlineColor = Color3.fromRGB(255, 215, 120)
      hl.FillTransparency = 0.62
      hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
      hl.Adornee = m
      hl.Parent = m
      local bb = Instance.new("BillboardGui")
      bb.Name = "MCP173_BB"
      bb.Size = UDim2.new(0, 240, 0, 78)
      bb.AlwaysOnTop = true
      bb.MaxDistance = 600
      bb.Adornee = root
      bb.Parent = root
      local tl = Instance.new("TextLabel")
      tl.Name = "MCP173_TL"
      tl.Size = UDim2.new(1, 0, 1, 0)
      tl.BackgroundTransparency = 1
      tl.TextColor3 = Color3.fromRGB(255, 238, 190)
      tl.TextStrokeTransparency = 0.35
      tl.TextScaled = true
      tl.Font = Enum.Font.GothamBold
      tl.Text = "SCP-173"
      tl.Parent = bb
      marks[m] = { hl = hl, bb = bb, tl = tl }
    end)
  end

  local function hookEffects()
    findAction()
    if not effects then return false end
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    conns = {}
    pcall(function()
      conns[#conns + 1] = effects.OnClientEvent:Connect(function(kind, a)
        pcall(function()
          if kind == "Snap" then
            L.SnapWarns = L.SnapWarns + 1
            log("⚠ 附近扭脖击杀 Snap @ " .. tostring(a))
          elseif kind == "Burst" or kind == "PowerOut" then
            L.BurstWarns = L.BurstWarns + 1
            log("⚠ 灯光故障 " .. tostring(kind) .. " · 173 可能被放开")
          elseif kind == "Moved" then
            L.Status = "⚠ 173 刚瞬移"
          end
        end)
      end)
    end)
    return true
  end

  local function disconnectAll()
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    conns = {}
  end

  local function readSeg()
    local n = -1
    pcall(function()
      if not blinkBar or blinkBar.Parent == nil then
        blinkBar = nil
        local pg = P:FindFirstChildOfClass("PlayerGui")
        local g = pg and pg:FindFirstChild("SCP173Blink")
        local meter = g and g:FindFirstChild("Meter")
        blinkBar = meter and meter:FindFirstChild("Bar")
      end
      if blinkBar then
        n = 0
        for i = 1, 20 do
          local s = blinkBar:FindFirstChild("Segment" .. i)
          if s and s.Visible then n = n + 1 end
        end
      end
    end)
    return n
  end

  local function freezeLids()
    pcall(function()
      if not overlay or overlay.Parent == nil then
        overlay = nil; lids = {}
        local pg = P:FindFirstChildOfClass("PlayerGui")
        overlay = pg and pg:FindFirstChild("SCP173Overlay")
        if overlay then
          for _, n in ipairs({ "LidTop", "LidBottom", "Blackout" }) do
            local f = overlay:FindFirstChild(n)
            if f then lids[#lids + 1] = f end
          end
        end
      end
      for _, f in ipairs(lids) do
        if f.Name == "Blackout" then
          if f.BackgroundTransparency ~= 1 then f.BackgroundTransparency = 1 end
        else
          local sz = f.Size
          if sz.Y.Scale ~= 0 or sz.Y.Offset ~= 0 then
            f.Size = UDim2.new(sz.X.Scale, sz.X.Offset, 0, 0)
          end
        end
      end
    end)
  end

  local function tick()
    if not eligible() then
      if not L.Paused then
        L.Paused = true
        restoreConfig()
        clearMarks()
        L.Status = "旁观/死亡/扮演SCP · 已自动放行（Config 已还原）"
        log("自动放行")
      end
      return
    end
    if L.Paused then L.Paused = false; log("恢复防护") end

    if L.NoBlink then
      if not patchConfig() then
        L.Error = "未找到 SCP173Config（等待生成）"
      else
        L.Error = nil
      end
    elseif L.Patched then
      restoreConfig()
    end

    local m = scan173()
    if m then
      pcall(function()
        L.Observed = m:GetAttribute("Observed")
        L.Watchers = tonumber(m:GetAttribute("Watchers")) or 0
        L.Controller = m:GetAttribute("Controller")
        local now = WS:GetServerTimeNow()
        local tp = tonumber(m:GetAttribute("TeleportReadyAt"))
        local bu = tonumber(m:GetAttribute("BurstReadyAt"))
        L.TeleportIn = tp and math.max(0, tp - now) or -1
        L.BurstIn = bu and math.max(0, bu - now) or -1
        local root = m.PrimaryPart or m:FindFirstChild("HumanoidRootPart")
          or m:FindFirstChildOfClass("BasePart")
        local ch = P.Character
        local hr = ch and ch:FindFirstChild("HumanoidRootPart")
        if root and hr then
          L.Dist173 = (root.Position - hr.Position).Magnitude
        end
      end)
      if L.Esp then
        ensureMark(m)
        local rec = marks[m]
        if rec and rec.tl then
          local dd = L.Dist173 >= 0 and string.format("%.0fm", L.Dist173) or "?"
          local obs = (L.Observed == true) and "被注视✓" or "⚠无人注视"
          rec.tl.Text = string.format(
            "SCP-173 [%s]\n%s · 注视%d · %s\n瞬移%.1fs 爆发%.1fs",
            tostring(L.Controller or "?"), obs, L.Watchers, dd,
            math.max(0, L.TeleportIn), math.max(0, L.BurstIn))
          rec.hl.FillColor = (L.Observed == true)
            and Color3.fromRGB(90, 220, 120) or Color3.fromRGB(255, 70, 70)
        end
      end
    else
      clearMarks()
      L.Dist173 = -1
    end
    if not L.Esp then clearMarks() end

    if L.FreezeLids then freezeLids() end

    local seg = readSeg()
    if seg >= 0 then
      if lastSeg >= 0 and lastSeg <= 2 and seg >= 18 then
        L.BlinkDetected = L.BlinkDetected + 1
        log("检测到一次未被阻止的眨眼（进度条重置）")
      end
      lastSeg = seg
    end
    if L.NoBlink and L.Patched then
      L.BlinkSuppressed = math.floor(
        (os.clock() - L.StartAt) / math.max(1, L.OrigInterval))
    end

    if L.Error then
      L.Status = "不可用 (" .. tostring(L.Error) .. ")"
    elseif not L.Has173 then
      L.Status = "待命（当前无 173 实例）"
    elseif L.NoBlink and L.Patched then
      L.Status = "已拦截：永不眨眼 · Observed=" .. tostring(L.Observed)
    else
      L.Status = "监测中"
    end
  end

  local function startLoop()
    if L.Running then return end
    L.Running = true
    L.StartAt = os.clock()
    findAction()
    hookEffects()
    task.spawn(function()
      while L.Running and not L.Stopped and G.GUARD173 == L do
        pcall(tick)
        task.wait(0.25)
      end
    end)
  end

  L.SetEnabled = function(v)
    v = v and true or false
    if v == L.Enabled then return end
    L.Enabled = v
    if v then
      L.Stopped = false
      L.Error = nil
      findAction()
      startLoop()
      log("开启")
    else
      L.Running = false
      restoreConfig()
      disconnectAll()
      clearMarks()
      L.Status = "已关闭（Config 已还原、ESP 已清理）"
      log("关闭")
    end
  end
  L.SetNoBlink = function(v) L.NoBlink = v and true or false end
  L.SetFreezeLids = function(v) L.FreezeLids = v and true or false end
  L.SetEsp = function(v)
    L.Esp = v and true or false
    if not L.Esp then clearMarks() end
  end
  L.SetInterval = function(n)
    local x = tonumber(n)
    if not x or x < 4 then return end
    L.Interval = x
    if L.Patched then patchConfig() end
  end
  L.ResetCount = function()
    L.BlinkSuppressed = 0; L.BlinkDetected = 0
    L.SnapWarns = 0; L.BurstWarns = 0
    L.StartAt = os.clock()
  end
  L.Dump = function()
    return string.format(
      "Enabled=%s NoBlink=%s Patched=%s FreezeLids=%s Esp=%s Paused=%s | " ..
      "INTERVAL=%s(orig %s) Has173=%s Observed=%s Watchers=%d Controller=%s Dist=%.0f " ..
      "TeleIn=%.1f BurstIn=%.1f | BlinkSuppressed=%d BlinkDetected=%d " ..
      "SnapWarns=%d BurstWarns=%d Cfg=%d Action=%s Effects=%s Status=%s",
      tostring(L.Enabled), tostring(L.NoBlink), tostring(L.Patched),
      tostring(L.FreezeLids), tostring(L.Esp),
      tostring(L.Paused), tostring(L.Interval), tostring(L.OrigInterval),
      tostring(L.Has173), tostring(L.Observed), L.Watchers,
      tostring(L.Controller), L.Dist173, L.TeleportIn, L.BurstIn,
      L.BlinkSuppressed, L.BlinkDetected,
      L.SnapWarns, L.BurstWarns, #configs,
      tostring(action and action:GetFullName()),
      tostring(effects and effects:GetFullName()), tostring(L.Status))
  end
  L.Off = function()
    L.Stopped = true
    L.Enabled = false
    L.Running = false
    restoreConfig()
    disconnectAll()
    clearMarks()
    G.GUARD173 = nil
  end
end

local SCP_NUMS = { "682", "173", "096", "049", "106", "035", "777", "939", "999" }
local function compact(s)
  return string.gsub(string.lower(tostring(s or "")), "[-_%s]", "")
end
local function scpNumberIn(s, allowBare)
  local c = compact(s)
  if allowBare then
    for _, num in ipairs(SCP_NUMS) do
      if c == num then return num end
    end
    local bare = string.match(c, "^(%d%d%d)$")
    if bare then return bare end
  end
  for _, num in ipairs(SCP_NUMS) do
    if string.find(c, "scp" .. num, 1, true) then return num end
  end
  local n = string.match(c, "scp(%d%d%d)")
  if n then return n end
  return nil
end

local HUMAN_HINT = { "foundation", "mtf", "classd", "scientist",
          "security", "researcher", "personnel" }
local function scpWordIn(s)
  local c = compact(s)
  if not string.find(c, "scp", 1, true) then return nil end
  for _, h in ipairs(HUMAN_HINT) do
    if string.find(c, h, 1, true) then return nil end
  end
  return "SCP"
end

local STATIC_KW = { "chamber", "zone", "room", "cell", "instances", "spawn",
          "sludge", "sense", "pestilence", "ragdoll", "door", "gate",
          "wall", "sign", "prop", "decor", "display", "corpse", "statue" }

