-- 职业 -> 队伍："G"=Guard系, "D"=ClassD, nil=中立
local function teamOfClass(class)
    local c = tostring(class or ""):lower():gsub("[-_%s]", "")
    if c == "classd" or c == "dclass" or c == "d" then return "D" end
    if c == "guard" or c == "facilityguard" or c == "responsespecialist"
       or c == "containmentspecialist" or c == "security" or c == "mtf"
       or c == "scientist" or c == "janitor" or c == "researcher" then return "G" end
    return nil
end
-- 从玩家对象取队伍（角色 Class 属性优先，回退 Player 属性）
local function teamOfPlayer(pl)
    if not pl then return nil end
    local cls
    pcall(function()
        local ch = pl.Character
        cls = (ch and ch:GetAttribute("Class")) or pl:GetAttribute("Class") or pl:GetAttribute("ActiveClass")
    end)
    return teamOfClass(cls)
end
-- 旁观者判定（多判据 OR，任一命中即旁观）
-- 供 ESP 与 GUNBOT/autoskill 共用，避免把幽灵当成有效玩家透视或攻击
-- 本游戏旁观状态是瞬时/回合相关的：Player.Ghost 属性为权威标志，
-- 但角色 Ghost 标签/Class 清空存在时机差，故必须多判据合并，避免漏判把幽灵当敌对。
local CS_SPEC = game:GetService("CollectionService")
local function isGhostSpec(pl)
    if not pl then return false end
    -- ① 玩家权威属性（游戏自身在 5170/6138 行用的判据）
    local okA, g = pcall(function() return pl:GetAttribute("Ghost") end)
    if okA and g == true then return true end
    local ok, ch = pcall(function() return pl:IsA("Player") and pl.Character or pl end)
    if not ok or not ch then return false end
    -- ② 角色属性
    local okB, g2 = pcall(function() return ch:GetAttribute("Ghost") end)
    if okB and g2 == true then return true end
    -- ③ CollectionService 标签
    local ok2, tagged = pcall(function() return CS_SPEC:HasTag(ch, "Ghost") end)
    if ok2 and tagged == true then return true end
    -- ④ Humanoid 状态 / 不在工作区（观战容器、Lobby、死亡）
    local okH, hum = pcall(function() return ch:FindFirstChildOfClass("Humanoid") end)
    if okH and hum then
        local okS, st = pcall(function() return hum:GetState() end)
        if okS and (st == Enum.HumanoidStateType.Dead
                 or st == Enum.HumanoidStateType.Spectating) then return true end
    end
    local okP, par = pcall(function() return ch.Parent end)
    if okP and par ~= workspace then return true end
    return false
end

