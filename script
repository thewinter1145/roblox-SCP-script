    -- ============ 新版任务（2026.11）：Reset the 3 breakers / Throw the main switch ============
    -- 现场实测清单：
    --   {"text":"Reset the 3 breakers","done":false}
    --   {"text":"Throw the main switch at the vault","done":false}
    --   {"text":"Get into the elevator behind the door","done":false}
    -- targets 只下发 BREAKER 三项：
    --   [{"label":"BREAKER",x=-177.1,y=108,z=-30},{"label":"BREAKER",x=66,y=108,z=177.1},
    --    {"label":"BREAKER",x=-151,y=108,z=158.9}]
    -- 实例路径：Workspace.Map.Generated.Region_0_0.Hall_Straight.Fixtures.ElectricalPanel
    --           .PanelGrey.BreakerPrompt.ResetBreaker（ProximityPrompt 挂在 Attachment 下，
    --           取不到 part 坐标 → 必须用 targets 坐标作 explicitPos）
    local function breakerKey(pos)
        return string.format("%.0f_%.0f", pos.X, pos.Z)
    end

    -- 断路器：逐个传送并触发 Reset Breaker；成功后该项会从 targets 消失
    local function doBreakers(breakers)
        if #breakers == 0 then
            -- 兜底：targets 完全没有闸门类 label 时，直接从场景里找可触发的
            -- Reset breaker / Reboot（第三个闸门=服务器机柜就是这种情况）
            local cand = nil
            for _, q in ipairs(scanAllPPs()) do
                local a = q.action or ""
                if q.enabled and (a:find("reset", 1, true) or a:find("reboot", 1, true)) then
                    cand = q
                    break
                end
            end
            if not cand then
                F.Phase = "① 无断路器目标(可能已完成)"
                return false
            end
            breakers = { {
                label = (lo(cand.action):find("reboot", 1, true) and "SERVERS") or "BREAKER",
                pos   = cand.pos or Vector3.new(0, 0, 0),
            } }
        end
        -- 选一个「本地还没按过」的；全按过就取第一个等服务器判定
        local t = nil
        for _, b in ipairs(breakers) do
            if not F.BreakerDone[breakerKey(b.pos)] then t = b; break end
        end
        local allDoneLocal = (t == nil)
        if not t then t = breakers[1] end
        local key = breakerKey(t.pos)
        F.Current = string.format("闸门 @ %.0f,%.0f", t.pos.X, t.pos.Z)

        -- 按坐标就近找这个闸门的 PP（pos 已在 scanAllPPs 中修好，能区分三个面板）
        local isSrv = lo(t.label):find("server", 1, true) ~= nil
            or lo(t.label):find("rack", 1, true) ~= nil
        local function pickPP(onlyEnabled)
            local q = findPP("reset", "breaker", t.pos, onlyEnabled)
            if not q then q = findPP("reset", nil, t.pos, onlyEnabled) end
            if not q then q = findPP("breaker", nil, t.pos, onlyEnabled) end
            if not q then q = findPP("valve", nil, t.pos, onlyEnabled) end
            if not q then q = findPP(nil, "breaker", t.pos, onlyEnabled) end
            if not q then q = findPP(nil, "valve", t.pos, onlyEnabled) end
            -- 第三个「闸门」是服务器机柜：Reboot | Server rack（label=SERVERS）
            if isSrv then
                if not q then q = findPP("reboot", nil, t.pos, onlyEnabled) end
                if not q then q = findPP(nil, "server", t.pos, onlyEnabled) end
                if not q then q = findPP(nil, "rack", t.pos, onlyEnabled) end
            end
            if not q then q = findPP("flip", nil, t.pos, onlyEnabled) end
            if not q then q = findPP(nil, "panel", t.pos, onlyEnabled) end
            return q
        end

        local p = pickPP(true)
        if not p then
            -- 贴近这个闸门再强制重扫一次（PP 可能在距离内才出现 / 缓存是旧的）
            tpSoft(t.pos + Vector3.new(0, -0.9, 0))
            task.wait(0.08)
            local nowT = os.clock()
            if (nowT - (F._breakerScanAt or 0)) > 0.6 then
                F._breakerScanAt = nowT
                scanAllPPs(true)
            end
            p = pickPP(true)
        end

        -- 【兜底】该坐标附近始终没有 PP：扫全场景所有 reset/valve/flip/open 类 PP，
        -- 挑一个 enabled 且不在「已复位闸门」附近的去触发。
        -- 现场情况：第三个阀门/面板的 PP 不一定挂在 targets 下发的那一点上，
        -- 旧逻辑只看坐标附近 → 找不到就一直站在第二个闸门处不动。
        if not p then
            F.BreakerMiss = F.BreakerMiss or {}
            local miss = (F.BreakerMiss[key] or 0) + 1
            F.BreakerMiss[key] = miss
            if miss >= 3 then
                local cand = nil
                for _, q in ipairs(scanAllPPs(true)) do
                    local okUse = q.enabled
                    if okUse and q.action then
                        okUse = q.action:find("reset", 1, true) ~= nil
                            or q.action:find("valve", 1, true) ~= nil
                            or q.action:find("flip", 1, true) ~= nil
                            or q.action:find("open", 1, true) ~= nil
                            or q.action:find("breaker", 1, true) ~= nil
                            or (q.obj and (q.obj:find("valve", 1, true) ~= nil
                                or q.obj:find("breaker", 1, true) ~= nil))
                    end
                    if okUse and q.pos then
                        -- 排除已经复位过的面板附近
                        for _, b in ipairs(breakers) do
                            if F.BreakerDone[breakerKey(b.pos)]
                                and (q.pos - b.pos).Magnitude < 8 then
                                okUse = false
                                break
                            end
                        end
                    end
                    if okUse then cand = q; break end
                end
                if cand then
                    p = cand
                    F.Phase = string.format("① 闸门兜底：改触发 %s", tostring(cand.action))
                end
            end
        end

        -- 没有可触发的 PP：可能是这个面板已经复位（PP 变 disabled）
        local already = false
        if not p then
            local q = pickPP(false)
            if q then
                local ok, en = pcall(function() return q.pp.Enabled end)
                already = ok and (en == false)
            end
        end

        local left = 0
        for _, b in ipairs(breakers) do
            if not F.BreakerDone[breakerKey(b.pos)] then left = left + 1 end
        end
        F.Phase = string.format("① 复位闸门(%d/%d)%s",
            #breakers - left, #breakers,
            (p and "") or (already and "（该闸门已复位）") or "（未找到互动点·贴近重试）")

        -- 该面板已复位 → 记账后立刻处理下一个，绝不原地干等
        if already then
            F.BreakerDone[key] = true
            F._ppCacheTime = 0
            return true
        end

        if p then
            -- 瞬间互动：立刻 fire，随后只验证 PP 是否变 disabled（0.08s × 6）
            triggerPP(p, t.pos)
            local got = false
            for _ = 1, 6 do
                task.wait(0.08)
                local ok, en = pcall(function() return p.pp.Enabled end)
                if ok and en == false then got = true break end
            end
            if not got then
                -- 少数任务会校验"按住时长"：按其 HoldDuration 回退触发一次
                fireNow(p.pp, math.max(1.0, p.hold or 0))
                for _ = 1, 10 do
                    task.wait(0.1)
                    local ok, en = pcall(function() return p.pp.Enabled end)
                    if ok and en == false then got = true break end
                    local _, st2 = currentStep()
                    if st2 and not st2:find("breaker", 1, true)
                        and not st2:find("server", 1, true)
                        and not st2:find("rack", 1, true) then got = true break end
                end
            end
            if got then
                F.BreakerDone[key] = true
                F._ppCacheTime = 0
                return true          -- 成功即走，不再等 3 秒服务器回执
            end
            -- 没生效：不记账，下一轮重新拿 PP 再触发（避免"误标完成→跳过第三个闸门"）
            F.Phase = string.format("① 闸门触发未生效·重试 (%.0f,%.0f)", t.pos.X, t.pos.Z)
            F._ppCacheTime = 0
            return false
        end

        if allDoneLocal and left == 0 then
            F.Phase = "① 闸门已全部复位(本地判定)"
            F._ppCacheTime = 0
            return true
        end
        F._ppCacheTime = 0
        return false
    end

    -- 总闸：targets 可能给 MAIN SWITCH，也可能只有坐标没 label → 按关键词兜底
    local function doMainSwitch(swPos, stepRaw)
        F.Current = "拉金库总闸"
        local function pick(onlyEnabled)
            local q = nil
            if swPos then
                q = findPP("switch", nil, swPos, onlyEnabled)
                if not q then q = findPP("throw", nil, swPos, onlyEnabled) end
                if not q then q = findPP("main", nil, swPos, onlyEnabled) end
                if not q then q = findPP("power", nil, swPos, onlyEnabled) end
                if not q then q = findPP(nil, "switch", swPos, onlyEnabled) end
                if not q then q = findPP(nil, "main", swPos, onlyEnabled) end
            else
                q = findPP("switch", nil, nil, onlyEnabled)
                if not q then q = findPP("throw", nil, nil, onlyEnabled) end
                if not q then q = findPP("main", nil, nil, onlyEnabled) end
                if not q then q = findPP(nil, "switch", nil, onlyEnabled) end
                if not q then q = findPP(nil, "main", nil, onlyEnabled) end
            end
            return q
        end

        local p = pick(true)
        if not p and swPos then
            -- 贴近总闸坐标再重扫（同断路器：PP 可能在距离内才出现）
            tpSoft(swPos + Vector3.new(0, -0.9, 0))
            task.wait(0.08)
            scanAllPPs(true)
            p = pick(true)
        end
        -- 兜底：全场景找 lever / switch / power / restore 类可触发 PP
        if not p then
            for _, q in ipairs(scanAllPPs()) do
                local a = q.action or ""
                if q.enabled and (a:find("switch", 1, true) or a:find("throw", 1, true)
                    or a:find("pull", 1, true) or a:find("lever", 1, true)
                    or a:find("power", 1, true) or a:find("restore", 1, true)) then
                    p = q
                    break
                end
            end
        end

        F.Phase = "② 拉总闸" .. (p and "" or "（未找到互动点·贴近重试）")
        if p then
            -- 瞬间互动 + 验证是否生效（清单推进或 PP disabled）
            triggerPP(p, swPos)
        elseif swPos then
            tpSoft(swPos + Vector3.new(0, -0.9, 0))
        end
        -- 等清单推进（该步置 done 或直接变成电梯步）· 0.1s 一轮，最快交权
        for _ = 1, 12 do
            task.wait(0.1)
            if not F.Enabled or not inEscapeRound() then return false end
            local _, _, raw = currentStep()
            if raw == nil or raw == "" or raw ~= stepRaw then
                F._ppCacheTime = 0
                return true
            end
            if p then
                local ok, en = pcall(function() return p.pp.Enabled end)
                if ok and en == false then
                    F._ppCacheTime = 0
                    return true
                end
            end
        end
        F._ppCacheTime = 0
        return true
    end

    -- 前向声明：doVaultDoor 需调用 doExit（电梯），但 doExit 定义在后面
    local doExit

    -- 金库门用钥匙：锚定到钥匙开关处触发（瞬间完成），随后不等提示直接去电梯
    local function doVaultDoor(targetPos)
        F.Current = "金库门用钥匙(锚定)"
        if not targetPos then return false end
        local _, _, stepRaw = currentStep()   -- 记住当前步文本，门开后本地标记完成
        F.LastDoorPos = targetPos             -- 供 readLiftPos 的场景兜底做高度/距离基准
        -- 【v16.21】钥匙是 Tool：多数实现要求"手持钥匙"才出现 Turn the key 提示。
        -- 现场「Carried by xxx」= 钥匙在背包但没装备 → 门口什么都不显示、也开不了门。
        pcall(function()
            local hum, ch = getHum(), LP.Character
            if not hum or not ch then return end
            local holding = ch:FindFirstChildOfClass("Tool")
            if holding and lo(holding.Name):find("key", 1, true) then return end
            local bp = LP:FindFirstChildOfClass("Backpack")
            if bp then
                for _, t in ipairs(bp:GetChildren()) do
                    if t:IsA("Tool") and lo(t.Name):find("key", 1, true) then
                        hum:EquipTool(t)
                        return
                    end
                end
            end
            for _, t in ipairs(ch:GetChildren()) do
                if t:IsA("Tool") and lo(t.Name):find("key", 1, true) then
                    hum:EquipTool(t)
                    return
                end
            end
        end)
        -- 【v16.21】钥匙 PP 现场实测：ActionText="Turn the key"，ObjectText="Vault door"
        -- （不含 key！）。旧版第一个匹配 findPP("turn","key") 永远失败，靠兜底才命中；
        -- 一旦缓存没刷新就直接放弃，人站在门口不动。现在改成"循环重试 + 每轮强制重扫"。
        local fired, p = false, nil
        for attempt = 1, 10 do
            if not F.Enabled then break end
            p = findPP("turn", "key", targetPos, true)
                or findPP("insert", nil, targetPos, true)
                or findPP("use", "key", targetPos, true)
                or findPP("unlock", nil, targetPos, true)
                or findPP("key", nil, targetPos, true)
                or findPP("switch", nil, targetPos, true)
            if not p and attempt > 1 then
                scanAllPPs(true)                 -- PP 刚被服务器启用：强制重扫一次
                p = findPP("key", nil, targetPos, true) or findPP("unlock", nil, targetPos, true)
            end
            if p then
                local at = p.pos or (targetPos + Vector3.new(0, -4.5, 0))
                -- 先不锚定贴近（锚定会被服务器位置校验/门板碰撞拒绝），触发再看结果
                -- 站立时 HRP 比钥匙孔高约 2~3 studs，用 +2 落到地面而不是沉进门体
                tpSoft(at + Vector3.new(0, 2, 0))
                task.wait(0.05)
                fireNow(p.pp)
                task.wait(0.12)
                local ok, en = pcall(function() return p.pp and p.pp.Enabled end)
                if ok and en == false then fired = true; break end
                -- 仍 enabled：再贴近一点 + 再 fire 一次
                tpSoft(at + Vector3.new(0, 1.2, 0))
                task.wait(0.05)
                fireNow(p.pp)
                task.wait(0.14)
                local ok2, en2 = pcall(function() return p.pp and p.pp.Enabled end)
                if ok2 and en2 == false then fired = true; break end
                -- 清单已推进（"Unlocked by ..."）也算成功
                local _, _, raw2 = currentStep()
                if raw2 and stepRaw and raw2 ~= stepRaw then fired = true; break end
            else
                -- 还没找到可用的钥匙 PP：站到门坐标前方（不锚定），等它变 enabled
                tpSoft(targetPos + Vector3.new(0, 2, 0))
            end
            task.wait(0.2)
        end
        if not fired then
            F.Phase = "金库门：钥匙提示未触发(重试中)"
        end
        -- 【v16.13 修复 · 用户反馈的 bug】门板动画 + 服务器下发 EscapeExitPosition 有延迟，
        -- 旧版只轮询 6×0.4=2.4 秒，经常还没下发就 return，主循环又把同一步重做一遍
        -- → 表现就是「插钥匙把门打开了，但人站着不动、不去逃离」。
        -- 现在最多等 8 秒；期间清单若已推进到下一步（如金库电脑上传）立刻交回主循环。
        -- 【v16.21】scene 兜底坐标（ExitZone 竖井标记）不再当作"门已开"的信号：
        -- 只认服务器属性 / targets 下发，缓存坐标也不再盲目使用。
        local exit, esrc = readLiftPos()
        if esrc and tostring(esrc):find("scene", 1, true) then exit, esrc = nil, nil end
        if not exit then
            for _ = 1, 24 do
                if not F.Enabled or not inEscapeRound() then break end
                task.wait(0.15)
                exit, esrc = readLiftPos()
                if esrc and tostring(esrc):find("scene", 1, true) then exit = nil end
                if exit then break end
                local _, _, raw2 = currentStep()
                if raw2 and raw2 ~= "" and raw2 ~= stepRaw then break end
            end
        end
        if exit then
            -- 门已开：本地标记该步完成，防止服务器 checklist 不置 done 导致反复插钥匙
            if stepRaw and stepRaw ~= "" then F.LocalDone[stepRaw] = true end
            F.Phase = "⑤ 坐电梯(转钥匙即走)"
            F.ExitSrc = esrc or F.ExitSrc
            doExit(exit)
        else
            F.Phase = "金库门已开 · 等待逃离坐标"
        end
        return true
    end

    -- 金库电脑上传：Upload drive obj="Vault computer" hold=3 → 触发后藏天花板上方
    -- vaultPos: targets 里 VAULT PC 坐标（PP 挂在 Attachment 上无 part 坐标，必须用这个）
    local function doVaultUpload(vaultPos)
        F.Current = "金库电脑上传"
        local p = findPP("upload drive", "vault computer", nil, true)
        -- 关键修复：PP 的 part 坐标是 nil，用 targets 下发的 VAULT PC 坐标传送
        local actPos = vaultPos or (p and p.pos)
        if not actPos then
            F.Phase = "④ 无金库电脑坐标"
            return false
        end
        -- 即时验证上传是否真的开始，失败立即返回让主循环重试
        if p then
            if not fireUploadAndVerify(p, actPos, 4) then
                F.Phase = "④ 金库上传互动失败(即时重试)"
                return false
            end
        end
        -- 【v2.1】上传保持：以"上传 PP 变 disabled"为进行中标志，保持约 hold+1s
        -- 即视为上传完成，不再死等 EscapeExitPosition 下发(那是门开后才出、有延迟，
        -- 导致角色一直钉在天花板上方)。门开信号(readLiftPos)出现则立刻走。
        if actPos then
            local uploaded = false
            local upStart = os.clock()
            local holdSec = (p and p.hold > 0 and p.hold or 3) + 1.5  -- hold=3 → 约4.5s
            while os.clock() - upStart < math.max(holdSec, 6) do
                if not F.Enabled or not inEscapeRound() then break end
                if readLiftPos() then break end       -- 门已开/电梯可用 → 立刻走
                local hrp = getHRP()
                if hrp then tpAnchor(actPos + Vector3.new(0, F.HideDepth, 0)) end
                task.wait(F.Tick)
            end
            uploaded = true
        end
        -- 立即直奔电梯：服务器权威坐标(EscapeExitPosition / targets)
        -- 【v16.13】轮询时长 2.4s → 8s，理由同 doVaultDoor：门开后的下发延迟很常见
        -- 【v16.21】不再使用 F.LastExit 缓存 / scene 兜底当逃离坐标：缓存可能来自
        -- ExitZone 竖井标记，传进去必然卡死。只认服务器属性与 targets 下发。
        local exit, esrc = readLiftPos()
        if esrc and tostring(esrc):find("scene", 1, true) then exit, esrc = nil, nil end
        if not exit then
            for _ = 1, 24 do
                if not F.Enabled or not inEscapeRound() then break end
                task.wait(0.15)
                exit, esrc = readLiftPos()
                if esrc and tostring(esrc):find("scene", 1, true) then exit = nil end
                if exit then break end
            end
        end
        if exit then
            F.Phase = "⑤ 坐电梯(上传即走)"
            F.ExitSrc = esrc or F.ExitSrc
            doExit(exit)
        else
            F.Phase = "上传完成 · 等待逃离坐标"
        end
        return true
    end

    -- 坐电梯逃离
    -- 【v2.2 安全校验】电梯坐标只认服务器权威值；先校验合法性(Y≈地板、X/Z在地图内)，
    -- 非法则拒绝钉位(防"传送到虚空反复下坠")。每轮重读权威坐标，服务器一旦下发更新
    -- 立即用新坐标；Escaped/回合结束立即停，绝不持续钉死旧 CFrame。
    doExit = function(exitPos)
        -- 已逃脱：电梯动画接管，直接返回，不处理坐标(逃脱后服务器会清空 Exit 坐标)
        if LP:GetAttribute("Escaped") == true then return true end
        F.Current = "坐电梯逃离"
        -- 【v16.13 修复 · 本次 bug 的直接原因】
        -- 旧版把合法性写死成 Y∈(85,160) 且 |X|,|Z|<210，而本局真实逃离点
        -- （见上方 v2.2 注释里的真机值 356,73,-24）两项都不满足 →
        -- 坐标一到手就被判「非法 → 拒绝传送」，人站在金库门口一动不动。
        -- 现改为只排除明显异常值（NaN / 极端坐标 / 地底深处）。
        local function valid(p)
            if not p then return false end
            if p.X ~= p.X or p.Y ~= p.Y or p.Z ~= p.Z then return false end  -- NaN
            if math.abs(p.X) > 5000 or math.abs(p.Z) > 5000 then return false end
            if p.Y < -100 or p.Y > 2000 then return false end
            return true
        end
        local src = "服务器属性"
        if not valid(exitPos) then
            -- 主坐标非法时，退回其它权威来源（targets 的 EXIT / 场景出口区）
            local alt, asrc = readLiftPos()
            if valid(alt) then exitPos, src = alt, tostring(asrc or "回退来源") end
        end
        if not valid(exitPos) then
            F.Phase = "⑤ 无有效逃离坐标(等待服务器下发)"
            F.LastExit = nil
            return false
        end
        F.LastExit = exitPos
        F.ExitSrc = src
        -- 【v16.21】不可达坐标黑名单：竖井/墙内/封死区域的坐标传进去会被立刻拉回，
        -- 旧版会在这里死钉 12 秒（现场表现就是"站着不动"）。5 秒内不再尝试同一坐标。
        if F.BadExitPos and (F.BadExitPos - exitPos).Magnitude < 8
            and (os.clock() - (F._badExitAt or 0)) < 5 then
            F.Phase = "⑤ 该逃离坐标不可达(已跳过)"
            return false
        end
        -- 日志节流：坐标变动>2 或距上次>10s 才打印，避免主循环每 tick 刷屏
        if (not F._warnExit) or (F._warnExit - exitPos).Magnitude > 2
            or (os.clock() - (F._warnAt or 0)) > 10 then
            F._warnExit, F._warnAt = exitPos, os.clock()
            warn(string.format("[AUTOESCAPE] 前往逃离点 %.0f,%.0f,%.0f · 来源=%s",
                exitPos.X, exitPos.Y, exitPos.Z, src))
        end
        tpSoft(exitPos + Vector3.new(0, 1, 0))
        -- 可达性验证（0.4s）：若人被拉回 40 studs 外，说明这个坐标根本站不住，
        -- 立刻拉黑并交回主循环，不再钉 12 秒。
        do
            local t0 = os.clock()
            while os.clock() - t0 < 0.4 do
                if not F.Enabled then break end
                if LP:GetAttribute("Escaped") == true then break end
                task.wait(0.05)
            end
            local hrp0 = getHRP()
            if hrp0 and LP:GetAttribute("Escaped") ~= true
                and (hrp0.Position - exitPos).Magnitude > 40 then
                F.BadExitPos, F._badExitAt = exitPos, os.clock()
                F.LastExit = nil
                F.Phase = "⑤ 逃离坐标不可达(已拉黑)"
                warn(string.format("[AUTOESCAPE] 逃离坐标 %.0f,%.0f,%.0f 站不住(被拉回)，已跳过",
                    exitPos.X, exitPos.Y, exitPos.Z))
                return false
            end
        end
        local start = os.clock()
        local pulled = 0
        while os.clock() - start < 12 do
            if not F.Enabled then break end
            if LP:GetAttribute("Escaped") == true then break end
            if RS:GetAttribute("RoundPhase") ~= "Playing" then break end
            -- 每轮重读权威坐标，若服务器更新了则立刻采用新位置
            local fresh = readLiftPos()
            if fresh and valid(fresh) and (fresh - exitPos).Magnitude > 1 then
                exitPos = fresh
            end
            if not valid(exitPos) then break end
            pcall(function()
                local hrp = getHRP()
                if hrp then
                    hrp.CFrame = CFrame.new(exitPos + Vector3.new(0, 1, 0))
                    hrp.AssemblyLinearVelocity = Vector3.zero
                end
            end)
            -- 连续被拉回 → 该坐标不可站，拉黑退出（别钉死人）
            do
                local hrp2 = getHRP()
                if hrp2 and (hrp2.Position - exitPos).Magnitude > 40 then
                    pulled = pulled + 1
                    if pulled >= 6 then
                        F.BadExitPos, F._badExitAt = exitPos, os.clock()
                        F.Phase = "⑤ 逃离坐标不可达(已拉黑)"
                        break
                    end
                else
                    pulled = 0
                end
            end
            task.wait(F.Tick)
        end
        return true
    end

    -- ============ 主逃脱决策循环 ============
    -- 每轮：读清单第一个未完成步骤 → 按 text 关键词 + targets 决定动作
    local function doEscape()
        -- 【v16.13 顺序修正】只有「清单已全部完成」或「当前步骤本身就是逃离」才上电梯。
        -- 旧版第一行就读 EscapeExitPosition 直接 doExit：门一开服务器就下发坐标，
        -- 金库电脑上传还没做就被拽上电梯，任务没完成 → 逃离失败；而 doExit 被坐标
        -- 校验拒绝时又每个 tick 重试，永远推进不到后面的步骤。
        local step, stepText = currentStep()
        local targets = readTargets()
        F.Targets = #targets

        local exitStep = false
        if step and stepText then
            exitStep = stepText:find("exit", 1, true) ~= nil
                or stepText:find("escape", 1, true) ~= nil
                or stepText:find("elevator", 1, true) ~= nil
                or stepText:find("lift", 1, true) ~= nil
                or stepText:find("leave", 1, true) ~= nil
        end

        if not step or not stepText or exitStep then
            local exitPos, esrc = readLiftPos()
            -- scene 兜底坐标（ExitZone 竖井标记）不可信，直接丢弃等服务器下发
            if exitPos and esrc and tostring(esrc):find("scene", 1, true) then exitPos = nil end
            if exitPos then
                F.ExitSrc = esrc or F.ExitSrc
                doExit(exitPos)
                return
            end
            F.Phase = (not step) and "清单已完成 · 等待逃离坐标" or "⑤ 等待电梯/出口坐标"
            return
        end

        -- 收集各 label 目标（判子阶段用，不依赖系统延迟冒提示）
        local deliverPos = nil
        local driveTargets, lastDrivePos, vaultPcPos = {}, nil, nil
        local breakers, switchPos = {}, nil
        for _, t in ipairs(targets) do
            local lb = lo(t.label)
            if t.label == "DELIVER" then deliverPos = t.pos end
            if t.label == "MEMORY DRIVE" then driveTargets[#driveTargets + 1] = t end
            if t.label == "LAST DRIVE" then lastDrivePos = t.pos end
            if t.label == "VAULT PC" then vaultPcPos = t.pos end
            -- 新版任务：BREAKER ×3 / MAIN SWITCH
            -- 新版任务第三个「闸门」实际是服务器机柜：targets 用 label=SERVERS 下发，
            -- 场景里是 Server rack 的 Reboot 互动（路径 ...ServerRack.Black.BreakerPrompt），
            -- 旧代码只认 BREAKER/VALVE → 第三个永远找不到 → 第二个闸门后站死。
            if lb:find("breaker", 1, true) or lb:find("valve", 1, true)
                or lb:find("server", 1, true) or lb:find("rack", 1, true) then
                breakers[#breakers + 1] = t
            end
            if lb:find("switch", 1, true) or lb:find("main", 1, true) then switchPos = t.pos end
        end

        -- 新版任务：Reset the 3 breakers / Throw the main switch at the vault
        if stepText:find("breaker", 1, true) or stepText:find("valve", 1, true) then
            F.Current = "复位断路器"
            doBreakers(breakers)
            return
        end
        if stepText:find("switch", 1, true) and not stepText:find("key", 1, true) then
            doMainSwitch(switchPos, stepText)
            return
        end

        if stepText:find("wake scp", 1, true) then
            F.Phase = "① 唤醒 SCP-079"
            doWake079()
        elseif stepText:find("memory drive", 1, true) then
            -- 先把所有 MEMORY DRIVE 全部捡完，最后一个都不剩才去交付
            if #driveTargets > 0 then
                F.Phase = "② 拾取记忆驱动器(" .. #driveTargets .. "个)"
                doPickupAllDrives(driveTargets)
            elseif deliverPos then
                F.Phase = "② 交付记忆驱动器"
                doDeliver(deliverPos)
            else
                F.Phase = "② 等待驱动器/交付目标"
            end
        elseif stepText:find("node", 1, true) or stepText:find("power", 1, true) then
            F.Phase = "③ 节点通电"
            -- 找最近的未完成节点目标（NODE 或 UPLOAD label）
            local nodeTarget = nil
            for _, t in ipairs(targets) do
                if t.label == "NODE" or t.label == "UPLOAD" then nodeTarget = t.pos; break end
            end
            if nodeTarget then
                doNode(nodeTarget)
            else
                F.Phase = "③ 无节点目标(可能已完成)"
            end
        elseif stepText:find("vault door", 1, true) then
            -- 【v16.13】"vault door" 必须排在 "skeleton key" 之前：真实清单文本常是
            -- "Use the skeleton key on the vault door"，旧顺序先命中 skeleton key，
            -- 于是只去「取钥匙」、永远不插钥匙开门 —— 这是卡在任务4的另一半原因。
            F.Phase = "金库门用钥匙"
            local doorPos = nil
            for _, t in ipairs(targets) do
                local lb = lo(t.label)
                if lb:find("door", 1, true) or lb:find("vault", 1, true) then doorPos = t.pos; break end
            end
            if not doorPos then
                for _, t in ipairs(targets) do if doorPos == nil then doorPos = t.pos end end
            end
            doVaultDoor(doorPos)
        elseif stepText:find("skeleton key", 1, true) then
            F.Phase = "取骷髅钥匙"
            local keyPos = nil
            for _, t in ipairs(targets) do
                local lb = lo(t.label)
                if lb:find("key", 1, true) then keyPos = t.pos; break end
            end
            if not keyPos then
                for _, t in ipairs(targets) do if keyPos == nil then keyPos = t.pos end end
            end
            doSkeletonKey(keyPos)
        elseif stepText:find("last drive", 1, true) or stepText:find("vault computer", 1, true) then
            F.Phase = "④ 金库电脑上传"
            -- 先看 targets 判定子阶段：LAST DRIVE → 拾取最终驱动器；VAULT PC → 上传
            local subMode, subPos = nil, nil
            for _, t in ipairs(targets) do
                if t.label == "LAST DRIVE" then subMode = "pick"; subPos = t.pos end
                if t.label == "VAULT PC" then subMode = "upload"; subPos = t.pos end
            end
            if subMode == "pick" then
                F.Current = "拾取最终驱动器"
                local ok = firePickupAndVerify("take drive", "last drive", subPos, 8)
                if not ok then firePickupAndVerify("take", "drive", subPos, 6) end
            elseif subMode == "upload" then
                doVaultUpload(subPos)
            else
                F.Phase = "④ 等待最终驱动器目标"
            end
        elseif stepText:find("elevator", 1, true) then
            F.Phase = "⑤ 坐电梯"
            -- 电梯未出坐标时，去最后一个目标
            if targets[1] then doExit(targets[1].pos) end
        else
            F.Phase = "未知步骤: " .. stepText
        end
    end

    -- ============ 投票 ============
    local function voteEscape()
        local ok = false
        pcall(function()
            local remotes = RS:FindFirstChild("Remotes")
            local rv = remotes and remotes:FindFirstChild("RoundVote")
            if rv then
                rv:FireServer("Escape")
                F.Votes = F.Votes + 1
                ok = true
            end
        end)
        return ok
    end

    -- ============ 主状态机 ============
    local function onPhase()
        if not F.Enabled then return end
        local phase = RS:GetAttribute("RoundPhase")
        if phase == "Voting" then
            if F.AutoVote and not F.VotedThisPhase then
                F.VotedThisPhase = true
                task.spawn(function()
                    task.wait(0.6)
                    local ok = voteEscape()
                    F.Phase = ok and "已投 Escape" or "投票失败"
                end)
            end
        elseif phase == "Playing" then
            F.VotedThisPhase = false
            if inEscapeRound() then
                F.Phase = "运行中"
            else
                F.Phase = "生存模式(非逃脱)"
            end
        elseif phase == "Intermission" or phase == "Lobby" or phase == "Results" then
            F.VotedThisPhase = false
            F.CountedThisRound = false
            F.Current = "无"
            F.Targets = 0
            -- v16.13：回合结束清空本地完成标记，新一局同文本步骤不能被误跳过
            F.LocalDone = {}
            F.BreakerDone = {}
            F.BreakerMiss = {}
            F.LastExit = nil
            F.ExitSrc = "无"
            F._exitScanPos = nil
            F._exitScanAt = -10
            F._warnExit = nil
            F.BadExitPos, F._badExitAt = nil, 0
            F.LastDoorPos = nil
            F.Phase = (phase == "Lobby") and "大厅" or ((phase == "Results") and "回合结算" or "局间休息")
        end
    end

    local function start()
        enableFastInteract()   -- 快速互动（跳过 hold 长按）
        if F.Conn then return end
        -- v16.13：代次守卫，stop() 后旧循环立即退出，绝不出现两条主循环抢着传送
        F.Gen = (F.Gen or 0) + 1
        local gen = F.Gen
        -- 每次开启视为新一局：本地完成标记必须清空，否则上局「金库门」会被永久跳过
        F.LocalDone = {}
        F.BreakerDone = {}          -- 闸门/机柜复位记录也必须按局清空，否则同位置面板被误跳过
        F.BreakerMiss = {}
        F._breakerScanAt = 0
        F.LastExit = nil
        F.ExitSrc = "无"
        F._exitScanPos = nil
        F._exitScanAt = -10
        F._warnExit = nil
        F.BadExitPos, F._badExitAt = nil, 0
        F.LastDoorPos = nil
        F.Conn = RS:GetAttributeChangedSignal("RoundPhase"):Connect(onPhase)
        pcall(onPhase)
        -- 常驻主循环：跨回合持续运行，回合切换不会杀死协程
        -- （旧版 while 条件带 inEscapeRound，切回合瞬间协程退出后不再重建，导致脚本卡死）
        if not F.LoopTask or coroutine.status(F.LoopTask) == "dead" then
            F.LoopTask = task.spawn(function()
                while F.Enabled and (not F.Gen or F.Gen == gen) do
                    -- 已逃脱：只计数，不再做任务/传送（避免电梯动画期间被甩出地图）
                    if LP:GetAttribute("Escaped") == true then
                        if not F.CountedThisRound then
                            F.CountedThisRound = true
                            F.Escapes = F.Escapes + 1
                        end
                        F.Phase = "已逃脱"
                        F.Current = "无"
                    elseif inEscapeRound() then
                        pcall(doEscape)
                    end
                    task.wait(F.Tick)
                end
                F.Phase = "已关闭"
            end)
        end
    end
    local function stop()
        F.Gen = (F.Gen or 0) + 1
        disableFastInteract()
        if F.Conn then pcall(function() F.Conn:Disconnect() end) end
        F.Conn = nil
        F.LoopTask = nil
    end

    -- ============ 对外接口 ============
    F.SetEnabled = function(v)
        F.Enabled = v and true or false
        if F.Enabled then
            start()
            F.Phase = "运行中"
            warn("[AUTOESCAPE] 已开启：自动投 Escape / 按序做任务 / 藏地板下 / 坐电梯")
        else
            stop()
            F.Phase = "待命（已关闭）"
            warn("[AUTOESCAPE] 已关闭")
        end
        return F.Enabled
    end
    F.SetAutoVote = function(v) F.AutoVote = v and true or false; return F.AutoVote end
    F.SetNodeHold = function(v) if type(v) == "number" then F.NodeHold = math.max(3, v) end; return F.NodeHold end
    F.SetStallSec = function(v) if type(v) == "number" then F.StallSec = math.max(2, v) end; return F.StallSec end
    F.SetHideDepth = function(v) if type(v) == "number" then F.HideDepth = math.max(3, v) end; return F.HideDepth end
    F.VoteNow = function() return voteEscape() end
    -- 【诊断】闸门任务卡住时执行：AUTOESCAPE_DUMP()
    -- 会列出所有 reset/breaker/valve 类 PP（含 enabled、坐标、父路径）与当前清单/targets、
    -- 以及本地已复位的闸门坐标，用来确认第三个闸门到底是「PP 不存在」「PP 已 disabled」
    -- 还是「坐标根本不是这个点」。
    F.DumpBreakers = function()
        local out = { "=== 闸门/阀门诊断 ===" }
        local steps = readChecklist() or {}
        for _, s in ipairs(steps) do
            out[#out + 1] = string.format("步骤 done=%s | %s | %s",
                tostring(s.done), tostring(s.text), tostring(s.detail))
        end
        out[#out + 1] = "Phase=" .. tostring(F.Phase) .. " Current=" .. tostring(F.Current)
        local bd = {}
        for k in pairs(F.BreakerDone or {}) do bd[#bd + 1] = tostring(k) end
        out[#out + 1] = "本地已复位=" .. table.concat(bd, ",")
        for _, p in ipairs(scanAllPPs(true)) do
            local a, o = p.action or "", p.obj or ""
            if a:find("reset", 1, true) or a:find("breaker", 1, true)
                or a:find("valve", 1, true) or a:find("flip", 1, true)
                or o:find("breaker", 1, true) or o:find("valve", 1, true) then
                out[#out + 1] = string.format("PP [%s|%s] enabled=%s pos=%s par=%s",
                    a, o, tostring(p.enabled),
                    p.pos and string.format("%.0f,%.0f,%.0f", p.pos.X, p.pos.Y, p.pos.Z) or "nil",
                    p.pp.Parent and p.pp.Parent:GetFullName() or "?")
            end
        end
        for _, t in ipairs(readTargets()) do
            out[#out + 1] = string.format("target %s @ %.0f,%.0f,%.0f",
                tostring(t.label), t.pos.X, t.pos.Y, t.pos.Z)
        end
        return table.concat(out, "\n")
    end
    F.Dump = function()
        local targets = readTargets()
        local tlist = {}
        for i, t in ipairs(targets) do
            tlist[#tlist + 1] = string.format("[%s @ %.0f,%.0f,%.0f]", t.label, t.pos.X, t.pos.Y, t.pos.Z)
        end
        local steps = readChecklist()
        local slist = {}
        if steps then
            for i, s in ipairs(steps) do
                slist[#slist + 1] = string.format("%d.[%s]%s%s", i, s.done and "✓" or " ", tostring(s.text or ""),
                    s.detail and ("(" .. tostring(s.detail) .. ")") or "")
            end
        end
        local ld = {}
        for k in pairs(F.LocalDone) do ld[#ld + 1] = tostring(k) end
        local lp, lsrc = readLiftPos()
        return table.concat({
            "=== AUTOESCAPE v16.13 Dump ===",
            "Enabled=" .. tostring(F.Enabled) .. " Phase=" .. tostring(F.Phase),
            "RoundMode=" .. tostring(RS:GetAttribute("RoundMode"))
                .. " RoundPhase=" .. tostring(RS:GetAttribute("RoundPhase")),
            "当前目标(" .. #targets .. "): " .. (#tlist > 0 and table.concat(tlist, " ") or "无"),
            "EscapeExitPosition: " .. tostring(readExit()),
            "readLiftPos: " .. tostring(lp) .. " · 来源=" .. tostring(lsrc),
            "已传送逃离点: " .. tostring(F.LastExit) .. " · 来源=" .. tostring(F.ExitSrc),
            "本地已完成步骤: " .. (#ld > 0 and table.concat(ld, " | ") or "无"),
            "累计投票=" .. tostring(F.Votes) .. " 累计逃脱=" .. tostring(F.Escapes),
            "清单: " .. (#slist > 0 and table.concat(slist, " ") or "无"),
        }, "\n")
    end
    F.Off = function()
        F.Enabled = false
        stop()
        G.AUTOESCAPE = nil
    end

    pcall(function()
        local envs = { G }
        if _G and _G ~= G then envs[#envs + 1] = _G end
        for _, e in ipairs(envs) do
            e.AUTOESCAPE_DUMP = function() print(F.Dump()) end
            e.GATE_DUMP = function() print(F.DumpBreakers()) end
            e.AUTOESCAPE_VOTE = function() return F.VoteNow() end
        end
    end)

    print("[AUTOESCAPE] 已加载 v2.2/v16.13(内嵌 AUTOFARM) · 按清单做任务+藏身上方+坐电梯 · 由全自动挂机调度 · AUTOESCAPE_DUMP()")
end
end

