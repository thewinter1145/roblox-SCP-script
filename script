    -- ============ ①' 任务模式逃脱引擎调度 ============
    -- 引擎 = 内嵌的 G.AUTOESCAPE（读 EscapeChecklist / EscapeTargets，按序触发
    -- ProximityPrompt、上传时锚定藏在屏幕上方、全部完成后坐电梯）。
    -- 这里只负责「什么时候开、什么时候关」，具体干活动作全在引擎里。
    local function escapeEngine() return G.AUTOESCAPE end

    local function setEscape(on)
        local e = escapeEngine()
        if not e then return false end
        if on then
            if not e.Enabled then e.SetEnabled(true) end
        else
            if e.Enabled then e.SetEnabled(false) end
        end
        return true
    end

    -- 是否「本局该做逃脱」：模式=逃脱 + 阶段=进行中 + 自己不是 SCP/鬼魂
    local function shouldEscape()
        if not F.AutoEscape then return false end
        if RS:GetAttribute("RoundMode") ~= "Escape" then return false end
        if RS:GetAttribute("RoundPhase") ~= "Playing" then return false end
        if LP:GetAttribute("InRound") ~= true then return false end
        if LP:GetAttribute("Role") == "SCP" then return false end
        if LP:GetAttribute("Ghost") == true then return false end
        return true
    end

    -- ============ ② 自动捡物资箱 ============
    local function scanCrates()
        local list = {}
        for _, x in ipairs(WS:GetDescendants()) do
            if isCratePP(x) then
                local w = ppWorld(x)
                if w then list[#list + 1] = { pp = x, w = w } end
            end
        end
        F.Crates = #list
        return list
    end

    local function lootCrates()
        local crates = scanCrates()
        F.Looted = 0
        if #crates == 0 then
            F.Phase = "无箱可捡"
            return
        end
        for i, c in ipairs(crates) do
            if not F.Enabled or not F.Looting then return end
            local pp = c.pp
            if isCratePP(pp) then  -- 已开/失效跳过
                F.Phase = string.format("捡箱 %d/%d", i, #crates)
                -- TP 到箱前 3 studs（PP 激活距离 7，留余量）
                tp(c.w + Vector3.new(0, 0, 3))
                task.wait(0.5)
                -- MoveTo 真实走近，触发 PP 系统认可位置（真机验证：瞬移不触发 PromptShown）
                local hum = getHum()
                if hum then pcall(function() hum:MoveTo(c.w) end) end
                -- 等待走到 + 期间 fire（PromptShown 触发后即可开）
                local fired = false
                for j = 1, 20 do
                    task.wait(0.2)
                    local hrp = getHRP()
                    local d = hrp and (hrp.Position - c.w).Magnitude or 999
                    if d < 3.5 and not fired then
                        firePrompt(pp)
                        fired = true
                    elseif fired and not pp.Enabled then
                        break  -- 开箱成功
                    end
                end
                if not fired then firePrompt(pp) end
                task.wait(0.4)
                -- 兜底 InputHold
                if pp.Enabled then
                    pcall(function() pp:InputHoldBegin() end)
                    task.wait(0.1)
                    pcall(function() pp:InputHoldEnd() end)
                    task.wait(0.3)
                end
                if not pp.Enabled then F.Looted = F.Looted + 1 end
                task.wait(0.3)
            end
        end
    end

    -- ============ ③ 自动传天花板 ============
    local function findRoof()
        local best, bestTop = nil, -math.huge
        for _, p in ipairs(WS:GetDescendants()) do
            if p:IsA("BasePart") then
                local nm = lo(p.Name)
                if string.find(nm, "roof", 1, true) or string.find(nm, "ceiling", 1, true) then
                    local top = p.Position.Y + p.Size.Y / 2
                    if top > bestTop then bestTop = top; best = p end
                end
            end
        end
        return best, bestTop
    end

    local function gotoRoof()
        local roof, top = findRoof()
        if not roof then
            F.Phase = "无天花板"
            return false
        end
        local target = roof.Position + Vector3.new(0, roof.Size.Y / 2 + 5, 0)
        local ok = tp(target)
        if ok then F.Phase = "已传天花板" end
        return ok
    end

    -- ============ ④ 自动领奖励 ============
    -- 成就奖励（MISSIONS → ACHIEVEMENTS）：实测接口 ClaimAchievement(key)，服务器判定可领返回 true
    local ACH_KEYS = {
        "Streak","Played","Spec939","Research","Escapes","SCPKills","Alive",
        "Emotes","Level","SCPRounds","Slides","Spec049","SCPWins","Doors",
        "Crates","Quests","Lifer","Spec096","Survive",
    }
    local function achSignature(state)
        if type(state) ~= "table" or type(state.Mission) ~= "table" then return "" end
        local parts = {}
        -- 覆盖全部字段，任何成就对应统计一变就立即触发
        local ach = state.Mission.Ach or {}
        for k, v in pairs(ach) do parts[#parts + 1] = "a" .. tostring(k) .. "=" .. tostring(v) end
        local val = state.Mission.Values or {}
        for k, v in pairs(val) do parts[#parts + 1] = "v" .. tostring(k) .. "=" .. tostring(v) end
        table.sort(parts)
        return table.concat(parts, "|")
    end

    local function claimRewards()
        local ok, res = pcall(function()
            local remotes = RS:FindFirstChild("Remotes")
            local rr = remotes and remotes:FindFirstChild("RewardsRequest")
            if not rr then return nil end
            -- Snapshot 返回 (bool, string, state表, reward表)：真正的数据在第 3 个返回值
            local a, b, state = rr:InvokeServer("Snapshot")
            return { rr = rr, state = state }
        end)
        if not ok or not res then return 0, "无RewardsRequest" end
        local rr, state = res.rr, res.state
        if type(state) ~= "table" or state.Loaded ~= true then return 0, "未加载" end
        local n = 0
        local what = {}
        -- ① 领每日（CanClaim=true 时可领）
        if state.CanClaim == true then
            pcall(function() rr:InvokeServer("ClaimDaily", nil) end)
            n = n + 1; what[#what + 1] = "每日"
        end
        -- ② 领已完成任务（Quests 字段：Claimed/Progress/Target）
        if type(state.Quests) == "table" then
            for i, q in ipairs(state.Quests) do
                if type(q) == "table" and q.Claimed ~= true and (q.Progress or 0) >= (q.Target or 0) then
                    pcall(function() rr:InvokeServer("ClaimQuest", i) end)
                    n = n + 1; what[#what + 1] = "任务" .. i
                end
            end
        end
        -- ③ 时长奖励（已按用户要求关闭，不再领取）
        -- ④ 成就奖励：签名变化立即全扫；4 秒兜底全扫，防止服务器 Snapshot 缓存延迟漏领
        local sig = achSignature(state)
        local nowt = tick()
        local due = (nowt - (F._achSigT or 0)) >= 4
        if sig ~= "" and (due or sig ~= F._achSig) then
            for _, k in ipairs(ACH_KEYS) do
                task.wait(0.03)
                local okc, got = pcall(function() return rr:InvokeServer("ClaimAchievement", k) end)
                if okc and got == true then
                    n = n + 1
                    F.AchClaims = F.AchClaims + 1
                    what[#what + 1] = "成就:" .. k
                end
            end
            F._achSig = sig
            F._achSigT = nowt
        end
        if n > 0 then
            F.Claims = F.Claims + n
            F.LastClaim = table.concat(what, ",")
        end
        return n, table.concat(what, ",")
    end

    -- 级联领奖：检测到可领就连查直到清空
    local function claimSmart()
        if F.Claiming then return 0, "领奖中" end
        F.Claiming = true
        local total, allWhat, guard = 0, {}, 0
        while guard < 12 do
            guard = guard + 1
            local n, what = claimRewards()
            if n and n > 0 then
                total = total + n
                if what and what ~= "" then allWhat[#allWhat + 1] = what end
                if F.ClaimBurst then task.wait(0.3) else break end
            else
                break
            end
        end
        F.Claiming = false
        if total > 0 then F.Phase = "领奖：+" .. tostring(total) .. " " .. table.concat(allWhat, ",") end
        return total, table.concat(allWhat, ",")
    end

    -- 事件驱动：有奖励信号时立刻领（回合结算 / 奖励属性变化）
    local claimDebounce = 0
    local function fastClaim(reason)
        if not F.Enabled or not F.AutoClaim then return end
        local nowt = tick()
        if nowt - claimDebounce < 0.5 then return end
        claimDebounce = nowt
        task.spawn(function()
            task.wait(0.5)
            if F.Enabled and F.AutoClaim then
                local n = claimSmart()
                if n > 0 then F.LastClaim = F.LastClaim .. " [" .. tostring(reason or "事件") .. "]" end
            end
        end)
    end

    -- ============ 主状态机（监听 RoundPhase / RoundMode）============
    -- v16.12：本轮如果是 Escape（任务模式），不捡箱、不传天花板，直接把控制权
    -- 交给内嵌逃脱引擎；生存局照旧。任何切回/退出都立即关闭引擎，不留残留。
    local function onPhase()
        if not F.Enabled then return end
        local phase = RS:GetAttribute("RoundPhase")
        local mode  = RS:GetAttribute("RoundMode")

        if phase == "Voting" then
            F.Mode = "投票"
            if F.AutoVote and not F.VotedThisPhase then
                F.VotedThisPhase = true
                task.spawn(function()
                    task.wait(0.6)
                    local ok, want = voteRound()
                    F.Phase = ok and ("已投 " .. tostring(want)) or "投票失败"
                end)
            elseif not F.AutoVote then
                F.Phase = "投票中(不自动投票)"
            end
        elseif phase == "Playing" then
            F.VotedThisPhase = false
            F.Mode = tostring(mode or "?")
            if mode == "Escape" then
                -- ===== 任务模式：全自动逃脱 =====
                F.Looting = false
                if LP:GetAttribute("Role") == "SCP" then
                    setEscape(false)
                    F.Phase = "任务模式：本局你是 SCP"
                elseif shouldEscape() then
                    F.Phase = "任务模式：自动逃脱"
                    if not setEscape(true) then
                        F.Phase = "任务模式：缺少 AUTOESCAPE 引擎"
                    end
                else
                    setEscape(false)
                    F.Phase = "任务模式：未参与(旁观/已逃脱)"
                end
            else
                -- ===== 生存模式：原挂机流程 =====
                setEscape(false)
                if F.AutoLoot and not F.Looting then
                    F.Looting = true
                    task.spawn(function()
                        F.Phase = "开始捡箱"
                        lootCrates()
                        if F.Enabled and F.AutoRoof then
                            gotoRoof()
                        end
                        F.Looting = false
                        if F.Enabled and F.Phase ~= "已传天花板" then
                            F.Phase = "挂机中"
                        end
                    end)
                end
            end
        elseif phase == "Intermission" or phase == "Lobby" then
            F.Looting = false
            F.VotedThisPhase = false
            F.Crates, F.Looted = 0, 0
            F.Mode = "无"
            setEscape(false)   -- 回合结束立刻收手，下一局不残留
            F.Phase = (phase == "Lobby") and "大厅" or "局间休息"
        end
    end

    local function start()
        if F.Conn then return end
        F.Conn = RS:GetAttributeChangedSignal("RoundPhase"):Connect(onPhase)
        -- v16.12：中途切模式（例如管理员直接开/关逃脱）也立刻交接，不等下一局
        F.ModeConn = RS:GetAttributeChangedSignal("RoundMode"):Connect(onPhase)
        pcall(onPhase)
        -- 领奖定时器：只读轮询，检测到可领立即领+级联
        if F.AutoClaim then
            F.ClaimConn = task.spawn(function()
                while G.AUTOFARM == F do
                    task.wait(F.ClaimEvery)
                    if F.Enabled and F.AutoClaim and not F.Claiming then
                        pcall(claimSmart)
                    end
                end
            end)
            -- 事件驱动：回合结算 / 奖励属性变化立即领
            pcall(function()
                F.RewardPhaseConn = RS:GetAttributeChangedSignal("RoundPhase"):Connect(function()
                    task.spawn(function() task.wait(1.0); fastClaim("回合结算") end)
                end)
                F.RewardAttrConn = LP:GetAttributeChangedSignal("RewardReady"):Connect(function() fastClaim("奖励属性") end)
            end)
            task.spawn(function() task.wait(0.5); fastClaim("启动") end)
        end
    end
    local function stop()
        setEscape(false)   -- 关闭总开关时同步关掉逃脱引擎，避免它继续传送
        if F.Conn then pcall(function() F.Conn:Disconnect() end) end
        if F.ModeConn then pcall(function() F.ModeConn:Disconnect() end) end
        if F.RewardPhaseConn then pcall(function() F.RewardPhaseConn:Disconnect() end) end
        if F.RewardAttrConn then pcall(function() F.RewardAttrConn:Disconnect() end) end
        F.Conn = nil
        F.ModeConn = nil
        F.RewardPhaseConn = nil
        F.RewardAttrConn = nil
        F.Looting = false
    end

    -- ============ 对外接口 ============
    F.SetEnabled = function(v)
        F.Enabled = v and true or false
        if F.Enabled then
            start()
            F.Phase = "运行中"
            warn("[AUTOFARM] 已开启：投票(生存/逃脱) + 生存局捡箱躲藏 + 任务模式自动逃脱 + 领奖励")
        else
            stop()
            F.Phase = "待命（已关闭）"
            warn("[AUTOFARM] 已关闭")
        end
        return F.Enabled
    end
    F.SetAutoVote  = function(v) F.AutoVote = v and true or false; return F.AutoVote end
    F.SetAutoLoot  = function(v) F.AutoLoot = v and true or false; return F.AutoLoot end
    F.SetAutoRoof  = function(v) F.AutoRoof = v and true or false; return F.AutoRoof end
    F.SetAutoClaim = function(v)
        F.AutoClaim = v and true or false
        if F.AutoClaim and F.Enabled and not F.ClaimConn then start() end
        if F.AutoClaim then fastClaim("开启自动领奖") end
        return F.AutoClaim
    end
    -- v16.12：任务模式逃脱开关；关掉时若正在逃脱，立刻停手不再传送
    F.SetAutoEscape = function(v)
        F.AutoEscape = v and true or false
        if not F.AutoEscape then setEscape(false) end
        return F.AutoEscape
    end
    -- 手动立即开始/停止逃脱（不等回合判断）
    F.EscapeNow = function()
        if not escapeEngine() then return false, "缺少 AUTOESCAPE 引擎" end
        if not setEscape(true) then return false, "引擎启动失败" end
        F.Phase = "任务模式：手动逃脱"
        return true
    end
    F.StopEscape = function() setEscape(false); return true end
    F.ClaimNow = function()
        local n, what = claimSmart()
        F.Phase = "领奖：" .. (n > 0 and ("+" .. n .. " " .. what) or "无可领")
        return n, what
    end
    F.LootNow = function()
        if F.Looting then return 0, "正在捡" end
        F.Looting = true
        task.spawn(function()
            lootCrates()
            F.Looting = false
        end)
        return F.Crates
    end
    F.GotoRoofNow = function() return gotoRoof() end
    F.VoteNow = function() return voteRound() end
    F.Dump = function()
        local e = escapeEngine()
        local esc = "无"
        if e then
            esc = string.format("Enabled=%s Phase=%s Current=%s 累计逃脱=%s",
                tostring(e.Enabled), tostring(e.Phase), tostring(e.Current), tostring(e.Escapes))
        end
        return table.concat({
            "=== AUTOFARM v1.2 Dump ===",
            "Enabled=" .. tostring(F.Enabled) .. " Phase=" .. tostring(F.Phase)
                .. " Mode=" .. tostring(F.Mode),
            "AutoVote=" .. tostring(F.AutoVote) .. " AutoLoot=" .. tostring(F.AutoLoot)
                .. " AutoRoof=" .. tostring(F.AutoRoof) .. " AutoClaim=" .. tostring(F.AutoClaim)
                .. " AutoEscape=" .. tostring(F.AutoEscape),
            "本轮扫箱=" .. tostring(F.Crates) .. " 已开=" .. tostring(F.Looted),
            "累计投票=" .. tostring(F.Votes) .. "(最近 " .. tostring(F.LastVote) .. ")"
                .. " 累计领奖=" .. tostring(F.Claims) .. " 成就领=" .. tostring(F.AchClaims)
                .. " 最近=" .. tostring(F.LastClaim),
            "RoundMode=" .. tostring(RS:GetAttribute("RoundMode"))
                .. " RoundPhase=" .. tostring(RS:GetAttribute("RoundPhase")),
            "任务逃脱引擎: " .. esc,
        }, "\n")
    end
    F.Off = function()
        F.Enabled = false
        stop()
        if F.ClaimConn then pcall(function() task.cancel(F.ClaimConn) end) end
        F.ClaimConn = nil
        G.AUTOFARM = nil
    end

    pcall(function()
        local envs = { G }
        if _G and _G ~= G then envs[#envs + 1] = _G end
        for _, e in ipairs(envs) do
            e.AUTOFARM_DUMP  = function() print(F.Dump()) end
            e.AUTOFARM_CLAIM = function() return F.ClaimNow() end
            e.AUTOFARM_LOOT  = function() return F.LootNow() end
            e.AUTOFARM_ROOF  = function() return F.GotoRoofNow() end
            e.AUTOFARM_VOTE  = function() return F.VoteNow() end
            e.AUTOFARM_ESCAPE = function() return F.EscapeNow() end
        end
    end)

    print("[AUTOFARM] 已加载 v1.2 · 全自动挂机(投票/生存捡箱躲藏/任务模式自动逃脱/领奖励) · 默认关闭 · AUTOFARM_DUMP()")
end

