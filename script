    -- ===== 第二个栏位：防护 =====
    local TabGuard = Window:AddTab("防护", "shield")
    local GD = TabGuard:AddLeftGroupbox("096 拦截", "shield")

    -- 兼容不同版本黑曜石：AddLabel 可能返回 Label 对象或 TextLabel 实例。
    -- 三种写法都独立 pcall 尝试，任一生效即可，避免「次数不刷新」。
    local function setLbl(lbl, txt)
        if not lbl then return end
        pcall(function() lbl:SetText(txt) end)          -- Label 对象（Obsidian 标准）
