      if e.tier == 2 and m.Parent then
        local hum = m:FindFirstChildOfClass("Humanoid")
        if (hum == nil) or hum.Health > 0 then
          local head = headOf(m)
          local p = head and head.Position or m:GetPivot().Position
          local d = (p - myPos).Magnitude
          if d < bestD then best, bestD = m, d end
        end
      end
    end
    return best, bestD
  end

  local function buildPool()
    local pool, seen = {}, {}
    local function push(m)
      if m and not seen[m] then
        seen[m] = true
        pool[#pool + 1] = m
      end
    end

    for _, m in ipairs(CS:GetTagged("StaffNPC")) do push(m) end

    local folder = WS:FindFirstChild("Staff")
    if folder then
      for _, m in ipairs(folder:GetChildren()) do
        if m:IsA("Model") then push(m) end
      end
    end

    local isPlayerChar = {}
    for _, p in ipairs(PlayersSvc:GetPlayers()) do
      if p.Character then isPlayerChar[p.Character] = true end
    end

    for _, m in ipairs(WS:GetChildren()) do
      if m:IsA("Model") and not isPlayerChar[m] and m:FindFirstChildOfClass("Humanoid") then
        local role = m:GetAttribute("StaffRole")
        local staff = m:GetAttribute("Staff") == true
        local lname = string.lower(m.Name)
        local hitKw = false
        for _, kw in ipairs(KEYWORDS) do
          if string.find(lname, kw, 1, true) then hitKw = true break end
        end
        if staff or role ~= nil or hitKw or H.playerNames[lname] then push(m) end
      end
    end

    return pool
  end

  local function scan()
    local pool = buildPool()
    local alive = {}
    local sp, ab, no = 0, 0, 0

    for _, m in ipairs(pool) do
      if m:IsA("Model") and m.Parent then
        alive[m] = true
        local hum = m:FindFirstChildOfClass("Humanoid")
        local dead = (hum and hum.Health <= 0) or m:GetAttribute("Ragdolled") == true
        local tier, reason = classify(m)

        if tier == 2 then sp = sp + 1
        elseif tier == 1 then ab = ab + 1
        else no = no + 1 end

        local e = H.derived[m]
        if not e then
          if not (tier == 0 and not H.ShowNormal) then
            e = makeEntry(m, tier, reason)
            H.derived[m] = e
            if tier == 2 and not H.known[m] then
              H.known[m] = true
              local attrs = table.concat(attrsOf(m), ", ")
              warn(string.format("[STAFFHUNT] ★ 特殊研究员：%s | %s | %s",
                m:GetFullName(), reason, attrs))
              pcall(function()
                SG:SetCore("SendNotification", {
                  Title = "★ 特殊研究员",
                  Text = m.Name .. "  " .. reason,
                  Duration = 6,
                })
              end)
            end
          end
        elseif dead then
          if e.hl then e.hl.FillTransparency = 0.95 end
          if e.label then e.label.Text = "☠ " .. m.Name end
        end
      end
    end

    for m in pairs(H.derived) do
      if not alive[m] then
        if m == H.target then H.target = nil end
        destroyEntry(m)
      end
    end

    H.Counts = { special = sp, abnormal = ab, normal = no }
    setStatus(string.format(
      "特殊研究员追猎 %s  ★特殊 %d  ?可疑 %d  普通 %d  | %s",
      (H.Enabled and "[ON]" or "[OFF]"), sp, ab, no, H.lastTP
    ))
  end

  local function pursue()
    if not H.AutoTP then return end
    local ok = canTP(false)
    if not ok then return end

    local target, dist = pickTarget()
    if not target then H.target = nil return end

    if H.target ~= target then
      H.target = target
      H.tpCount = 0
      H.nextTP = 0
    end

    local now = os.clock()
    if dist <= H.FirstTPDist then return end
    if now < H.nextTP then return end
    if H.tpCount >= H.MaxTPPerTarget then return end

    local done, err = tpTo(target)
    H.tpCount = H.tpCount + 1
    H.nextTP = now + H.TeleportCD

    if done then
      H.tpTotal = H.tpTotal + 1
      H.lastTP = string.format("已传送 %s（%d→%d格·第%d次）",
        target.Name, math.floor(dist), H.SafeDist, H.tpCount)
      warn("[STAFFHUNT] " .. H.lastTP)
      watch(target, H.WatchSeconds)
      pcall(function()
        SG:SetCore("SendNotification", {
          Title = "→ 已传送到特殊研究员",
          Text = target.Name .. "  第 " .. H.tpCount .. " 次",
          Duration = 3,
        })
      end)
    else
      H.lastTP = "传送失败：" .. tostring(err)
      warn("[STAFFHUNT] " .. H.lastTP)
    end
  end

  local function refreshTexts()
    local root = myRoot()
    if not root then return end
    local myPos = root.Position
    for m, e in pairs(H.derived) do
      if e.label and m.Parent then
        local head = headOf(m)
        local p = head and head.Position or m:GetPivot().Position
        local d = (p - myPos).Magnitude
        local tag = (e.tier == 2 and "★ SPECIAL")
          or (e.tier == 1 and "? ABNORMAL") or m.Name
        local extra = (e.tier ~= 0) and ("\n" .. e.reason) or ""
        local txt = string.format("%s  [%d]", tag, math.floor(d)) .. extra
        if e.lastTxt ~= txt then
          e.lastTxt = txt
          e.label.Text = txt
        end
      end
    end
  end

  local function tpNow()
    local ok, why = canTP(true)
    if not ok then return false, why end
    local target, dist = pickTarget()
    if not target then return false, "场上没有 ★ 特殊研究员" end
    local done, err = tpTo(target)
    if done then
      H.target = target
      H.tpTotal = H.tpTotal + 1
      H.lastTP = string.format("手动传送 %s（%d→%d格）",
        target.Name, math.floor(dist or 0), H.SafeDist)
      watch(target, H.WatchSeconds)
      return true, H.lastTP
    end
    return false, err
  end

  local function dump()
    local pool = buildPool()
    local lines = { "=== STAFFHUNT v1.3 Dump ===" }
    lines[#lines + 1] = string.format(
      "Enabled=%s AutoTP=%s 目标=%s 累计传送=%d 作者资产=%d 玩家缓存=%d",
      tostring(H.Enabled), tostring(H.AutoTP),
      tostring(H.target and H.target.Name or "无"), H.tpTotal,
      (function() local n = 0 for _ in pairs(H.ownerAssets) do n = n + 1 end return n end)(),
      (function() local n = 0 for _ in pairs(H.playerAssets) do n = n + 1 end return n end)())
    lines[#lines + 1] = "观察池=" .. #pool
    for _, m in ipairs(pool) do
      local hum = m:FindFirstChildOfClass("Humanoid")
      local tier, reason = classify(m)
      local _, ids = assetsOf(m)
      lines[#lines + 1] = string.format("%s | %s | %s | tier=%d | 资产=[%s] | %s | attrs={%s}",
        m:GetFullName(), m.Name, tostring(hum and hum.RigType), tier,
        table.concat(ids, ","), reason, table.concat(attrsOf(m), ", "))
    end
    local text = table.concat(lines, "\n")
    print(text)
    return text
  end

  local function start()
    if H.conn then return end
    H.Enabled = true
    cleanupStale()
    makeGui()
    refreshAssets()
    H.conn = RUS.Heartbeat:Connect(function()
      if not H.Enabled then return end
      local now = os.clock()
      local ok, err = pcall(function()
        if now - H.assetAt > 30 then refreshAssets() end
        if now - H.scanAt >= H.ScanInterval then
          H.scanAt = now
          scan()
          pursue()
        end
        if now - (H.textAt or 0) >= 0.25 then
          H.textAt = now
          refreshTexts()
        end
      end)
      if not ok then setStatus("追猎出错：" .. tostring(err)) end
    end)
    warn("[STAFFHUNT] 已开启 v1.3：描述资产匹配 + 自动传送（>" .. H.FirstTPDist
      .. " 格传送至 " .. H.SafeDist .. " 格）")
  end

  local function stop()
    H.Enabled = false
    if H.conn then pcall(function() H.conn:Disconnect() end) end
    H.conn = nil
    if H.watchConn then pcall(function() H.watchConn:Disconnect() end) end
    H.watchConn = nil
    for m in pairs(H.derived) do destroyEntry(m) end
    H.target = nil
    local pg = LP and LP:FindFirstChild("PlayerGui")
    local gui = pg and pg:FindFirstChild("StaffHuntGui")
    if gui then gui:Destroy() end
    H.label = nil
  end

  H.SetEnabled = function(v)
    if v then start() else stop() end
    return H.Enabled
  end
  H.Toggle = function() return H.SetEnabled(not H.Enabled) end
  H.SetTP = function(v) H.AutoTP = v and true or false return H.AutoTP end
  H.SetWatch = function(v) H.AutoWatch = v and true or false return H.AutoWatch end
  H.SetShowNormal = function(v) H.ShowNormal = v and true or false return H.ShowNormal end
  H.TPNow = tpNow
  H.Dump = dump
  H.HasTarget = function()
    if not H.Enabled then return false end
    local t, d = pickTarget()
    return (t ~= nil) and (d or 999) > H.FirstTPDist
  end
  H.Off = function()
    stop()
    G.STAFFHUNT = nil
  end

  pcall(function()
    local envs = { G }
    if _G and _G ~= G then envs[#envs + 1] = _G end
    for _, e in ipairs(envs) do
      e.STAFFHUNT_TOGGLE = function() return H.Toggle() end
      e.STAFFHUNT_TP     = function() return H.TPNow() end
      e.STAFFHUNT_DUMP   = function() print(H.Dump()) end
    end
  end)

  print("[STAFFHUNT] 已加载 v1.3 · 判据=描述资产(普通员工 0 项) + 作者/玩家资产匹配 · 自动传送 · 默认关闭 · STAFFHUNT_TOGGLE()")
end

-- ============================================================
-- 饮水机 / 饮料机 透视（独立轻量模块 · 零 hook · 零元表）
-- 判据：物件名 或 互动按钮(ProximityPrompt) 文案含 water/cooler/dispenser/
--       drink/饮料/饮水 等词；294 的机器交给「新SCP透视」标 SCP-294，这里不重复画
-- 诊断：getgenv().WATER_ESP.Dump()
-- ============================================================
do
    local WS     = game:GetService("Workspace")
    local RunSvc = game:GetService("RunService")

    local W = {
        Enabled = true, Range = 1200, ScanInterval = 6,
        Marks = {}, Count = 0, Found = 0, Status = "待命",
    }
    G.WATER_ESP = W

    local NAME_HITS = { "water", "cooler", "dispenser", "fountain", "drink", "水", "饮" }
    local PROMPT_HITS = { "water", "drink", "dispense", "饮水", "水", "接水", "取水" }
    -- 硬门槛：名字里必须真带「水」类词，或机器上有「接水/饮水/取水」按钮；
    -- 售货机/咖啡机/SodaMachine 这类普通物件一律不标（v16.22 修误标）
    local STRICT_PROMPT = { "water", "drink", "dispense", "饮水", "接水", "取水",
                            "水机", "水龙头", "fountain", "dispenser", "cooler" }
    local BAD = { "door", "gate", "wall", "pipe", "wire", "cable", "effect",
        "particle", "sound", "gui", "texture", "decal", "fall", "corpse",
        "crate", "supply", "drag", "mask", "screen",
        "vending", "soda", "snack", "candy", "chips", "coffee", "fridge",
        "freezer", "shelf", "microwave", "toaster", "register", "shop" }

    local HEAVY = Enum.Font.GothamBold
    pcall(function() HEAVY = Enum.Font.GothamBlack end)

    local function low(s) return string.lower(tostring(s or "")) end

    local function hasAny(t, list)
        t = low(t)
        for i = 1, #list do
            if string.find(t, low(list[i]), 1, true) then return true end
        end
        return false
    end
    local function badName(n) return hasAny(n, BAD) end
    local function hitName(n) return hasAny(n, NAME_HITS) end

    local function hitPrompt(p)
        local t = ""
        pcall(function()
            t = tostring(p.ActionText) .. " " .. tostring(p.ObjectText)
                .. " " .. tostring(p.Parent and p.Parent.Name)
        end)
        return hasAny(t, PROMPT_HITS)
    end

    -- 只认「真的是饮水/接水」的按钮，售货机的 Buy Drink 不算
    local function strictPrompt(p)
        local t = ""
        pcall(function()
            t = tostring(p.ActionText) .. " " .. tostring(p.ObjectText)
                .. " " .. tostring(p.Parent and p.Parent.Name)
        end)
        return hasAny(t, STRICT_PROMPT)
    end

    -- 该物件内部是否有「接水类」按钮
    local function hasWaterPrompt(o)
        local ok, desc = pcall(function() return o:GetDescendants() end)
        if not ok or not desc then return false end
        for i = 1, #desc do
            local d = desc[i]
            local okC, isP = pcall(function() return d:IsA("ProximityPrompt") end)
            if okC and isP and strictPrompt(d) then return true end
        end
        return false
    end

    local CSvc294 = game:GetService("CollectionService")
    -- 294 归「新SCP透视」管（它标 SCP-294），饮水机模块不再重复画
    local function is294(o)
        -- 自己或最近 3 层父级：名字含 294 / 带 SCP294 标签，都算 294 的机器
        local cur = o
        for _ = 1, 4 do
            local nm2 = ""
            pcall(function() nm2 = tostring(cur.Name) end)
            if string.find(nm2, "294", 1, true) then return true end
            local tagHit = false
            pcall(function()
                for _, t in ipairs(CSvc294:GetTags(cur)) do
                    if string.find(tostring(t), "294", 1, true) then tagHit = true; break end
                end
            end)
            if tagHit then return true end
            local p
            pcall(function() p = cur.Parent end)
            if not p or p == WS then break end
            cur = p
        end
        local ok, desc = pcall(function() return o:GetDescendants() end)
        if ok and desc then
            local n = #desc
            if n > 80 then n = 80 end
            for i = 1, n do
                local d = desc[i]
                local okC, isP = pcall(function() return d:IsA("ProximityPrompt") end)
                if okC and isP then
                    local txt = ""
                    pcall(function() txt = tostring(d.ActionText) .. " " .. tostring(d.ObjectText) end)
                    if string.find(txt, "294", 1, true) then return true end
                end
            end
        end
        return false
    end

    local function anchorOf(o)
        if not o then return nil end
        local ok, isPart = pcall(function() return o:IsA("BasePart") end)
        if ok and isPart then return o end
        local okP, pp = pcall(function() return o.PrimaryPart end)
        if okP and pp then return pp end
        local okD, desc = pcall(function() return o:GetDescendants() end)
        if okD and desc then
            for i = 1, #desc do
                local x = desc[i]
                local okB, isB = pcall(function() return x:IsA("BasePart") end)
                if okB and isB then return x end
            end
        end
        return nil
    end

    -- 命中 Part 时上跳到「名字也命中」的最近 Model，避免同一台机器被标十几次
    local function nearestHitModel(o)
        local cur = o
        for _ = 1, 4 do
            local ok, p = pcall(function() return cur.Parent end)
            if not ok or not p or p == WS then break end
            local okM, isM = pcall(function() return p:IsA("Model") end)
            if okM and isM then
                local nm
                pcall(function() nm = p.Name end)
                if nm and hitName(nm) and not badName(nm) then return p end
            end
            cur = p
        end
        return o
    end

    local function safeParent(inst)
        local ok = pcall(function() inst.Parent = game:GetService("CoreGui") end)
        if not ok or not inst.Parent then pcall(function() inst.Parent = WS end) end
    end

    local function setMark(o, part, base)
        local r = W.Marks[o]
        if r then
            r.part = part
            r.base = base
            pcall(function() r.bg.Adornee = part end)
            return
        end
        local bg = Instance.new("BillboardGui")
        bg.Name = "WATER_BB"
        bg.Adornee = part
        bg.AlwaysOnTop = true
        bg.MaxDistance = W.Range
        bg.Size = UDim2.new(0, 200, 0, 34)
        bg.StudsOffset = Vector3.new(0, 1.6, 0)
        safeParent(bg)
        local tl = Instance.new("TextLabel")
        tl.Size = UDim2.new(1, 0, 1, 0)
        tl.BackgroundTransparency = 1
        tl.TextColor3 = Color3.fromRGB(110, 220, 255)
        tl.TextStrokeColor3 = Color3.new(0, 0, 0)
        tl.TextStrokeTransparency = 0
        tl.TextSize = 15
        tl.Font = HEAVY
        tl.Text = base
        tl.Parent = bg
        W.Marks[o] = { bg = bg, tl = tl, part = part, base = base }
    end

    local function clearMark(o)
        local r = W.Marks[o]
        if not r then return end
        pcall(function() r.bg:Destroy() end)
        W.Marks[o] = nil
    end

    local function scan()
        local found, foundN = {}, 0
        local okD, desc = pcall(function() return WS:GetDescendants() end)
        if okD and desc then
            local n = #desc
            if n > 12000 then n = 12000 end
            for i = 1, n do
                -- 分批让出一帧：单次 1.2 万后代不再压成一个大长帧（卡顿主因）
                if i % 3000 == 0 then task.wait() end
                local o = desc[i]
                local okC, cls = pcall(function() return o.ClassName end)
                if okC then
                    if cls == "ProximityPrompt" then
                        if hitPrompt(o) and strictPrompt(o) then
                            local holder
                            pcall(function()
                                holder = o:FindFirstAncestorOfClass("Model") or o.Parent
                            end)
                            if holder then
                                local nm
                                pcall(function() nm = holder.Name end)
                                if nm and not badName(nm) then
                                    if not found[holder] then found[holder] = true; foundN = foundN + 1 end
                                end
                            end
                        end
                    elseif cls == "Model" or cls == "Part" or cls == "MeshPart"
                        or cls == "UnionOperation" or cls == "TrussPart"
                        or cls == "SpawnLocation" then
                        local nm = o.Name
                        if nm then
                            local ln = string.lower(nm)
                            -- 廉价预过滤：名字里没有任何候选词就直接跳过（省掉后续 pcall/递归）
                            local quick = false
                            for qi = 1, #NAME_HITS do
                                if string.find(ln, NAME_HITS[qi], 1, true) then quick = true; break end
                            end
                            if quick and not badName(nm) and hasWaterPrompt(o) then
                                local t = nearestHitModel(o)
                                if not found[t] then found[t] = true; foundN = foundN + 1 end
                            end
                        end
                    end
                end
            end
        end

        local marked = 0
        for _ in pairs(W.Marks) do marked = marked + 1 end

        for o in pairs(found) do
            local part = (not is294(o)) and anchorOf(o) or nil
            if part then
                if W.Marks[o] then
                    W.Marks[o].part = part
                    pcall(function() W.Marks[o].bg.Adornee = part end)
                elseif marked < 60 then
                    local nm
                    pcall(function() nm = o.Name end)
                    local base = "饮水机 · " .. tostring(nm)
                    setMark(o, part, base)
                    marked = marked + 1
                end
            end
        end

        for o, r in pairs(W.Marks) do
            if not found[o] or r.stale then clearMark(o) end
        end

        W.Found  = foundN
        W.Count  = marked
        W.Status = "已标 " .. tostring(marked) .. " / 命中 " .. tostring(foundN)
    end

    -- 距离刷新（0.25s 一次，只改文字，不重扫）
    RunSvc.RenderStepped:Connect(function()
        if not W.Enabled then return end
        local now = tick()
        if now - (W._t or 0) < 0.25 then return end
        W._t = now
        local cam = WS.CurrentCamera
        if not cam then return end
        local cp = cam.CFrame.Position
        for _, r in pairs(W.Marks) do
            local ok = pcall(function()
                if not r.part or not r.part.Parent then
                    r.stale = true
                    return
                end
                local d = (r.part.Position - cp).Magnitude
                if d > W.Range then
                    r.bg.Enabled = false
                else
                    r.bg.Enabled = true
                    r.tl.Text = string.format("%s  %dm", r.base, math.floor(d))
                end
            end)
            if not ok then r.stale = true end
        end
    end)

    task.spawn(function()
        while G.WATER_ESP == W do
            if W.Enabled then pcall(scan) end
            task.wait(W.ScanInterval)
        end
    end)

    W.SetEnabled = function(v)
        W.Enabled = v and true or false
        if not W.Enabled then
            for o in pairs(W.Marks) do clearMark(o) end
            W.Marks = {}
            W.Status = "已关闭"
        else
            task.defer(function() pcall(scan) end)
        end
        return W.Enabled
    end
    W.SetRange = function(n) W.Range = math.max(50, tonumber(n) or 1200); return W.Range end
    W.Dump = function()
        local o = {}
        o[#o + 1] = string.format("WATER_ESP Enabled=%s Range=%s Marks=%d Found=%d Status=%s",
            tostring(W.Enabled), tostring(W.Range), W.Count, W.Found, tostring(W.Status))
        for inst, r in pairs(W.Marks) do
            local nm = "?"
            pcall(function() nm = inst.Name end)
            local pos = r.part and r.part.Position
            o[#o + 1] = string.format("  %-28s %s", nm,
                pos and string.format("(%.0f,%.0f,%.0f)", pos.X, pos.Y, pos.Z) or "无坐标")
        end
        return table.concat(o, "\n")
    end

    print("[WATER] 饮水机透视已装载 · 默认开 · 诊断 G.WATER_ESP.Dump()")
end

-- ============================================================
-- 【内嵌】新 SCP 透视 NEWSCP_ESP v3（CollectionService 标签事件驱动 + 名字兜底）
-- 覆盖：任何带 SCP 标签、或名字含 SCP 编号的「非角色」物件
--       294 饮料机 / 458 披萨盒 / 500 药片 / 714 玉戒 / 1025 医学百科 …
-- 角色型 SCP 不在这里标（跳过带 Humanoid 的对象，交给主 ESP，避免一个目标两套标签）
-- 安全：只在 CoreGui 建 BillboardGui；不碰 PlayerGui / 触摸层 / 相机；不挂 hook
-- 诊断：getgenv().NEWSCP_ESP.Dump()
-- ============================================================
do
    local Gg = getgenv()
    if Gg.NEWSCP_ESP and Gg.NEWSCP_ESP.Off then pcall(Gg.NEWSCP_ESP.Off) end

    local WS = workspace
    local CS = game:GetService("CollectionService")
    local RS = game:GetService("RunService")

    local ESP = {
        Enabled      = true,
        MaxDist      = 500,     -- 只显示这个距离内（米）
        Marked       = {},
        Conns        = {},
        TagList      = {},
        NameFallback = true,    -- 无标签时按物件名兜底（每 10s 一次，限 15000 个后代）
        ScanInterval = 10,
        Found        = 0,
        Status       = "待命",
    }
    Gg.NEWSCP_ESP = ESP

    local HEAVY = Enum.Font.GothamBold
    pcall(function() HEAVY = Enum.Font.GothamBlack end)
    local OUTLINE = Color3.new(0, 0, 0)

    -- 装饰后缀：不单独透视（Cup 让 294 杯子不刷屏）
    -- 这几号一律不标（999 友好 / 131 眼球 / 005 钥匙），所有路径都在 addMark 处兜底
    local HIDE_NUMS = { ["999"] = true, ["131"] = true, ["005"] = true }
    local SKIP_SUFFIX = { "Cup", "FeedScreen", "Passable", "Sinkhole", "Feed", "Screen",
                          "Dragon", "Follower", "Cable", "Conduit", "Wire" }
    local DEAD_KW     = { "corpse", "ragdoll", "dead", "remains", "oldbody", "debris" }

    -- 场景/建筑词：名字里一出现就绝不标（「满墙 SCP-914」就是房间构件的名字带的）
    local SCENE_BAD = {
        "room", "wall", "floor", "ceil", "door", "gate", "shelf", "rack", "cabinet",
        "locker", "light", "lamp", "window", "sign", "deco", "spawn", "zone",
        "chamber", "area", "sector", "hall", "corridor", "pipe", "panel", "screen",
        "button", "lever", "switch", "glass", "frame", "table", "chair", "desk",
        "stair", "elevator", "vent", "texture", "mesh", "hitbox", "trigger",
        "boundary", "invisible", "marker", "waypoint", "sensor", "hitbox",
        "collision", "structure", "building", "facility", "entrance", "exit",
        "shaft", "duct", "ceiling", "floor", "ground", "base",
    }
    local function hasSceneWord(nm)
        local l = string.lower(tostring(nm or ""))
        for i = 1, #SCENE_BAD do
            if string.find(l, SCENE_BAD[i], 1, true) then return true end
        end
        return false
    end

    -- 可拾取 / 可交互（Tool，或自带互动按钮）→ 才算「道具本体」
    local function isPropLike(o)
        local ok, t = pcall(function() return o:IsA("Tool") end)
        if ok and t then return true end
        local ok2, pr = pcall(function() return o:FindFirstChildWhichIsA("ProximityPrompt", true) end)
        return ok2 and pr ~= nil
    end

    local function compact(s)
        return string.gsub(string.lower(tostring(s or "")), "[-_%s]", "")
    end

    -- 标签必须「整条」就是 SCP<编号>，或只带一个已知语义后缀。
    -- 旧版是 scp(%d+) 任意位置匹配 → SCP914Room / SCP005Shelf 全被当成道具（满屏误标根因）
    local TAG_OK_SUFFIX = { "host", "entity", "monster", "npc", "instance",
                            "character", "item", "tool", "pickup", "anomaly" }
    local function labelFromTag(tag)
        local c = compact(tag)
        for _, w in ipairs(DEAD_KW) do
            if string.find(c, w, 1, true) then return nil end
        end
        local n = string.match(c, "^scp(%d%d%d%d?)$")
        if n then return "SCP-" .. n end
        local n2, sfx = string.match(c, "^scp(%d%d%d%d?)(%a+)$")
        if n2 then
            for _, ok in ipairs(TAG_OK_SUFFIX) do
                if sfx == ok then return "SCP-" .. n2 end
            end
        end
        return nil
    end

    -- 从物件名兜底解析（只认 scp+数字，避免 Room173 这类误标）
    local function labelFromName(o)
        local nm
        pcall(function() nm = o.Name end)
        if not nm then return nil end
        if hasSceneWord(nm) then return nil end   -- 墙/柜/门/灯…一律否决
        local c = compact(nm)
        for _, w in ipairs(DEAD_KW) do
            if string.find(c, w, 1, true) then return nil end
        end
        local n, rest = string.match(c, "^scp(%d%d%d%d?)(.*)$")
        if n then
            -- 名字以 SCP<编号> 开头：尾巴 ≤3 字符（如 SCP005）或本身是可拾取物才算道具本体；
            -- SCP914ControlPanel 这种长尾巴的房间构件直接丢掉
            if #rest <= 3 or isPropLike(o) then return "SCP-" .. n end
            return nil
        end
        -- 没有编号时按「长词」认物（只用 >=6 字符的组合词，避免 ring/spring 这类误标）
        local MAP = {
            { "pizzabox",     "SCP-458" },
            { "infinitepizza","SCP-458" },
            { "candybowl",    "SCP-330" },
            { "panacea",      "SCP-500" },
            { "medicalbook",  "SCP-1025" },
            { "jadering",     "SCP-714" },
        }
        for _, kv in ipairs(MAP) do
            if string.find(c, kv[1], 1, true) then
                if isPropLike(o) or #c <= 22 then return kv[2] end
            end
        end
        return nil
    end

    local DANGER = {
        ["049"]=true, ["096"]=true, ["106"]=true, ["173"]=true, ["303"]=true,
        ["610"]=true, ["650"]=true, ["682"]=true, ["939"]=true, ["035"]=true,
        ["1762"]=true, ["6161"]=true, ["079"]=true,
    }
    local function colorFor(label)
        local id = string.match(label, "SCP%-(%d+)") or "0"
        if DANGER[id] then return Color3.fromRGB(255, 40, 40) end
        local n = tonumber(id) or 0
        local palette = {
            Color3.fromRGB(255, 90, 90),  Color3.fromRGB(255, 180, 70),
            Color3.fromRGB(120, 210, 255), Color3.fromRGB(190, 130, 255),
            Color3.fromRGB(130, 255, 170), Color3.fromRGB(255, 140, 210),
        }
        return palette[(n % #palette) + 1]
    end

    local function safeParent(inst)
        local ok = pcall(function() inst.Parent = game:GetService("CoreGui") end)
        if not ok or not inst.Parent then pcall(function() inst.Parent = WS end) end
    end

    local function posOf(o)
        local p
        pcall(function()
            if o:IsA("BasePart") then p = o.Position else p = o:GetPivot().Position end
        end)
        return p
    end

    -- 按编号建索引，去重只比对同编号的少数几个（不做全表遍历）
    ESP.labelIndex = ESP.labelIndex or {}
    local function indexAdd(label, o)
        local g = ESP.labelIndex[label]
        if not g then g = {}; ESP.labelIndex[label] = g end
        g[#g + 1] = o
    end
    local function indexDel(label, o)
        local g = ESP.labelIndex[label]
        if not g then return end
        for i = #g, 1, -1 do
            if g[i] == o then table.remove(g, i) end
        end
        if #g == 0 then ESP.labelIndex[label] = nil end
    end

    -- 同一编号、相距 < 12 studs → 视为同一个物件的多个部件，只留一个标签
    local function nearDuplicate(o, label)
        local g = ESP.labelIndex[label]
        if not g or #g == 0 then return false end
        local p = posOf(o)
        if not p then return false end
        for i = 1, #g do
            local m = g[i]
            if m ~= o and m.Parent then
                local p2 = posOf(m)
                if p2 and (p2 - p).Magnitude < 12 then return true end
            end
        end
        return false
    end

    local function addMark(o, label, src)
        -- 最后一道闸：999 / 131 / 005 不管从哪条路径来都不标
        local hn = string.match(tostring(label or ""), "SCP%-(%d%d+)")
        if hn and HIDE_NUMS[hn] then return end
        if ESP.Marked[o] then return end
        if nearDuplicate(o, label) then return end
        local bg = Instance.new("BillboardGui")
        bg.Name = "NS_BB"
        bg.Adornee = o
        bg.AlwaysOnTop = true
        bg.MaxDistance = 5000
        bg.Size = UDim2.new(0, 200, 0, 40)
        bg.StudsOffset = Vector3.new(0, 1.2, 0)
        safeParent(bg)
        local tl = Instance.new("TextLabel")
        tl.Size = UDim2.new(1, 0, 1, 0)
        tl.BackgroundTransparency = 1
        tl.TextColor3 = colorFor(label)
        tl.TextStrokeColor3 = OUTLINE
        tl.TextStrokeTransparency = 0
        tl.TextXAlignment = Enum.TextXAlignment.Center
        tl.TextYAlignment = Enum.TextYAlignment.Center
        tl.TextSize = 16
        tl.Font = HEAVY
        tl.Text = label
        tl.Parent = bg
        ESP.Marked[o] = { bg = bg, tl = tl, label = label, applied = label, src = src or "tag" }
        indexAdd(label, o)
    end

    local function delMark(o)
        local r = ESP.Marked[o]
        if not r then return end
        pcall(function() r.bg:Destroy() end)
        indexDel(r.label, o)
        ESP.Marked[o] = nil
    end

    local function isLiving(o)
        local ok, h = pcall(function() return o:FindFirstChildOfClass("Humanoid") end)
        return ok and h ~= nil
    end

    -- 统一门槛：带场景词的一律不标；非道具只接受「名字本身就是 SCP<编号>」
    local function acceptable(o, label)
        local num = string.match(tostring(label or ""), "^SCP%-(%d%d+)$")
        if num and HIDE_NUMS[num] then return false end
        local nm
        pcall(function() nm = o.Name end)
        nm = tostring(nm or "")
        if hasSceneWord(nm) then return false end
        if isPropLike(o) then return true end
        local c = compact(nm)
        local n, rest = string.match(c, "^scp(%d%d%d%d?)(.*)$")
        if not n or #rest > 3 then return false end
        return ("SCP-" .. n) == label
    end

    -- 标签来源：取该对象所有 SCP 标签里第一个有效编号
    local function trackObject(o)
        if not ESP.Enabled then return end
        if ESP.Marked[o] then return end
        local okT, isT = pcall(function() return o:IsA("Model") or o:IsA("BasePart") end)
        if not okT or not isT then return end
        if isLiving(o) then return end   -- 角色型交给主 ESP
        local tags = {}
        pcall(function() tags = CS:GetTags(o) end)
        for _, t in ipairs(tags) do
            local label = labelFromTag(t)
            if label and acceptable(o, label) then addMark(o, label); return end
        end
        local okV, v = pcall(function() return o:GetAttribute("SCP") end)
        if okV and v ~= nil then
            local lb = "SCP-" .. tostring(v)
            if acceptable(o, lb) then addMark(o, lb) end
        end
    end

    -- 收集所有含 SCP 的标签
    pcall(function()
        for _, t in ipairs(CS:GetAllTags()) do
            if string.find(string.upper(tostring(t)), "SCP", 1, true) then
                ESP.TagList[#ESP.TagList + 1] = t
            end
        end
    end)

    for _, t in ipairs(ESP.TagList) do
        for _, o in ipairs(CS:GetTagged(t)) do
            pcall(trackObject, o)
        end
    end

    for _, t in ipairs(ESP.TagList) do
        pcall(function()
            table.insert(ESP.Conns, CS:GetInstanceAddedSignal(t):Connect(function(o)
                pcall(trackObject, o)
            end))
            table.insert(ESP.Conns, CS:GetInstanceRemovedSignal(t):Connect(function(o)
                pcall(delMark, o)
            end))
        end)
    end

    -- 名字兜底：无标签、但名字里就写着 SCP-xxx 的物件（294 机器 / 458 披萨盒等）
    local function scanNames()
        local ok, desc = pcall(function() return WS:GetDescendants() end)
        if not ok or not desc then return 0 end
        local n = #desc
        if n > 15000 then n = 15000 end
        local hit = 0
        for i = 1, n do
            if i % 3000 == 0 then task.wait() end   -- 分批让帧，避免单帧长卡
            local o = desc[i]
            local okC, cls = pcall(function() return o.ClassName end)
            if okC then
                if cls == "Model" or cls == "Part" or cls == "MeshPart"
                    or cls == "UnionOperation" or cls == "Tool" then
                    if not ESP.Marked[o] then
                        local nm = o.Name
                        local ln = string.lower(nm or "")
                        if string.find(ln, "scp", 1, true)
                            or string.find(ln, "pizza", 1, true)
                            or string.find(ln, "machine", 1, true)
                            or string.find(ln, "candy", 1, true)
                            or string.find(ln, "panacea", 1, true) then
                            if not isLiving(o) then
                                local lb = labelFromName(o)
                                if lb then
                                    addMark(o, lb, "name")
                                    hit = hit + 1
                                end
                            end
                        end
                    end
                end
            end
        end
        for o in pairs(ESP.Marked) do
            if not o.Parent then delMark(o) end
        end
        ESP.Found = hit
        ESP.Status = "标签 " .. tostring(#ESP.TagList) .. " · 名字命中 " .. tostring(hit)
        return hit
    end

    -- 距离刷新：每 2 秒只遍历已标记的对象
    local distT = 0
    table.insert(ESP.Conns, RS.Heartbeat:Connect(function(dt)
        distT = distT + dt
        if distT < 2 then return end
        distT = 0
        if not ESP.Enabled then return end
        local cam = WS.CurrentCamera
        if not cam then return end
        local cp = cam.CFrame.Position
        for o, r in pairs(ESP.Marked) do
            if not o.Parent then
                delMark(o)
            else
                local pos
                pcall(function()
                    if o:IsA("BasePart") then pos = o.Position else pos = o:GetPivot().Position end
                end)
                if pos then
                    local d = (cp - pos).Magnitude
                    if d > ESP.MaxDist then
                        r.bg.Enabled = false
                    else
                        r.bg.Enabled = true
                        local txt = r.label .. " " .. math.floor(d) .. "m"
                        if r.applied ~= txt then r.applied = txt; r.tl.Text = txt end
                    end
                end
            end
        end
    end))

    task.spawn(function()
        while Gg.NEWSCP_ESP == ESP do
            if ESP.Enabled and ESP.NameFallback then pcall(scanNames) end
            task.wait(ESP.ScanInterval)
        end
    end)

    ESP.On = function()
        ESP.Enabled = true
        for _, t in ipairs(ESP.TagList) do
            for _, o in ipairs(CS:GetTagged(t)) do pcall(trackObject, o) end
        end
        task.defer(function() pcall(scanNames) end)
        return true
    end
    ESP.Off = function()
        ESP.Enabled = false
        for o in pairs(ESP.Marked) do delMark(o) end
        ESP.Marked = {}
        ESP.labelIndex = {}
        ESP.Status = "已关闭"
        return false
    end
    ESP.SetRange = function(m)
        if type(m) == "number" and m > 0 then ESP.MaxDist = m end
        return ESP.MaxDist
    end
    ESP.SetNameFallback = function(v)
        ESP.NameFallback = v and true or false
        if not ESP.NameFallback then
            for o, r in pairs(ESP.Marked) do
                if r.src == "name" then delMark(o) end
            end
        else
            task.defer(function() pcall(scanNames) end)
        end
        return ESP.NameFallback
    end
    ESP.Dump = function()
        local t = {}
        for _, r in pairs(ESP.Marked) do t[#t + 1] = r.applied end
        table.sort(t)
        return "NEWSCP Enabled=" .. tostring(ESP.Enabled) .. " Range=" .. tostring(ESP.MaxDist)
            .. " Tracked=" .. tostring(#t) .. " Tags=" .. tostring(#ESP.TagList)
            .. " Fallback=" .. tostring(ESP.NameFallback) .. " -> " .. table.concat(t, ", ")
    end

    print("[ESP] 新SCP透视 NEWSCP_ESP v3 已内嵌装载 · " .. ESP.Dump())
end

