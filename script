    local function effectText(drink)
        local notice = tostring(drink.Notice or "")
        local eff = (type(drink.Effect) == "table") and drink.Effect or {}
        local n = nil
        for _, k in ipairs({ "Heal", "Damage", "FullHeal" }) do
            if type(eff[k]) == "number" then n = eff[k]; break end
        end
        if n then notice = string.gsub(notice, "%%d", tostring(math.floor(n))) end
        local CN = {
            Heal="回血", FullHeal="回满血", Damage="扣血", Speed="加速", Slow="减速",
            Freeze="定身", Meter="感染度变化", Escape="逃脱指引", Stamina="回体力",
            Regen="持续回血", NoBlink="防眨眼", Light="发光", Silence="静步",
            Dot="持续掉血", Crash="高速后副作用", Knockdown="击倒", Emote="趣味动作",
        }
        local parts = {}
        for k, _ in pairs(eff) do if CN[k] then parts[#parts+1] = CN[k] end end
        table.sort(parts)
        if type(drink.Screen) == "table" and drink.Screen[1] then parts[#parts+1] = "视觉:"..tostring(drink.Screen[1]) end
        if type(drink.Look) == "table" and drink.Look[1] then parts[#parts+1] = "外观:"..tostring(drink.Look[1]) end
        local hasNotice = notice ~= "" and notice ~= "???" and notice ~= "nil"
        local extra = #parts > 0 and table.concat(parts, "/") or ""
        if hasNotice then
            return notice .. (#parts > 0 and ("  [" .. extra .. "]") or "")
        end
        -- 无文案：用中文/视觉注解作为主说明；都没有则给通用提示
        return extra ~= "" and extra or "特殊效果（游戏内生效）"
    end

    local function lookup(token)
        if not T or type(T.ById) ~= "table" or not token then return nil end
        local d = T.ById[token]
        if d then return d, token end
        local lt = string.lower(tostring(token))
        for id, v in pairs(T.ById) do
            if string.lower(tostring(id)) == lt then return v, id end
        end
        return nil
    end

