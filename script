    local function checkCup(tool)
        if not tool or tool.ClassName ~= "Tool" then return end
        local okTag = pcall(function() return CS:HasTag(tool, D.CupTag) end)
        if not okTag or not CS:HasTag(tool, D.CupTag) then return end
        -- 真实杯子：DrinkId=饮料表键(如 EnergyDrink)，DrinkToken=服务器验证 UUID(不查表)
