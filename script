-- ============================================================
-- 【内嵌】SCP-610 感染防护 + 新SCP透视（原独立脚本整合）
-- 防护：感染度属性 SCP610Infection 一出现就清零；自身 SCP610Host 标签立即移除
-- 透视：只画 610 宿主/感染体 + SCP610_Mother 核心；排除 999/131/106；500m 范围
--       普通 SCP 一律交给主 ESP，避免同一只 SCP 出现两套标签（v16.4）
-- 联动：受主界面「SCP透视」总开关控制（轮询 SCPEnabled，不包装主函数）
-- API：G.SCP610_DEF.{On,Off,SetESP,SetAnti,SetRange,Dump}
-- ============================================================
do
    local Gg = getgenv()
    pcall(function()
        local old = Gg.SCP610_DEF
        if old then
            if old.Off then pcall(old.Off) end
            if old.Conns then for _, c in ipairs(old.Conns) do pcall(function() c:Disconnect() end) end end
        end
    end)

    local WS      = workspace
    local CS      = game:GetService("CollectionService")
    local RS      = game:GetService("RunService")
    local Players = game:GetService("Players")
    local LP      = Players.LocalPlayer

    local D = {
        Enabled = true, AntiInfect = true, RemoveHost = true, ShowDanger = true,
        MeterName = "SCP610Infection", HostTag = "SCP610Host",
        DangerRadius = 22, Range = 500,
        Marks = {}, Conns = {}, ClampCount = 0, HostRemoveCount = 0,
    }
    Gg.SCP610_DEF = D

    local HEAVY = Enum.Font.GothamBold
    pcall(function() HEAVY = Enum.Font.GothamBlack end)
    local OUTLINE = Color3.new(0, 0, 0)

    local EXCLUDE = { ["999"] = true, ["131"] = true, ["106"] = true, ["005"] = true }
    local SKIP_SUFFIX = { "Cup", "FeedScreen", "Passable", "Sinkhole", "Feed", "Screen",
                          "Dragon", "Follower", "Cable", "Conduit", "Wire" }
    local DEAD_KW = { "corpse", "ragdoll", "dead", "remains", "oldbody", "debris" }

    local function compact(s) return string.gsub(string.lower(tostring(s or "")), "[-_%s]", "") end

    local function labelFromTag(tag)
        local c = compact(tag)
        for _, sf in ipairs(SKIP_SUFFIX) do if c:find(compact(sf), 1, true) then return nil end end
        for _, w in ipairs(DEAD_KW) do if c:find(w, 1, true) then return nil end end
        local n = string.match(c, "scp(%d+)")
        if not n or #n > 4 then return nil end
        if EXCLUDE[n] then return nil end
        return "SCP-" .. n, n
    end

    local DANGER = {
        ["049"]=true, ["096"]=true, ["106"]=true, ["173"]=true, ["303"]=true,
        ["610"]=true, ["650"]=true, ["682"]=true, ["939"]=true, ["035"]=true,
        ["1762"]=true, ["6161"]=true, ["079"]=true,
    }
    local function colorFor(n)
        if DANGER[n] then return Color3.fromRGB(255, 40, 40) end
        local v = tonumber(n) or 0
        local pal = { Color3.fromRGB(255,170,70), Color3.fromRGB(120,210,255),
                      Color3.fromRGB(190,130,255), Color3.fromRGB(130,255,170) }
        return pal[(v % #pal) + 1]
    end

    local function safeParent(inst)
        local ok = pcall(function() inst.Parent = game:GetService("CoreGui") end)
        if not ok then pcall(function() inst.Parent = WS end) end
    end

    local function addMark(o, label, n, danger)
        if D.Marks[o] then return end
        local bg = Instance.new("BillboardGui")
        bg.Name = "DF_BB"
        bg.Adornee = o
        bg.AlwaysOnTop = true
        bg.MaxDistance = 5000
        bg.Size = UDim2.new(0, 200, 0, 40)
        bg.StudsOffset = Vector3.new(0, 1.2, 0)
        safeParent(bg)
        local tl = Instance.new("TextLabel")
        tl.Size = UDim2.new(1, 0, 1, 0)
        tl.BackgroundTransparency = 1
        tl.TextColor3 = colorFor(n)
        tl.TextStrokeColor3 = OUTLINE
        tl.TextStrokeTransparency = 0
        tl.TextXAlignment = Enum.TextXAlignment.Center
        tl.TextYAlignment = Enum.TextYAlignment.Center
        tl.TextSize = 16
        tl.Font = HEAVY
        tl.Text = label
        tl.Parent = bg
        D.Marks[o] = { bg = bg, tl = tl, label = label, danger = danger, applied = tl.Text }
    end

    local function delMark(o)
        local r = D.Marks[o]
        if not r then return end
        pcall(function() r.bg:Destroy() end)
        D.Marks[o] = nil
    end

    local function isDanger(o)
        local ok, tags = pcall(function() return CS:GetTags(o) end)
        if ok then
            for _, t in ipairs(tags) do
                local lt = t:lower()
                if lt == "scp610host" or (lt:find("610") and (lt:find("infected") or lt:find("host"))) then
                    return true
                end
            end
        end
        return false
    end

    local function trackObject(o)
        if not D.ShowDanger then return end
        if not (o:IsA("Model") or o:IsA("BasePart")) then return end
        if o.Name == "SCP610_Mother" then
            addMark(o, "SCP-610 核心", "610", true) return
        end
        local okPl, pl = pcall(function() return Players:GetPlayerFromCharacter(o) end)
        if okPl and pl then return end
        if isDanger(o) then addMark(o, "SCP-610 [感染源]", "610", true) return end
        if o:FindFirstChildOfClass("Humanoid") then return end
        local ok, tags = pcall(function() return CS:GetTags(o) end)
        if ok then
            for _, t in ipairs(tags) do
                local label, n = labelFromTag(t)
                if label then addMark(o, label, n, false) return end
            end
        end
    end

    -- 【v16.4 修复·同一 SCP 两条透视】
    -- 根因：这里原来把所有含 "SCP" 的 CollectionService 标签都收进来，
    --   于是 SCP-4033/4035 这类普通 SCP 被本模块按标签画一条，
    --   主 ESP 又画一条 → 屏幕上同一只 SCP 出现两套标签（距离差几米，
    --   因为本模块用 part.Position、主 ESP 用 GetBoundingBox 中心）。
    -- 本模块职责只有 610：只收含 "610" 的标签，其余交给主 ESP。
    local tagList = {}
    for _, t in ipairs(CS:GetAllTags()) do
        local u = string.upper(t)
        if string.find(u, "610", 1, true) then tagList[#tagList + 1] = t end
    end
    for _, t in ipairs(tagList) do
        for _, o in ipairs(CS:GetTagged(t)) do trackObject(o) end
        table.insert(D.Conns, CS:GetInstanceAddedSignal(t):Connect(function(o) trackObject(o) end))
        table.insert(D.Conns, CS:GetInstanceRemovedSignal(t):Connect(function(o) delMark(o) end))
    end

    local function findMother()
        local ok, m = pcall(function()
            local w = WS:FindFirstChild("SCP610World")
            return w and w:FindFirstChild("SCP610_Mother") or nil
        end)
        if ok and m then trackObject(m) end
    end
    findMother()
    table.insert(D.Conns, WS.DescendantAdded:Connect(function(o)
        if o.Name == "SCP610_Mother" then task.defer(findMother) end
    end))

    local function protectChar(ch)
        if not ch or ch ~= (LP and LP.Character) then return end
        if D.AntiInfect then
            pcall(function()
                if ch:GetAttribute(D.MeterName) ~= nil then
                    ch:SetAttribute(D.MeterName, 0)
                    D.ClampCount = D.ClampCount + 1
                end
            end)
            table.insert(D.Conns, ch:GetAttributeChangedSignal(D.MeterName):Connect(function()
                if not D.Enabled or not D.AntiInfect then return end
                pcall(function()
                    local v = ch:GetAttribute(D.MeterName)
                    if type(v) == "number" and v > 0 then
                        ch:SetAttribute(D.MeterName, 0)
                        D.ClampCount = D.ClampCount + 1
                    end
                end)
            end))
        end
        if D.RemoveHost then
            pcall(function()
                if CS:HasTag(ch, D.HostTag) then
                    CS:RemoveTag(ch, D.HostTag)
                    D.HostRemoveCount = D.HostRemoveCount + 1
                end
            end)
            table.insert(D.Conns, CS:GetInstanceAddedSignal(D.HostTag):Connect(function(obj)
                if not D.Enabled or not D.RemoveHost then return end
                if obj == (LP and LP.Character) then
                    pcall(function()
                        CS:RemoveTag(obj, D.HostTag)
                        D.HostRemoveCount = D.HostRemoveCount + 1
                    end)
                end
            end))
        end
    end
    if LP then
        table.insert(D.Conns, LP.CharacterAdded:Connect(function(ch) task.defer(protectChar, ch) end))
        if LP.Character then task.defer(protectChar, LP.Character) end
    end

    local tick = 0
    table.insert(D.Conns, RS.Heartbeat:Connect(function(dt)
        tick = tick + dt
        if tick < 0.5 then return end
        tick = 0
        if not D.Enabled then return end
        if D.ShowDanger then findMother() end
        local ch = LP and LP.Character
        if D.AntiInfect and ch then
            pcall(function()
                local v = ch:GetAttribute(D.MeterName)
                if type(v) == "number" and v > 0 then
                    ch:SetAttribute(D.MeterName, 0)
                    D.ClampCount = D.ClampCount + 1
                end
            end)
        end
        if D.RemoveHost and ch then
            pcall(function()
                if CS:HasTag(ch, D.HostTag) then CS:RemoveTag(ch, D.HostTag); D.HostRemoveCount = D.HostRemoveCount + 1 end
            end)
        end
        local cam = WS.CurrentCamera
        if not cam then return end
        local cp = cam.CFrame.Position
        -- 主 ESP 已经画了这个对象时，本模块不再重复画（跨模块去重兜底）
        local E = Gg.CRATE_ESP
        for o, r in pairs(D.Marks) do
            if not o.Parent then
                delMark(o)
            else
                local pos
                pcall(function()
                    if o:IsA("BasePart") then pos = o.Position else pos = o:GetPivot().Position end
                end)
                if pos then
                    local d = (cp - pos).Magnitude
                    local dup = E and E.Marks and (E.Marks[o] ~= nil)
                    if dup or d > D.Range then r.bg.Enabled = false
                    else
                        r.bg.Enabled = true
                        local txt = r.label .. " " .. math.floor(d) .. "m"
                        if r.applied ~= txt then r.applied = txt; r.tl.Text = txt end
                    end
                end
            end
        end
    end))

    D.On = function()
        D.Enabled = true
        local ch = LP and LP.Character
        if ch then task.defer(protectChar, ch) end
        for _, t in ipairs(tagList) do
            for _, o in ipairs(CS:GetTagged(t)) do trackObject(o) end
        end
        findMother()
    end
    D.Off = function()
        D.Enabled = false
        for o, _ in pairs(D.Marks) do delMark(o) end
    end
    D.SetESP = function(v)
        v = v and true or false
        D.ShowDanger = v
        if v then
            for _, t in ipairs(tagList) do
                for _, o in ipairs(CS:GetTagged(t)) do trackObject(o) end
            end
            findMother()
        else
            for o in pairs(D.Marks) do delMark(o) end
        end
        return D.ShowDanger
    end
    D.SetAnti = function(v) D.AntiInfect = v and true or false; return D.AntiInfect end
    D.SetRange = function(m) if type(m) == "number" and m > 0 then D.Range = m end; return D.Range end
    D.Dump = function()
        local t = {}
        for _, r in pairs(D.Marks) do t[#t + 1] = r.applied end
        table.sort(t)
        local meter = "nil"
        pcall(function() local ch=LP.Character; meter = ch and tostring(ch:GetAttribute(D.MeterName)) or "nochar" end)
        return string.format("DEF Enabled=%s Anti=%s Host=%s Range=%d Clamp=%d HostRem=%d Meter=%s Tracked=%d -> %s",
            tostring(D.Enabled), tostring(D.AntiInfect), tostring(D.RemoveHost), D.Range, D.ClampCount, D.HostRemoveCount,
            meter, #t, table.concat(t, ", "))
    end

    -- 联动主界面「SCP透视」总开关（轮询 SCPEnabled，零包装）
    local lastMaster = nil
    local function syncAll(v)
        v = v and true or false
        pcall(function() D.SetESP(v) end)
        pcall(function()
            local N = Gg.NEWSCP_ESP
            if N then if v then if N.On then N.On() end else if N.Off then N.Off() end end end
        end)
    end
    table.insert(D.Conns, RS.Heartbeat:Connect(function()
        if not D.Enabled then return end
        local E = Gg.CRATE_ESP
        if not E then return end
        local cur = E.SCPEnabled ~= false
        if lastMaster == nil then lastMaster = cur end
        if cur ~= lastMaster then
            lastMaster = cur
            syncAll(cur)
        end
    end))
    do
        local E = Gg.CRATE_ESP
        if E then lastMaster = E.SCPEnabled ~= false; syncAll(lastMaster) end
    end

    print("[ESP] SCP610 防护+透视 已内嵌装载 · " .. D.Dump())
end

