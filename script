    -- 重注入清扫：上一版脚本的循环已停，但 Highlight / 标签还挂在模型上（这正是
    -- 「新版本明明过滤了 999/131，游戏里还看得见」的常见原因）。启动 2 秒后跑一次，
    -- 只删不属于当前实例的旧标签，不影响本次新建的。
    task.delay(2, function()
        pcall(function()
            local keep = {}
            for _, rec in pairs(ESP.Marks) do
                if rec.hl then keep[rec.hl] = true end
                if rec.bg then keep[rec.bg] = true end
            end
            local N = G.NEWSCP_ESP
            if N and N.Marked then
                for _, rec in pairs(N.Marked) do if rec.bg then keep[rec.bg] = true end end
            end
            local W = G.WATER_ESP
            if W and W.Marks then
                for _, rec in pairs(W.Marks) do if rec.bg then keep[rec.bg] = true end end
            end
            local killed = 0
            local function sweep(root)
                local ok, desc = pcall(function() return root:GetDescendants() end)
                if not ok or not desc then return end
                for i = 1, #desc do
                    local obj = desc[i]
                    local n = obj.Name
                    if (n == "MCP_ESP_HL" or n == "MCP_ESP_BG"
                        or n == "NS_BB" or n == "WATER_BB") and not keep[obj] then
                        pcall(function() obj:Destroy() end)
                        killed = killed + 1
                    end
                end
            end
            sweep(WS)
            pcall(function() sweep(game:GetService("CoreGui")) end)
            if killed > 0 then print("[ESP] 已清理上一版残留标签 " .. killed .. " 个") end
        end)
    end)
    local CSvc = game:GetService("CollectionService")

    local function isMine(m)
        if m == (P and P.Character) then return true end
        local ok, pl = pcall(function() return PlayersSvc:GetPlayerFromCharacter(m) end)
        return ok and pl == P
    end

    -- 旁观者判定：队伍 / 玩家属性 / 角色所在容器
    local function isSpectator(pl, ch)
        if not pl then return false end
        -- 本游戏旁观者：角色带 "Ghost" 标签（Class=nil）→ 直接判定为旁观者
        local okG, isGhost = pcall(isGhostSpec, pl)
        if okG and isGhost then return true end
        local okT, team = pcall(function() return pl.Team end)
        if okT and team then
            local n = string.lower(tostring(team.Name))
            if string.find(n, "spectat", 1, true) or string.find(n, "旁观", 1, true)
                or string.find(n, "观众", 1, true) or string.find(n, "lobby", 1, true)
                or string.find(n, "dead", 1, true) then return true end
        end
        for _, k in ipairs({ "Spectating", "IsSpectator", "Spectator", "Dead", "IsDead", "Alive", "Role", "Class", "Team", "Status" }) do
            local ok, v = pcall(function() return pl:GetAttribute(k) end)
            if ok and v ~= nil then
                if k == "Alive" then
                    if v == false then return true end
                else
                    local sv = string.lower(tostring(v))
                    if string.find(sv, "spectat", 1, true) or string.find(sv, "旁观", 1, true)
                        or string.find(sv, "观众", 1, true) or sv == "dead" or sv == "lobby" then return true end
                end
            end
        end
        if ch then
            local anc = ch.Parent
            while anc and anc ~= WS do
                local n = string.lower(anc.Name)
                if string.find(n, "spectat", 1, true) or string.find(n, "lobby", 1, true)
                    or string.find(n, "dead", 1, true) then return true end
                anc = anc.Parent
            end
        end
        return false
    end

    local function isDeadBody(m)
        local hum = m:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health <= 0 then return true end
        for _, k in ipairs({ "Dead", "IsDead", "IsCorpse", "Corpse" }) do
            local ok, v = pcall(function() return m:GetAttribute(k) end)
            if ok and v == true then return true end
        end
        local n = string.lower(m.Name)
        if string.find(n, "corpse", 1, true) or string.find(n, "dead", 1, true)
            or string.find(n, "ragdoll", 1, true) then return true end
        return false
    end

    -- 【v16.3 修复】物资箱透视只标「真正能打开」的箱子，不再把装饰箱/假箱画进来。
    --   MCP 真机实证（Workspace.Map 里全部含 crate 的 Model）：
    --     · 能打开（有 ProximityPrompt，ActionText="Open", ObjectText="Supply Crate"）：
    --         BedCrate1-4 (bunkercrate) / DeadEndCrate (bunkercrate)
    --     · 不能打开（完全没有 ProximityPrompt）——之前被错误透视：
    --         Crate(crate) / Bunker_Crate / Bunker_CrateStack / Bunker_MilCrate /
    --         SCP005_PadlockCrate  —— 全是 pp0 的静态装饰箱。
    --     · 另外「门」Plug_Door 也是 ActionText="Open"，但 ObjectText="Door"，必须排除。
    --     · 供电管线 SupplyCable/SupplyConduit 名字含 supply 无 PP，也须排除。
    --   故判据 = 名字含 crate 词根 AND 有「打开物资箱」的 ProximityPrompt。
    local function crateKind(m)
        if not m:IsA("Model") then return nil end
        local nm = string.lower(m.Name)
        local prop = string.lower(tostring(m:GetAttribute("Prop") or ""))
        -- 必须是箱子词根（排除 SupplyCable/电线、门等非箱）
        local isCrateName = string.find(prop, "crate", 1, true)
            or string.find(nm, "crate", 1, true)
        if not isCrateName then return nil end
        if string.find(nm, "cable", 1, true)
            or string.find(nm, "conduit", 1, true)
            or string.find(nm, "wire", 1, true) then return nil end
        -- 核心：必须有「能打开」的 ProximityPrompt 才算物资箱。
        -- 判据：ObjectText 含 crate/supply（如 "Supply Crate"），或
        --       ActionText=Open 且名字/Prop 含 crate（双重条件，排除门的 "Open/Door"）。
        local ok = false
        pcall(function()
            for _, x in ipairs(m:GetDescendants()) do
                if x:IsA("ProximityPrompt") then
                    local obj = string.lower(tostring(x.ObjectText or ""))
                    local act = string.lower(tostring(x.ActionText or ""))
                    local opens = string.find(act, "open", 1, true)
                        or string.find(act, "search", 1, true)
                        or string.find(act, "loot", 1, true)
                    if (string.find(obj, "crate", 1, true) or string.find(obj, "supply", 1, true))
                       or (opens and isCrateName) then
                        ok = true
                        break
                    end
                end
            end
        end)
        return ok and "crate" or nil
    end
    local function gunLabel(m)
        for _, d in ipairs(m:GetDescendants()) do
            if d:IsA("ProximityPrompt")
                and string.find(string.lower(tostring(d.ActionText)), "pick", 1, true) then
                local ot = tostring(d.ObjectText)
                if ot ~= "" and ot ~= "nil" then return ot end
            end
        end
        local gt, r = m:GetAttribute("GunType"), m:GetAttribute("Rounds")
        if gt then return tostring(gt) .. (r and (" (" .. tostring(r) .. " 发)") or "") end
        return "掉落枪械"
    end

    local function destroy(m, rec)
        pcall(function() rec.hl:Destroy() end)
        pcall(function() rec.bg:Destroy() end)
        ESP.Marks[m] = nil
    end

    -- 标记类别 → 对应开关字段
    local KIND_FLAG = {
        scp = "SCPEnabled", player = "PlayerEnabled",
        crate = "CrateEnabled", gun = "GunEnabled",
    }

    -- 立刻停用：销毁「对应开关已关」或「总开关已关」的所有标记。
    -- 先收集再删，避免遍历中改表；全关时再按实例名兜底清扫，
    -- 连 pcall 半途失败、没登记进 Marks 的孤儿 ESP 实例也一并清掉。
    local lastSweep = 0
    local function clearDisabled(skipSweep)
        local kill = {}
        for m, rec in pairs(ESP.Marks) do
            local flag = KIND_FLAG[rec.kind]
            -- 真人操控的 SCP 兼具「SCP + 玩家」双重身份：
            -- 两个开关任一开启就保留，避免只开其中一个时被误清掉。
            local keep
            if rec.isPlayerSCP then
                keep = ESP.SCPEnabled or ESP.PlayerEnabled
            else
                keep = flag and ESP[flag]
            end
            if not ESP.Enabled or not keep then
                kill[#kill + 1] = m
            end
        end
        for _, m in ipairs(kill) do
            local rec = ESP.Marks[m]
            if rec then destroy(m, rec) end
        end
        -- 全关时按实例名兜底清扫孤儿；加 1s 节流，避免连续切开关反复全量遍历
        if not ESP.Enabled and not skipSweep then
            local now = os.clock()
            if now - lastSweep >= 1 then
                lastSweep = now
                pcall(function()
                    for _, obj in ipairs(WS:GetDescendants()) do
                        if obj.Name == "MCP_ESP_HL" or obj.Name == "MCP_ESP_BG" then
                            pcall(function() obj:Destroy() end)
                        end
                    end
                end)
            end
        end
    end

    local function hostPart(m)
        if m:IsA("BasePart") then return m end
        local hrp = m:FindFirstChild("HumanoidRootPart")
        if hrp and hrp:IsA("BasePart") then return hrp end
        if m:IsA("Model") and m.PrimaryPart then return m.PrimaryPart end
        for _, d in ipairs(m:GetDescendants()) do
            if d:IsA("BasePart") then return d end
        end
        if m:IsA("Model") then return m end
        return nil
    end

    -- 颜色规则：SCP=红，玩家=绿，武器=青，箱子=绿
    local function colorFor(kind, label)
        if kind == "scp" then return RED end
        if kind == "player" then return GREEN end
        if kind == "gun" then return GUNC end
        return CRATEC
    end

    local function addChams(m, kind, label)
        local okPl, pl = pcall(function() return PlayersSvc:GetPlayerFromCharacter(m) end)
        local realPl = okPl and pl or nil
        local player = (kind == "player") and realPl or nil
        -- 【修复】被标为 SCP、但确实由玩家操控 → 真人操控 SCP。
        -- 无论从哪条路径 add 进来都会自动打标，不会遗漏。
        local isPlayerSCP = (kind == "scp") and (realPl ~= nil)
        local hum = m:FindFirstChildOfClass("Humanoid")
        local head = m:FindFirstChild("Head")
        local hrp = m:FindFirstChild("HumanoidRootPart")
        local adorn = (head and head:IsA("BasePart")) and head or hrp or hostPart(m)
        if not adorn then return end

        local col = colorFor(kind, label)

        local hl = Instance.new("Highlight")
        hl.Name = "MCP_ESP_HL"
        hl.Adornee = m
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.FillTransparency = 0.35
        hl.OutlineTransparency = 0.05
        hl.FillColor = col
        hl.OutlineColor = col
        hl.Parent = m

        local bg = Instance.new("BillboardGui")
        bg.Name = "MCP_ESP_BG"
        bg.Adornee = adorn
        bg.AlwaysOnTop = true
        bg.MaxDistance = 5000
        bg.Size = UDim2.new(0, 200, 0, 40)
        bg.StudsOffset = Vector3.new(0, 1.2, 0)
        bg.Parent = adorn

        local nameLbl = Instance.new("TextLabel", bg)
        nameLbl.Size = UDim2.new(1, 0, 0.6, 0)
        nameLbl.BackgroundTransparency = 1
        nameLbl.TextColor3 = col
        nameLbl.TextStrokeTransparency = 0
        nameLbl.TextStrokeColor3 = OUTLINE
        nameLbl.TextSize = 16
        nameLbl.Font = HEAVY
        nameLbl.Text = label or "?"

        local hpText = Instance.new("TextLabel", bg)
        hpText.Size = UDim2.new(1, 0, 0.4, 0)
        hpText.Position = UDim2.new(0, 0, 0.6, 0)
        hpText.BackgroundTransparency = 1
        hpText.TextColor3 = Color3.new(1, 1, 1)
        hpText.TextStrokeTransparency = 0
        hpText.TextStrokeColor3 = OUTLINE
        hpText.TextSize = 13
        hpText.Font = HEAVY
        hpText.Visible = hum ~= nil

        ESP.Marks[m] = {
            hl = hl, bg = bg, tl = nameLbl, hpText = hpText,
            host = adorn, kind = kind, label = label, col = col,
            player = player, model = m, hum = hum, isPlayerSCP = isPlayerSCP,
            ownerName = realPl and realPl.Name or nil,   -- 真实操控者用户名
            appliedCol = nil, appliedText = nil, grad = math.random() * 2,
        }
    end

    local function add(m, kind, label)
        if ESP.Marks[m] or not m.Parent then return end
        if kind == "player" or kind == "scp" then
            addChams(m, kind, label)
            return
        end
        pcall(function()
            local host = hostPart(m)
            if not host then return end
            local isGun = kind == "gun"
            local col = colorFor(kind, label)

            local hl = Instance.new("Highlight")
            hl.Name = "MCP_ESP_HL"
            hl.Adornee = m
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.FillTransparency = 0.35
            hl.OutlineTransparency = 0.05
            hl.FillColor = col
            hl.OutlineColor = col
            hl.Parent = m

            local bg = Instance.new("BillboardGui")
            bg.Name = "MCP_ESP_BG"
            bg.Adornee = host
            bg.AlwaysOnTop = true
            bg.MaxDistance = 5000
            bg.Size = UDim2.new(0, 200, 0, 40)
            bg.StudsOffset = Vector3.new(0, isGun and 1.8 or 2.6, 0)
            bg.Parent = host
            local tl = Instance.new("TextLabel", bg)
            tl.Size = UDim2.new(1, 0, 1, 0)
            tl.BackgroundTransparency = 1
            tl.TextStrokeTransparency = 0
            tl.TextStrokeColor3 = OUTLINE
            tl.Font = HEAVY
            tl.TextXAlignment = Enum.TextXAlignment.Center
            tl.TextYAlignment = Enum.TextYAlignment.Center
            tl.TextSize = 18
            tl.TextColor3 = col
            tl.Text = label or "补给箱"

            ESP.Marks[m] = {
                hl = hl, bg = bg, tl = tl, host = host, kind = kind,
                label = label, col = col,
            }
        end)
    end

    local function refreshChams(m, rec, slow)
        if rec.kind == "player" and rec.player and isSpectator(rec.player, m) then
            destroy(m, rec) return
        end
        -- 999 / 131 / 005 即使被判成「玩家」也不画（慢检顺带清掉旧标签）
        if slow and rec.kind == "player" and hiddenSCP(m) then
            destroy(m, rec) return
        end
        if slow and rec.kind == "scp" then
            -- 残留壳 / 尸体：直接销毁，不走 3 次 miss 计数（约 4.5s 延迟）
            if isInactiveBody(m) then destroy(m, rec) return end
            -- 035 换宿主后旧身体可能 Humanoid 还活着，但已无玩家操控
            if rec.isPlayerSCP then
                local okPl, owner = pcall(function() return PlayersSvc:GetPlayerFromCharacter(m) end)
                if not (okPl and owner) then destroy(m, rec) return end
            end
            local label = classifyForESP(m)
            if label then
                rec.miss = 0
                rec.label = label
            else
                rec.miss = (rec.miss or 0) + 1
                if rec.miss >= 3 then destroy(m, rec) return end
            end
        end

        local txt = rec.label or "?"
        local col = colorFor(rec.kind, rec.label)
        -- 暴乱模式：玩家按队伍上色（Guard系蓝 / ClassD黄），中立不变
        if isRiotMode() then
            local tp = rec.player or (rec.model and PlayersSvc:GetPlayerFromCharacter(rec.model))
            if tp then
                local tm = teamOfPlayer(tp)
                if tm == "G" then col = RBLUE
                elseif tm == "D" then col = RYELLOW end
            end
        end
        -- 真人操控的 SCP：SCP-编号 + 真实操控者用户名
        -- 旧版把操控者名字写死成问号占位符 → 玩家看到一堆问号，编号也被吞掉。
        if rec.kind == "scp" and (rec.isPlayerSCP or m:GetAttribute("Controller") == "Player") then
            local owner = rec.ownerName
            if not owner then
                local okO, o = pcall(function()
                    local pl = PlayersSvc:GetPlayerFromCharacter(m)
                    return pl and pl.Name or nil
                end)
                if okO and o then owner = o; rec.ownerName = o end
            end
            local base = rec.label or "SCP-???"
            if base == "SCP" then base = "SCP-???" end
            -- ASCII 直引号：避免部分字体把中文弯引号渲染成问号
            txt = base .. ' ["' .. (owner or "?") .. '"操控]'
        end

        local cam = WS.CurrentCamera
        local pos
        if rec.host:IsA("BasePart") then pos = rec.host.Position
        elseif rec.host:IsA("Model") then
            local ok, cf = pcall(function() return rec.host:GetBoundingBox() end)
            pos = ok and cf and cf.Position or nil
        end
        local d = (cam and pos) and math.floor((cam.CFrame.Position - pos).Magnitude) or -1
        local newText = d >= 0 and (txt .. " " .. d .. "m") or txt
        if rec.appliedText ~= newText then
            rec.appliedText = newText
            rec.tl.Text = newText
        end

        if rec.appliedCol ~= col then
            rec.appliedCol = col
            rec.tl.TextColor3 = col
            rec.tl.TextStrokeColor3 = OUTLINE
            rec.hl.FillColor = col
            rec.hl.OutlineColor = col
        end

        if rec.hpText then
            rec.hpText.Visible = rec.hum ~= nil
            if rec.hum then
                local ok, hp, maxhp = pcall(function() return rec.hum.Health, rec.hum.MaxHealth end)
                if ok and maxhp and maxhp > 0 then
                    local hs = math.floor(hp) .. " / " .. math.floor(maxhp)
                    if rec.appliedHP ~= hs then
                        rec.appliedHP = hs
                        rec.hpText.Text = hs
                    end
                end
            end
        end
    end

    local function refresh(m, rec, slow)
        if not m.Parent then destroy(m, rec) return end
        -- 【修复】035 宿主死亡 / 身体失效，下一帧就移除标记。
        -- rec.hum 是缓存引用，可能已被销毁 → 包 pcall，读不到也视为失效。
        if rec.kind == "scp" and rec.hum then
            local okHp, hp = pcall(function() return rec.hum.Health end)
            if not okHp or (hp and hp <= 0) then destroy(m, rec) return end
        end
        if rec.kind == "scp" and (ESP.HuntMode or isMine(m)) then
            destroy(m, rec) return
        end
        if rec.kind == "player" or rec.kind == "scp" then
            refreshChams(m, rec, slow)
            return
        end

        local txt = rec.label or "补给箱"
        local col = colorFor(rec.kind, rec.label)
        local cam = WS.CurrentCamera
        local pos
        if rec.host:IsA("BasePart") then pos = rec.host.Position
        elseif rec.host:IsA("Model") then
            local ok, cf = pcall(function() return (rec.host:GetBoundingBox()) end)
            pos = ok and cf and cf.Position or nil
        end
        local d = (cam and pos) and math.floor((cam.CFrame.Position - pos).Magnitude) or -1
        local newText = d >= 0 and (txt .. " " .. d .. "m") or txt
        if rec.appliedText ~= newText then
            rec.appliedText = newText
            rec.tl.Text = newText
        end
        if rec.appliedCol ~= col then
            rec.appliedCol = col
            rec.tl.TextColor3 = col
            rec.tl.TextStrokeColor3 = OUTLINE
            rec.hl.FillColor = col
            rec.hl.OutlineColor = col
        end
    end

    local function fullScan()
        pcall(function()
            ESP.HuntMode = isLocalSCP()
            local hunt, myChar = ESP.HuntMode, P and P.Character
            for _, d in ipairs(WS:GetDescendants()) do
                if d:IsA("Model") and d ~= myChar and not ESP.Marks[d] then
                    if ESP.CrateEnabled then
                        if crateKind(d) == "crate" then add(d, "crate") end
                    end
                    if ESP.SCPEnabled and not hunt and not isMine(d) then
                        local label = classifyForESP(d)
                        if label then add(d, "scp", label) end
                    end
                end
            end
            if ESP.GunEnabled then
                local dg = WS:FindFirstChild("DroppedGuns")
                if dg then
                    for _, m in ipairs(dg:GetChildren()) do
                        if m:IsA("BasePart") or m:IsA("Model") then
                            add(m, "gun", gunLabel(m))
                        end
                    end
                end
            end
            -- 【修复】玩家角色先过一次 SCP 分类：真人操控的 SCP 要标红，
            -- 不能无条件当成人类玩家（这正是「玩家扮演 SCP 被显示为玩家」的根因）。
            if ESP.PlayerEnabled or ESP.SCPEnabled then
                for _, pl in ipairs(PlayersSvc:GetPlayers()) do
                    if pl ~= P then
                        local ch = pl.Character
                        if ch and ch ~= myChar and not isMine(ch) and not ESP.Marks[ch]
                            and not isSpectator(pl, ch) and not isInactiveBody(ch) then
                            local sl = classifyForESP(ch)
                            if sl then
                                if not hunt then add(ch, "scp", sl) end
                            elseif ESP.PlayerEnabled and not hiddenSCP(ch) then
                                add(ch, "player", pl.Name)
                            end
                        end
                    end
                end
            end
        end)
    end

    -- 【v16.3 修复·同一 SCP 显示两套标签】
    -- 根因：fullScan 对 Workspace 里每个 Model 都跑 classifySCP，
    --   而 4033 这类 SCP 是「父 Model + 内部子 Model」或多部件结构，
    --   父子各命中一次 → 同编号画两条标签，距离差几米（如 200m / 205m）。
    -- 处理：同编号且两个标记的实体位置相距 < DEDUP_R 时，只保留最近的一条标签；
    --   相距很远（真正刷了两只）则都保留。只隐藏 BillboardGui，保留 Highlight 轮廓。
    local DEDUP_R = 10
    local function dedupeSCPLabels()
        local cam = WS.CurrentCamera
        if not cam then return end
        local list = {}
        for m, rec in pairs(ESP.Marks) do
            if rec.kind == "scp" and rec.bg and m.Parent then
                local pos
                if rec.host and rec.host:IsA("BasePart") then
                    pos = rec.host.Position
                elseif rec.host and rec.host:IsA("Model") then
                    local ok, cf = pcall(function() return rec.host:GetBoundingBox() end)
                    pos = ok and cf and cf.Position or nil
                end
                if pos then
                    list[#list + 1] = {
                        rec = rec, pos = pos, label = rec.label,
                        d = (cam.CFrame.Position - pos).Magnitude,
                    }
                end
            end
        end
        for _, e in ipairs(list) do
            if e.rec.bg.Enabled ~= true then e.rec.bg.Enabled = true end
        end
        -- 按编号分桶：只在同名组内两两比较（原来是全表 O(n²)）
        local bucket = {}
        for _, e in ipairs(list) do
            if e.label then
                local g = bucket[e.label]
                if not g then g = {}; bucket[e.label] = g end
                g[#g + 1] = e
            end
        end
        for _, g in pairs(bucket) do
            if #g > 1 then
                for i = 1, #g do
                    for j = i + 1, #g do
                        local A, B = g[i], g[j]
                        if (A.pos - B.pos).Magnitude < DEDUP_R then
                            local far = (A.d >= B.d) and A or B
                            if far.rec.bg.Enabled then far.rec.bg.Enabled = false end
                        end
                    end
                end
            end
        end
    end

    local acc, sacc, hacc, facc, dacc = 0, 0, 0, 0, 0
    ESP.Heartbeat = RUS.Heartbeat:Connect(function(dt)
        if not ESP.Enabled then return end
        acc = acc + dt;sacc = sacc + dt;hacc = hacc + dt;facc = facc + dt;dacc = dacc + dt
        if hacc >= ESP.HuntCheckInterval then
            hacc = 0
            ESP.HuntMode = isLocalSCP()
        end
        if facc >= ESP.FullScanInterval then
            facc = 0
            fullScan()
        end
        if acc >= ESP.RefreshInterval then
            acc = 0
            local slow = sacc >= ESP.RecheckInterval
            if slow then sacc = 0 end
            for m, rec in pairs(ESP.Marks) do pcall(refresh, m, rec, slow) end
            -- 去重要算包围盒，别跟着 0.6s 跑：2s 一次足够，肉眼无差
            if dacc >= 2 then
                dacc = 0
                pcall(dedupeSCPLabels)
            end
        end
    end)

    ESP.Added = WS.DescendantAdded:Connect(function(d)
        if not ESP.Enabled or not d:IsA("Model") then return end
        if ESP.Marks[d] then return end
        -- 廉价预筛：非玩家角色不排队（地图装饰 Model 在进图瞬间有几千个）
        local plNow
        pcall(function() plNow = PlayersSvc:GetPlayerFromCharacter(d) end)
        if plNow and (ESP.PlayerEnabled or ESP.SCPEnabled) then
            task.defer(function()
                pcall(function()
                    if not ESP.Enabled or not (ESP.PlayerEnabled or ESP.SCPEnabled) then return end
                    local pl = PlayersSvc:GetPlayerFromCharacter(d)
                    if pl and pl ~= P and not ESP.Marks[d] and not isSpectator(pl, d)
                        and not isInactiveBody(d) then
                        local sl = classifyForESP(d)
                        if sl then
                            if not ESP.HuntMode then add(d, "scp", sl) end
                        elseif ESP.PlayerEnabled and not hiddenSCP(d) then
                            add(d, "player", pl.Name)
                        end
                    end
                end)
            end)
        end
        local ln = string.lower(d.Name)
        local maybe = string.find(ln, "scp", 1, true) ~= nil
        if not maybe then
            for _, w in ipairs({ "crate", "dropped", "supply", "682", "173", "096",
                                 "049", "106", "035", "939", "999", "966", "457",
                                 "079", "066", "076", "008", "610", "131", "777" }) do
                if string.find(ln, w, 1, true) then maybe = true; break end
            end
        end
        if not maybe then
            -- 再查一次标签（名字不含编号但带 SCP 标签的 NPC）
            pcall(function()
                for _, t in ipairs(CSvc:GetTags(d)) do
                    if string.find(string.lower(tostring(t)), "scp", 1, true) then
                        maybe = true; break
                    end
                end
            end)
        end
        if not maybe then return end
        task.defer(function()
            pcall(function()
                if not ESP.Enabled then return end
                if ESP.CrateEnabled then
                    if crateKind(d) == "crate" then add(d, "crate") end
                end
                if ESP.SCPEnabled and not ESP.HuntMode and not isMine(d) then
                    local label = classifyForESP(d)
                    if label then add(d, "scp", label) end
                end
            end)
        end)
    end)

    -- 总开关：任一子项开启即运行
    -- 关键：开关每次变化都「同步」清理，关闭即刻停用，不等下一帧
    ESP.Reconcile = function()
        ESP.Enabled = ESP.CrateEnabled or ESP.SCPEnabled or ESP.GunEnabled or ESP.PlayerEnabled
        clearDisabled()
        if ESP.Enabled then fullScan() end
    end

    ESP.Off = function()
        ESP.Enabled = false
        clearDisabled()
        if ESP.Heartbeat then ESP.Heartbeat:Disconnect() end
        if ESP.Added then ESP.Added:Disconnect() end
        G.CRATE_ESP = nil
    end

    -- 诊断：列出场上所有含 035 的 Model 及最终判定（排查「035 不透视」）
    -- 控制台执行 getgenv().CRATE_ESP.Dump035()
    ESP.Dump035 = function()
        local cnt = 0
        pcall(function()
            for _, d in ipairs(WS:GetDescendants()) do
                if d:IsA("Model") then
                    local sig = string.lower(d.Name .. " " ..
                        tostring(d:GetAttribute("Class") or "") .. " " ..
                        tostring(d:GetAttribute("Form") or ""))
                    if string.find(sig, "035", 1, true) then
                        cnt = cnt + 1
                        local tags = {}
                        pcall(function()
                            for _, t in ipairs(game:GetService("CollectionService"):GetTags(d)) do
                                tags[#tags + 1] = t
                            end
                        end)
                        local hum = d:FindFirstChildOfClass("Humanoid")
                        print(string.format(
                            "[ESP] 035候选 %s | Class=%s Form=%s Tags=%s HP=%s | 判定=%s",
                            d:GetFullName(), tostring(d:GetAttribute("Class")),
                            tostring(d:GetAttribute("Form")), table.concat(tags, ","),
                            tostring(hum and hum.Health or "nil"),
                            tostring(classifySCP(d))))
                    end
                end
            end
        end)
        print(string.format("[ESP] 035候选数=%d · SCPEnabled=%s HuntMode=%s Enabled=%s",
            cnt, tostring(ESP.SCPEnabled), tostring(ESP.HuntMode), tostring(ESP.Enabled)))
    end

    -- 诊断：控制台执行 getgenv().CRATE_ESP.DumpSCP()
    -- 列出当前每个 SCP 标记的模型全名 / 标签 / 距离 / 标签是否被去重隐藏
    ESP.DumpSCP = function()
        local cam = WS.CurrentCamera
        local n, hidden = 0, 0
        for m, rec in pairs(ESP.Marks) do
            if rec.kind == "scp" then
                n = n + 1
                local pos
                if rec.host and rec.host:IsA("BasePart") then pos = rec.host.Position
                elseif rec.host and rec.host:IsA("Model") then
                    local ok, cf = pcall(function() return rec.host:GetBoundingBox() end)
                    pos = ok and cf and cf.Position or nil
                end
                local d = (cam and pos) and math.floor((cam.CFrame.Position - pos).Magnitude) or -1
                local vis = rec.bg and rec.bg.Enabled
                if not vis then hidden = hidden + 1 end
                print(string.format("[ESP] SCP标记 %s | 标签=%s | %dm | 显示=%s",
                    m:GetFullName(), tostring(rec.label), d, tostring(vis)))
            end
        end
        print(string.format("[ESP] SCP标记数=%d · 去重隐藏=%d · DEDUP_R=%dm", n, hidden, DEDUP_R))
    end

    -- 诊断：控制台执行 getgenv().CRATE_ESP.DumpPlayers()
    -- 打印每个玩家的 Team / Class / Controller 与最终分类，便于定位漏判
    ESP.DumpPlayers = function()
        for _, pl in ipairs(PlayersSvc:GetPlayers()) do
            local ch = pl.Character
            local team = "?"
            pcall(function() team = pl.Team and pl.Team.Name or "(无队伍)" end)
            local cls, ctl = "?", "?"
            if ch then
                pcall(function() cls = tostring(ch:GetAttribute("Class") or "?") end)
                pcall(function() ctl = tostring(ch:GetAttribute("Controller") or "?") end)
            end
            local verdict = ch and classifySCP(ch) or "(无角色)"
            print(string.format("[ESP] %s | Team=%s | Class=%s | Controller=%s | 判定=%s",
                pl.Name, tostring(team), tostring(cls), tostring(ctl), tostring(verdict)))
        end
    end

    -- v14：SCP 透视默认开启（见上方 ESP 初始表）。全量 Workspace 扫描
    -- 用 task.defer 延后一帧，避免「加载即卡顿」。
    -- 旧版残留实例已在脚本开头调用旧 CRATE_ESP.Off() 时清理完毕。
    clearDisabled(true)
    task.defer(function() if ESP.Enabled then fullScan() end end)
end

-- ============================================================
-- UI 构建
-- 优先使用开源黑曜石原本（NightForRoblox 官方源），失败时回退原生面板（兜底）
-- ============================================================

-- ============================================================
-- rage · 命中反馈 / 弹道显示（纯客户端视觉 · 零 hook · 零元表）
-- 触发：GUNBOT 每次成功发包后调用 G.RAGE_FX.play(起点, 命中点, 目标Model)
-- 对外：G.RAGE_FX.SetHit(bool) / SetTracer(bool) / SetEnabled(bool) / Dump()
-- ============================================================
do
    local TweenService = game:GetService("TweenService")
    local SoundService = game:GetService("SoundService")
    local RunSvc       = game:GetService("RunService")
    local Players      = game:GetService("Players")

    local FX = {
        Enabled     = true,
        Hitmarker   = false,   -- 「命中反馈」：命中标记 + 边缘闪光 + FOV 冲击 + 音效 + 目标高亮
        Tracer      = false,   -- 「弹道显示」：从人物（头部/身体）画到命中点
        TracerStyle = "经典",  -- 弹道样式：经典 / 粗光晕 / 细针 / 3D 光束 / 3D 脉冲
        Effect      = true,
        SoundOn     = true,
        Chams       = true,
        SoundKey    = "Skeet",
        Volume      = 0.7,
        TracerColor = Color3.fromRGB(0, 200, 255),
        TracerLife  = 0.18,
        TracerWidth = 1.5,
        ChamsColor  = Color3.fromRGB(255, 255, 255),
        ChamsLife   = 0.6,
    }
    G.RAGE_FX = FX

    local Tween = TweenInfo.new

    local HITSOUNDS = {
        ['Skeet']     = 'rbxassetid://5633695679',
        ['Neverlose'] = 'rbxassetid://6534948092',
        ['Bameware']  = 'rbxassetid://3124331820',
        ['Pick']      = 'rbxassetid://1347140027',
    }

    -- ---------- 容器 ----------
    pcall(function()
        local lp = Players.LocalPlayer
        local pg = lp and lp:FindFirstChildOfClass("PlayerGui")
        local o = pg and pg:FindFirstChild("RageFX")
        if o then o:Destroy() end
    end)

    local fxGui = Instance.new("ScreenGui")
    fxGui.Name = "RageFX"
    fxGui.IgnoreGuiInset = true
    fxGui.ResetOnSpawn = false
    fxGui.DisplayOrder = 500
    local okParent = pcall(function()
        fxGui.Parent = (gethui and gethui()) or game:GetService("CoreGui")
    end)
    if not okParent or not fxGui.Parent then
        pcall(function()
            local lp = Players.LocalPlayer
            local pg = lp and lp:FindFirstChildOfClass("PlayerGui")
            if pg then fxGui.Parent = pg end
        end)
    end
    FX.Gui = fxGui

    -- ---------- 命中标记（对象池 · 四条斜线内收再外散）----------
    local POOL = 4
    local HM_RESET = {
        UDim2.new(0.5, -20, 0.5, -20), UDim2.new(0.5, 20, 0.5, -20),
        UDim2.new(0.5, -20, 0.5, 20),  UDim2.new(0.5, 20, 0.5, 20),
    }
    local HM_ENTER = {
        UDim2.new(0.5, -12, 0.5, -12), UDim2.new(0.5, 12, 0.5, -12),
        UDim2.new(0.5, -12, 0.5, 12),  UDim2.new(0.5, 12, 0.5, 12),
    }
    local HM_EXIT = {
        UDim2.new(0.5, -18, 0.5, -18), UDim2.new(0.5, 18, 0.5, -18),
        UDim2.new(0.5, -18, 0.5, 18),  UDim2.new(0.5, 18, 0.5, 18),
    }
    local CORNER_ROT = { 45, -45, -45, 45 }
    local CORNER_POS = {
        { 0.5, -14, 0.5, -14 }, { 0.5, 14, 0.5, -14 },
        { 0.5, -14, 0.5, 14 },  { 0.5, 14, 0.5, 14 },
    }

    local pool = {}
    for _ = 1, POOL do
        local f = Instance.new("Frame")
        f.Size = UDim2.fromOffset(60, 60)
        f.AnchorPoint = Vector2.new(0.5, 0.5)
        f.Position = UDim2.new(0.5, 0, 0.5, 0)
        f.BackgroundTransparency = 1
        f.Visible = false
        f.ZIndex = 300
        f.Parent = fxGui
        local parts = {}
        for i = 1, 4 do
            local line = Instance.new("Frame")
            line.Size = UDim2.fromOffset(14, 2)
            line.AnchorPoint = Vector2.new(0.5, 0.5)
            line.Position = UDim2.new(CORNER_POS[i][1], CORNER_POS[i][2],
                CORNER_POS[i][3], CORNER_POS[i][4])
            line.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            line.BorderSizePixel = 0
            line.Rotation = CORNER_ROT[i]
            line.BackgroundTransparency = 1
            line.ZIndex = 301
            line.Parent = f
            local st = Instance.new("UIStroke")
            st.Color = Color3.new(0, 0, 0)
            st.Thickness = 1
            st.Transparency = 1
            st.Parent = line
            parts[i] = { line = line, stroke = st }
        end
        pool[#pool + 1] = { frame = f, parts = parts, token = 0 }
    end
    local poolIdx = 0

    local function hitmarker()
        poolIdx = poolIdx % POOL + 1
        local hm = pool[poolIdx]
        hm.token = hm.token + 1
        local tok = hm.token

        hm.frame.Visible = true
        for i = 1, 4 do
            local p = hm.parts[i]
            p.line.Position = HM_ENTER[i]
            p.line.BackgroundTransparency = 0
            p.stroke.Transparency = 0.25
            TweenService:Create(p.line, Tween(0.06, Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out), { Position = HM_RESET[i] }):Play()
        end

        task.delay(0.1, function()
            if hm.token ~= tok then return end
            for i = 1, 4 do
                local p = hm.parts[i]
                TweenService:Create(p.line, Tween(0.12, Enum.EasingStyle.Quad,
                    Enum.EasingDirection.Out), {
                    Position = HM_EXIT[i],
                    BackgroundTransparency = 1,
                }):Play()
                TweenService:Create(p.stroke, Tween(0.12), { Transparency = 1 }):Play()
            end
            task.delay(0.14, function()
                if hm.token == tok then hm.frame.Visible = false end
            end)
        end)
    end

    -- ---------- 屏幕边缘闪光 ----------
    local EDGE_ALPHA = 0.26
    local edges = {}
    local function makeEdge(size, pos, rot, reverse)
        local e = Instance.new("Frame")
        e.Size = size
        e.Position = pos
        e.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        e.BackgroundTransparency = 1
        e.BorderSizePixel = 0
        e.ZIndex = 280
        e.Visible = false
        e.Parent = fxGui
        local g = Instance.new("UIGradient")
        g.Rotation = rot
        g.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, reverse and 1 or 0),
            NumberSequenceKeypoint.new(0.72, 0.45),
            NumberSequenceKeypoint.new(1, reverse and 0 or 1),
        })
        g.Parent = e
        return e
    end
    edges[1] = makeEdge(UDim2.new(1, 0, 0, 96), UDim2.new(0, 0, 0, 0), 90, false)
    edges[2] = makeEdge(UDim2.new(1, 0, 0, 96), UDim2.new(0, 0, 1, -96), 90, true)
    edges[3] = makeEdge(UDim2.new(0, 96, 1, -192), UDim2.new(0, 0, 0, 96), 0, false)
    edges[4] = makeEdge(UDim2.new(0, 96, 1, -192), UDim2.new(1, -96, 0, 96), 0, true)

    local edgeToken = 0
    local function flash()
        edgeToken = edgeToken + 1
        local tok = edgeToken
        for _, e in ipairs(edges) do
            e.Visible = true
            e.BackgroundTransparency = math.min(1, EDGE_ALPHA + 0.08)
            TweenService:Create(e, Tween(0.025, Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out), { BackgroundTransparency = EDGE_ALPHA }):Play()
        end
        task.delay(0.08, function()
            if edgeToken ~= tok then return end
            for _, e in ipairs(edges) do
                local t = TweenService:Create(e, Tween(1.0, Enum.EasingStyle.Quad,
                    Enum.EasingDirection.Out), { BackgroundTransparency = 1 })
                t.Completed:Connect(function()
                    if edgeToken == tok then e.Visible = false end
                end)
                t:Play()
            end
        end)
    end

    -- ---------- FOV 冲击 ----------
    local fovBase, fovTween, fovToken, fovT0 = nil, nil, 0, 0
    local function fovPunch()
        local cam = workspace.CurrentCamera
        if not cam then return end
        -- 连发不叠加：上一发冲击（含 1s 回落）没走完就直接跳过，避免 FOV 漂移
        if fovTween and (tick() - fovT0) < 1.2 then return end
        fovT0 = tick()
        fovToken = fovToken + 1
        local tok = fovToken
        if not fovBase then fovBase = cam.FieldOfView end
        if fovTween then pcall(function() fovTween:Cancel() end) end
        fovTween = TweenService:Create(cam, Tween(0.028, Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out), { FieldOfView = math.min(120, fovBase + 3.5) })
        fovTween:Play()
        task.delay(0.045, function()
            if fovToken ~= tok or not cam.Parent or not fovBase then return end
            if fovTween then pcall(function() fovTween:Cancel() end) end
            fovTween = TweenService:Create(cam, Tween(1.0, Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out), { FieldOfView = fovBase })
            fovTween:Play()
            fovTween.Completed:Connect(function()
                if fovToken == tok then fovTween = nil; fovBase = nil end
            end)
        end)
    end

    -- ---------- 音效 ----------
    local function playSound()
        if not FX.SoundOn then return end
        -- 连发节流：0.05s 内只响一次，避免 12 发/秒叠成噪音
        local nowT = tick()
        if nowT - (FX._lastSnd or 0) < 0.05 then return end
        FX._lastSnd = nowT
        local id = HITSOUNDS[FX.SoundKey] or HITSOUNDS['Skeet']
        local s = Instance.new("Sound")
        s.SoundId = id
        s.Volume = FX.Volume or 0.7
        s.PlaybackSpeed = 0.96 + math.random() * 0.08
        s.Parent = SoundService
        local ok = pcall(function() s:Play() end)
        if not ok then pcall(function() s:Destroy() end) return end
        s.Ended:Connect(function() pcall(function() s:Destroy() end) end)
        task.delay(3, function() pcall(function() if s.Parent then s:Destroy() end end) end)
    end

    -- ---------- 命中目标短暂高亮 ----------
    local chamFolder = Instance.new("Folder")
    chamFolder.Name = "RageHitChams"
    chamFolder.Parent = fxGui

    local lastChams = {}
    local lastChamsN = 0
    local function hitChams(char)
        if not (FX.Chams and char) then return end
        -- 同一目标 1s 内只高亮一次，连发时不堆 Highlight
        local nowC = tick()
        if lastChams[char] and nowC - lastChams[char] < 1.0 then return end
        if lastChamsN > 200 then lastChams = {}; lastChamsN = 0 end
        lastChams[char] = nowC
        lastChamsN = lastChamsN + 1
        local ok, hl = pcall(function()
            local h = Instance.new("Highlight")
            h.Adornee = char
            h.FillColor = FX.ChamsColor or Color3.fromRGB(255, 255, 255)
            h.OutlineColor = FX.ChamsColor or Color3.fromRGB(255, 255, 255)
            h.FillTransparency = 0.55
            h.OutlineTransparency = 0
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.Parent = chamFolder
            return h
        end)
        if not ok or not hl then return end
        local life = FX.ChamsLife or 0.6
        task.delay(life, function()
            if not hl.Parent then return end
            local t0 = tick()
            local conn
            conn = RunSvc.Heartbeat:Connect(function()
                local a = math.clamp((tick() - t0) / 0.35, 0, 1)
                hl.FillTransparency = 0.55 + 0.45 * a
                hl.OutlineTransparency = a
                if a >= 1 then
                    conn:Disconnect()
                    pcall(function() hl:Destroy() end)
                end
            end)
        end)
    end

    -- ---------- 弹道 ----------
    local TRACER_POOL = 32
    local tracers = {}
    local hasDrawing = (typeof(Drawing) == "table" and Drawing.new ~= nil)

    local beamFolder = Instance.new("Folder")
    beamFolder.Name = "RageBeam"
    pcall(function() beamFolder.Parent = workspace.CurrentCamera or workspace end)

    local function drawBeam3D(a, b)
        local okD, mag = pcall(function() return (b - a).Magnitude end)
        if not okD or not mag or mag < 0.5 then return end
        local a0 = Instance.new("Attachment")
        a0.CFrame = CFrame.new(a)
        a0.Parent = beamFolder
        local a1 = Instance.new("Attachment")
        a1.CFrame = CFrame.new(b)
        a1.Parent = beamFolder
        local beam = Instance.new("Beam")
        beam.Attachment0 = a0
        beam.Attachment1 = a1
        beam.FaceCamera = true
        beam.LightEmission = 1
        beam.LightInfluence = 1
        beam.Color = ColorSequence.new(FX.TracerColor)
        beam.Transparency = NumberSequence.new(0)
        local style = FX.TracerStyle or "经典"
        local w0 = math.max((FX.TracerWidth or 1.5) * 0.06, 0.03)
        if style == "3D 脉冲" then
            -- 无纹理纯光柱：靠宽度与透明度做呼吸感
            beam.Texture = ""
            beam.TextureLength = 0
            beam.TextureSpeed = 0
            beam.Width0 = w0 * 2.0
            beam.Width1 = w0 * 0.45
        else
            -- 3D 光束：流动光带
            beam.Texture = 'rbxassetid://446111271'
            beam.TextureMode = Enum.TextureMode.Wrap
            beam.TextureLength = 10
            beam.TextureSpeed = 1.5
            beam.Width0 = w0
            beam.Width1 = w0
        end
        beam.ZOffset = -1
        beam.Parent = beamFolder
        local life = math.max(FX.TracerLife or 0.18, 0.05)
        task.delay(life, function()
            if not beam.Parent then return end
            local t0 = tick()
            local conn
            conn = RunSvc.Heartbeat:Connect(function()
                local alpha = math.clamp((tick() - t0) / 0.2, 0, 1)
                beam.Transparency = NumberSequence.new(alpha)
                if style == "3D 脉冲" then
                    -- 边淡边收：像一道快速收束的光
                    beam.Width0 = w0 * (2.0 - 1.5 * alpha)
                    beam.Width1 = w0 * (0.45 + 0.25 * alpha)
                end
                if alpha >= 1 then
                    conn:Disconnect()
                    pcall(function() beam:Destroy(); a0:Destroy(); a1:Destroy() end)
                end
            end)
        end)
    end

    -- 起点万一落在相机背后（第三人称贴墙等），沿弹道方向推到相机前方再投影，
    -- 否则 WorldToViewportPoint 会镜像，整条线会画反/消失
    local function clampFront(cam, a, b)
        local ok1, ca = pcall(function() return cam.CFrame:PointToObjectSpace(a) end)
        if not ok1 or not ca then return a end
        if ca.Z <= -1 then return a end
        local ok2, cb = pcall(function() return cam.CFrame:PointToObjectSpace(b) end)
        if not ok2 or not cb or cb.Z >= -1 then return nil end
        local lo, hi = 0, 1
        for _ = 1, 12 do
            local mid = (lo + hi) * 0.5
            if ca:Lerp(cb, mid).Z <= -1 then hi = mid else lo = mid end
        end
        return cam.CFrame:PointToWorldSpace(ca:Lerp(cb, hi))
    end

    local drawLine2D
    if hasDrawing then
        for i = 1, TRACER_POOL do
            local line = Drawing.new("Line")
            line.Visible = false
            line.Thickness = 1
            line.ZIndex = 2
            local outline = Drawing.new("Line")
            outline.Visible = false
            outline.Thickness = 3
            outline.ZIndex = 1
            tracers[i] = { line = line, outline = outline, from = nil, to = nil,
                           born = 0, life = 0 }
        end
        local idx = 0
        RunSvc.RenderStepped:Connect(function()
            local cam = workspace.CurrentCamera
            if not cam then return end
            local now = tick()
            for _, t in ipairs(tracers) do
                if t.born > 0 then
                    local age = now - t.born
                    if age > t.life + 0.2 then
                        t.line.Visible = false
                        t.outline.Visible = false
                        t.born = 0
                    else
                        local src = clampFront(cam, t.from, t.to)
                        local p2, on2 = cam:WorldToViewportPoint(t.to)
                        local p1 = src and cam:WorldToViewportPoint(src)
                        if p1 and p2 and on2 and p1.Z > 0 and p2.Z > 0 then
                            local fade = age > t.life
                                and (1 - math.clamp((age - t.life) / 0.2, 0, 1)) or 1
                            local av = Vector2.new(p1.X, p1.Y)
                            local bv = Vector2.new(p2.X, p2.Y)
                            t.line.From, t.line.To = av, bv
                            t.outline.From, t.outline.To = av, bv
                            local st  = FX.TracerStyle or "经典"
                            local col = FX.TracerColor
                            local w   = FX.TracerWidth or 1.5
                            local showOut = true
                            if st == "粗光晕" then
                                w = w * 2.8
                            elseif st == "细针" then
                                w = 1
                                showOut = false
                            elseif st == "霓虹" then
                                w = w * 1.9
                                col = Color3.new(
                                    math.min(col.R * 1.2 + 0.12, 1),
                                    math.min(col.G * 1.2 + 0.12, 1),
                                    math.min(col.B * 1.2 + 0.12, 1))
                            end
                            t.line.Color = col
                            t.outline.Color = Color3.new(0, 0, 0)
                            t.line.Thickness = w
                            t.outline.Thickness = w + 2.5
                            t.line.Transparency = fade
                            t.outline.Transparency = showOut and (fade * 0.65) or 1
                            t.line.Visible = true
                            t.outline.Visible = showOut
                        else
                            t.line.Visible = false
                            t.outline.Visible = false
                        end
                    end
                end
            end
        end)
        drawLine2D = function(a, b)
            idx = idx % TRACER_POOL + 1
            local t = tracers[idx]
            t.from, t.to = a, b
            t.born = tick()
            t.life = math.max(FX.TracerLife or 0.18, 0.03)
        end
    end

    -- ---------- 对外入口 ----------
    function FX.play(fromPos, toPos, model)
        if not FX.Enabled then return end
        if FX.Hitmarker then
            pcall(hitmarker)
            if FX.Effect then pcall(flash); pcall(fovPunch) end
            pcall(playSound)
            if model then pcall(hitChams, model) end
        end
        if FX.Tracer and fromPos and toPos then
            local st = FX.TracerStyle or "经典"
            local force3D = (st == "3D 光束" or st == "3D 脉冲")
            pcall(function()
                if force3D or not hasDrawing then
                    drawBeam3D(fromPos, toPos)
                else
                    drawLine2D(fromPos, toPos)
                end
            end)
        end
    end
    FX.SetHit    = function(v) FX.Hitmarker = v and true or false; return FX.Hitmarker end
    FX.SetTracer = function(v) FX.Tracer    = v and true or false; return FX.Tracer end
    FX.SetTracerStyle = function(s)
        local t = tostring(s or "")
        if t == "" then return FX.TracerStyle end
        for _, k in ipairs({ "经典", "粗光晕", "细针", "霓虹", "3D 光束", "3D 脉冲" }) do
            if t == k then FX.TracerStyle = k; return FX.TracerStyle end
        end
        return FX.TracerStyle
    end
    FX.SetEnabled = function(v)
        FX.Enabled = v and true or false
        return FX.Enabled
    end
    FX.Dump = function()
        return string.format("RageFX Enabled=%s Hit=%s Tracer=%s Style=%s Drawing=%s Gui=%s",
            tostring(FX.Enabled), tostring(FX.Hitmarker), tostring(FX.Tracer),
            tostring(FX.TracerStyle), tostring(hasDrawing), tostring(fxGui.Parent ~= nil))
    end

    print("[RAGEFX] 命中反馈/弹道已就绪 · 诊断 G.RAGE_FX.Dump()")
end

-- ============================================================
-- GunAction 自动射击 v15（第三栏「攻击」）· 内嵌版
-- 复用主脚本的 G(getgenv)；BODY 与独立模块 gunbot.lua 完全一致。
-- 目标：玩家 / SCP / 全部 + 锁定具体玩家名或 SCP 编号；默认关闭零发包。
-- ============================================================
-- ============================================================
-- GunAction 自动射击（v15 · 攻击栏）
-- 复用主脚本外层 G(getgenv)；独立注入时由上方包装提供。
-- 完全自包含：不依赖主脚本的 ESP/分类 local 函数。
-- ============================================================
do
    if G.GUNBOT and G.GUNBOT.Off then pcall(function() G.GUNBOT.Off() end) end
    G.GUNBOT = nil

    local Players = game:GetService("Players")
    local RS      = game:GetService("ReplicatedStorage")
    local WS      = game:GetService("Workspace")
    local RUS     = game:GetService("RunService")
    local UIS     = game:GetService("UserInputService")
    local CS      = game:GetService("CollectionService")
    local LP      = Players.LocalPlayer

    -- --------------------------------------------------------
    -- 状态表（UI 直接读写这些字段）
    -- --------------------------------------------------------
    local B = {
        Enabled      = false,      -- 总开关，默认关
        Mode         = "SCP",      -- "玩家" | "SCP" | "全部"（rage 默认打 SCP）
        TeamMode     = "both",     -- both=同队+旁观者都不打 | team=仅同队 | spec=仅旁观者 | off=全不检测
        LockTarget   = "",         -- 锁定具体目标（玩家名 / SCP 编号 / 标签）；空 = 自动选最近
        PlayerFilter = "",         -- 只打名字含此串的玩家；空 = 全部玩家
        SCPFilter    = "",         -- 只打编号含此串的 SCP；空 = 全部 SCP
        AimPart      = "Head",
        MaxDistance  = 800,
        FireDelay    = 0.08,
        CheckWall    = true,
        RespectTeam  = true,
        FromCamera   = true,       -- 已废弃：弹道与墙检固定从人物发出，仅无角色时兜底用相机
        CheckAmmo    = false,      -- 已停用拦截：没拿武器 / 弹匣空也照常发包（服务端自己判）
        Ammo         = nil,        -- 当前读到的弹匣数（nil = 读不到，不拦截）
        NoAmmo       = false,      -- 上帧是否空仓（只做提示，不再拦开枪）
        DeepScan     = false,      -- 额外全扫 workspace（默认关，省性能）
        ShowFloat    = true,       -- 手机浮动大按钮
        -- 统计 / 诊断
        Shots = 0, Errors = 0, CurTarget = "无", Candidates = 0,
        Status = "待命（默认关闭）", RemoteOK = false,
    }
    G.GUNBOT = B

    -- --------------------------------------------------------
    -- 小工具（全部 pcall 保护，单个对象失效不影响整体）
    -- --------------------------------------------------------
    local function lo(s) return string.lower(tostring(s or "")) end
    local function nameOf(x)
        local ok, v = pcall(function() return x.Name end)
        return ok and tostring(v) or ""
    end
    local function isModel(x)
        if not x then return false end
        local ok, r = pcall(function() return x:IsA("Model") end)
        return ok and r == true
    end
    local function isBasePart(x)
        if not x then return false end
        local ok, r = pcall(function() return x:IsA("BasePart") end)
        return ok and r == true
    end
    local function ancModel(x)
        if not x then return nil end
        local ok, r = pcall(function() return x:FindFirstAncestorOfClass("Model") end)
        return ok and r or nil
    end
    local function attr(x, k)
        local ok, v = pcall(function() return x:GetAttribute(k) end)
        return ok and v or nil
    end

    -- 从 "SCP-173" / "SCP173Mask" / "173" / "SCP 173" 抽 3 位编号
    local SCP_NUMS = { "682", "173", "096", "049", "106", "035",
                       "777", "939", "999", "966", "457", "079", "066", "076", "008" }
    local function numOf(s)
        local c = string.gsub(lo(s), "[-_%s]", "")
        for _, n in ipairs(SCP_NUMS) do
            if c == n then return n end                        -- 纯 "173"
        end
        local bare = string.match(c, "^(%d%d%d)$")             -- 任意纯 3 位
        if bare then return bare end
        for _, n in ipairs(SCP_NUMS) do
            if string.find(c, "scp" .. n, 1, true) then return n end
        end
        local g = string.match(c, "scp(%d%d%d)")               -- 通用 SCPxxx
        if g then return g end
        return nil
    end

    -- 静态物件 / 尸体 / 特效名，绝不当 SCP 目标
    local BAD_WORDS = { "chamber", "zone", "room", "cell", "spawn", "sludge",
        "sense", "pestilence", "ragdoll", "door", "gate", "wall", "sign",
        "prop", "decor", "display", "corpse", "statue", "lobby", "lured",
        "sinkhole", "effect", "gib", "debris", "remains", "oldbody",
        "oldshell", "abandoned", "monitor", "camera" }
    local function badName(n)
        local l = lo(n)
        for _, w in ipairs(BAD_WORDS) do
            if string.find(l, w, 1, true) then return true end
        end
        return false
    end

    -- 死亡 / 残留身体判定
    local function inactive(m)
        local okH, hum = pcall(function() return m:FindFirstChildOfClass("Humanoid") end)
        if okH and hum then
            local ok, hp = pcall(function() return hum.Health end)
            if ok and hp and hp <= 0 then return true end
        end
        for _, k in ipairs({ "Dead", "IsDead", "IsCorpse", "Corpse", "IsRagdoll",
                             "Inactive", "IsInactive", "Abandoned", "OldBody",
                             "IsOldBody", "IsShell", "IsEmpty" }) do
            if attr(m, k) == true then return true end
        end
        return false
    end

    -- 取可射击的 Part：AimPart → Head → HumanoidRootPart → Torso → PrimaryPart
    -- → 名字带 head 的任意 BasePart → 第一个 BasePart
    local function aimPart(m)
        if not m then return nil end
        local order = { B.AimPart, "Head", "HumanoidRootPart", "UpperTorso",
                        "Torso", "LowerTorso" }
        for _, n in ipairs(order) do
            local ok, p = pcall(function() return m:FindFirstChild(n) end)
            if ok and isBasePart(p) then return p end
        end
        local okPP, pp = pcall(function() return m.PrimaryPart end)
        if okPP and isBasePart(pp) then return pp end
        local okD, desc = pcall(function() return m:GetDescendants() end)
        if okD and desc then
            for _, x in ipairs(desc) do
                if isBasePart(x) and string.find(lo(nameOf(x)), "head", 1, true) then
                    return x
                end
            end
            for _, x in ipairs(desc) do
                if isBasePart(x) then return x end
            end
        end
        return nil
    end

    -- Model → SCP 编号（标签优先 / 属性 / 名字）；过滤 Lured / Sinkhole
    local function modelNum(m)
        local okT, tags = pcall(function() return CS:GetTags(m) end)
        local hasChar = false
        if okT and tags then
            for _, t in ipairs(tags) do
                local l = lo(t)
                if string.find(l, "scpcharacter", 1, true) then hasChar = true end
                if not string.find(l, "lured", 1, true)
                   and not string.find(l, "sinkhole", 1, true) then
                    local n = numOf(t)
                    if n then return n, t end
                end
            end
        end
        for _, k in ipairs({ "Class", "SCP", "Role", "CurrentSCP", "SCPNumber",
                             "SCPType", "SCPClass", "Form", "PlayingAs", "Controller" }) do
            local v = attr(m, k)
            if v ~= nil then
                local n = numOf(v)
                if n then return n, k .. "=" .. tostring(v) end
            end
        end
        local n = numOf(nameOf(m))
        if n then return n, "Name=" .. nameOf(m) end
        if hasChar then return "???", "SCPCharacter" end
        return nil
    end

    -- 已知 SCP 实体标签（MCP 实证：SCP049 / SCPCharacter / SCP035Mask / ...）
    local SCP_TAGS = {}
    do
        local seen = {}
        local function add(t)
            if not seen[t] then seen[t] = true; SCP_TAGS[#SCP_TAGS + 1] = t end
        end
        for _, n in ipairs({ "035", "049", "066", "076", "079", "096", "106",
                             "173", "457", "682", "777", "939", "966", "999" }) do
            add("SCP" .. n); add("SCP-" .. n)
        end
        add("SCPCharacter"); add("SCP035Mask"); add("SCP035Host"); add("SCP035Model")
        add("SCP049Character"); add("SCP096Character"); add("SCP106Character")
        add("SCP173Character"); add("SCP682Character"); add("SCP939Character")
    end

    -- --------------------------------------------------------
    -- 候选表（低频重建，射击循环只读缓存 → 零每帧全扫开销）
    -- --------------------------------------------------------
    local cache  = {}
    local cacheT = 0

    local function rebuild()
        local out = {}

        -- ① 玩家路
        local okP, plist = pcall(function() return Players:GetPlayers() end)
        if okP and plist then
            for _, pl in ipairs(plist) do
                if pl ~= LP then
                    local okC, ch = pcall(function() return pl.Character end)
                    if okC and ch then
                        local part = aimPart(ch)
                        if part and not inactive(ch) then
                            out[#out + 1] = {
                                kind = "Player", model = ch, part = part,
                                label = nameOf(pl), player = pl, num = nil,
                            }
                        end
                    end
                end
            end
        end

        -- ② SCP 路
        local seen = {}
        local function addSCP(m, num, tag)
            if not m or seen[m] or not isModel(m) then return end
            if m == (LP and LP.Character) then return end
            local okO, owner = pcall(function() return Players:GetPlayerFromCharacter(m) end)
            if okO and owner == LP then return end
            if badName(nameOf(m)) or inactive(m) then return end
            local part = aimPart(m)
            if not part then return end
            seen[m] = true
            out[#out + 1] = {
                kind = "SCP", model = m, part = part,
                label = "SCP-" .. tostring(num or "???"), num = num, tag = tag,
            }
        end

        for _, tag in ipairs(SCP_TAGS) do
            local okT, list = pcall(function() return CS:GetTagged(tag) end)
            if okT and list then
                for _, inst in ipairs(list) do
                    local m = isModel(inst) and inst or ancModel(inst)
                    local n = numOf(tag)
                    if string.find(lo(tag), "scpcharacter", 1, true) then
                        n = n or "???"
                    end
                    addSCP(m, n, tag)
                end
            end
        end

        -- ③ 可选：全 workspace 深扫（覆盖没打标签、只有属性的 SCP）
        if B.DeepScan then
            local okD, desc = pcall(function() return WS:GetDescendants() end)
            if okD and desc then
                local cnt = 0
                for _, m in ipairs(desc) do
                    cnt = cnt + 1
                    if cnt > 4000 then break end
                    if isModel(m) and not seen[m] and not badName(nameOf(m)) then
                        local n, tag = modelNum(m)
                        if n then addSCP(m, n, tag or "attr") end
                    end
                end
            end
        end

        cache  = out
        cacheT = os.clock()
        B.Candidates = #out
    end

    -- --------------------------------------------------------
    -- 过滤：类别 / 锁定 / 筛选 / 同队
    -- --------------------------------------------------------
    -- 队伍检测档位（rage 页下拉）：both 同队+旁观者都不打 / team 仅同队 / spec 仅旁观者 / off 全不检测
    local function skipGhost() return B.TeamMode == "both" or B.TeamMode == "spec" end
    local function skipTeam()  return B.TeamMode == "both" or B.TeamMode == "team" end

    local function wanted(c)
        -- 旁观者（Ghost 幽灵）按档位过滤；默认档位不打
        if c.player and skipGhost() and isGhostSpec(c.player) then return false end
        if B.Mode == "玩家" and c.kind ~= "Player" then return false end
        if B.Mode == "SCP"  and c.kind ~= "SCP"  then return false end

        if B.LockTarget ~= "" then
            local lt = lo(B.LockTarget)
            if not (string.find(lo(c.label), lt, 1, true)
                or (c.player and string.find(lo(nameOf(c.player)), lt, 1, true))
                or (c.tag and string.find(lo(c.tag), lt, 1, true))) then
                return false
            end
        else
            if c.kind == "Player" and B.PlayerFilter ~= "" then
                if not (c.player and string.find(lo(nameOf(c.player)),
                        lo(B.PlayerFilter), 1, true)) then return false end
            end
            if c.kind == "SCP" and B.SCPFilter ~= "" then
                if not (string.find(lo(c.label), lo(B.SCPFilter), 1, true)
                    or (c.num and string.find(lo(c.num), lo(B.SCPFilter), 1, true))) then
                    return false
                end
            end
        end

        if skipTeam() and c.player then
            -- 暴乱模式：按职业队伍（Guard系 vs ClassD），只打对面，不打同队
            if isRiotMode() then
                local myT = teamOfPlayer(LP)
                local pT  = teamOfPlayer(c.player)
                if myT and pT and myT == pT then return false end  -- 同队跳过
            else
                local okT, myTeam = pcall(function() return LP.Team end)
                local okP, pTeam  = pcall(function() return c.player.Team end)
                if okT and okP and myTeam and pTeam == myTeam then return false end
            end
        end
        return true
    end

    -- --------------------------------------------------------
    -- 射线墙检（原脚本逻辑，全部 pcall 保护）
    -- --------------------------------------------------------
    local function clearShot(part, localChar)
        -- 与弹道同源：统一从人物（Head → HumanoidRootPart → 相机兜底）出发做遮挡判定，
        -- 避免「相机能打到、人物其实在墙后」这种视觉与判定不一致
        local origin
        local mh = localChar and localChar:FindFirstChild("Head")
        if mh then pcall(function() origin = mh.Position end) end
        if not origin then
            local mh2 = localChar and localChar:FindFirstChild("HumanoidRootPart")
            if mh2 then pcall(function() origin = mh2.Position end) end
        end
        if not origin then
            local ok, cam = pcall(function() return WS.CurrentCamera end)
            if ok and cam then pcall(function() origin = cam.CFrame.Position end) end
        end
        local okPos, to = pcall(function() return part.Position end)
        if not okPos or not to then return true end
        -- v15 修正：距离限制始终生效（不受墙检开关影响）。
        -- 原脚本把 MAX_DISTANCE 检查放在 CHECK_WALL 分支里，
        -- 关掉墙检就会连距离一起失效 → 打到无限远的目标。
        local delta, dist
        if origin then
            local okD, d = pcall(function() return to - origin end)
            local okM, m = pcall(function() return d and d.Magnitude end)
            if okD and okM and m and m > B.MaxDistance then return false end
            delta, dist = d, m
        end
        if not B.CheckWall then return true end
        if not origin or not delta or not dist then return true end
        if dist < 0.05 then return true end

        local okAll, res = pcall(function()
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Blacklist
            params.FilterDescendantsInstances = localChar and { localChar } or {}
            return WS:Raycast(origin, delta, params)
        end)
        if not okAll then return true end   -- 环境不支持 Raycast → 视为无障碍
        if not res then return true end
        return ancModel(res.Instance) == ancModel(part)
    end

    -- --------------------------------------------------------
    -- 远程 / 发射
    -- --------------------------------------------------------
    local remote = nil
    local function getRemote()
        if remote then return remote end
        local ok, r = pcall(function()
            local f = RS:FindFirstChild("Remotes")
            return f and f:FindFirstChild("GunAction") or nil
        end)
        if ok and r then
            remote = r
            B.RemoteOK = true
        end
        return remote
    end

    -- 弹道起点 = 人物自身：Head → HumanoidRootPart → 相机（仅角色不存在时兜底）
    -- --------------------------------------------------------
    -- 弹匣（空仓不开枪）
    -- --------------------------------------------------------
    local lastTouch = nil
    pcall(function()
        UIS.InputBegan:Connect(function(i)
            if i and i.UserInputType == Enum.UserInputType.Touch then lastTouch = i end
        end)
    end)

    local function heldTool()
        local ch = LP and LP.Character
        if not ch then return nil end
        local ok, t = pcall(function() return ch:FindFirstChildOfClass("Tool") end)
        return (ok and t) or nil
    end

    -- 依次尝试：Mag（枪械框架通用）/ 属性 Ammo·Clip·CurrentAmmo / 同名数值对象
    local function readAmmo(tool)
        if not tool then return nil end
        local o
        pcall(function() o = tool:FindFirstChild("Mag", true) end)
        if o then
            local v
            pcall(function() v = tonumber(o.Value) end)
            if v then return v, o end
        end
        for _, k in ipairs({ "Ammo", "Clip", "CurrentAmmo", "Bullets", "AmmoCount" }) do
            local a
            pcall(function() a = tonumber(tool:GetAttribute(k)) end)
            if a then return a, nil end
            local c
            pcall(function() c = tool:FindFirstChild(k, true) end)
            if c then
                local v
                pcall(function() v = tonumber(c.Value) end)
                if v then return v, c end
            end
        end
        return nil, nil
    end

    local reloadAt = 0
    -- 走游戏自带换弹按钮的 GUI 回调（不产生系统鼠标事件，手机端不会退化成电脑端）
    local function tryReload()
        local now = os.clock()
        if now - reloadAt < 1.0 then return false end
        reloadAt = now
        local done = false
        pcall(function()
            if not getconnections then return end
            local pg = LP and LP:FindFirstChild("PlayerGui")
            local sc = pg and pg:FindFirstChild("FEGKSessionControls")
            local mb = sc and sc:FindFirstChild("MobileButtons")
            local btn = mb and mb:FindFirstChild("ReloadButton")
            if not btn then
                -- 兜底：整个 PlayerGui 里找名字带 Reload 的按钮
                local found
                pcall(function() found = pg and pg:FindFirstChild("ReloadButton", true) end)
                btn = found
            end
            if not (btn and btn.InputBegan) then return end
            local touch = lastTouch or (getgenv and getgenv()._TOUCH)
            local conns = getconnections(btn.InputBegan)
            for _, c in ipairs(conns or {}) do
                pcall(function() c.Function(touch) end)
                done = true
            end
        end)
        return done
    end

    local function fireOrigin()
        local lc = LP and LP.Character
        local hd = lc and lc:FindFirstChild("Head")
        if hd then
            local okP, p = pcall(function() return hd.Position end)
            if okP and p then return p end
        end
        local hrp = lc and lc:FindFirstChild("HumanoidRootPart")
        if hrp then
            local okP, p = pcall(function() return hrp.Position end)
            if okP and p then return p end
        end
        local ok, cam = pcall(function() return WS.CurrentCamera end)
        if ok and cam then
            local okP, p = pcall(function() return cam.CFrame.Position end)
            if okP and p then return p end
        end
        return nil
    end

    local ammoCacheAt, ammoCacheVal = 0, nil
    local function fire(c)
        local r = getRemote()
        if not r then
            B.Status = "未找到 Remotes.GunAction"
            return false
        end
        -- 没拿武器 / 弹匣空 一律照常开枪（不外挂判定，交给服务端）：这里只读弹药做显示 + 顺手换弹
        local tool = heldTool()
        local n
        if tool then
            local now2 = os.clock()
            if now2 - ammoCacheAt > 0.15 then
                local v = readAmmo(tool)
                ammoCacheAt, ammoCacheVal = now2, v
                n = v
            else
                n = ammoCacheVal
            end
        end
        B.Ammo = n
        if tool and n and n <= 0 then
            B.NoAmmo = true
            tryReload()                      -- 空仓也先打出去，同时后台换弹
        else
            B.NoAmmo = false
        end
        local origin = fireOrigin()
        local pos
        local ok, err = pcall(function()
            pos = c.part.Position
            r:FireServer("Shoot", pos, c.part)
        end)
        if ok then
            B.Shots = B.Shots + 1
            -- rage：命中反馈 / 弹道显示（纯视觉，失败不影响发包）
            local fx = G.RAGE_FX
            if fx and fx.play and pos then
                pcall(fx.play, origin, pos, c.model)
            end
            return true
        else
            B.Errors = B.Errors + 1
            if B.Errors <= 3 then
                pcall(function() warn("[GUNBOT] 发射失败: " .. tostring(err)) end)
            end
            return false
        end
    end

    -- --------------------------------------------------------
    -- 选目标：过滤 + 去重(同一 Model) + 按相机距离排序 + 逐个墙检
    -- --------------------------------------------------------
    local function pick()
        local camPos
        pcall(function()
            local cam = WS.CurrentCamera
            if cam then camPos = cam.CFrame.Position end
        end)
        local list, seenM = {}, {}
        for _, c in ipairs(cache) do
            if wanted(c) and c.model and not seenM[c.model] then
                seenM[c.model] = true
                list[#list + 1] = c
            end
        end
        B.Candidates = #list
        if camPos then
            table.sort(list, function(a, b)
                local oa, da = pcall(function() return (a.part.Position - camPos).Magnitude end)
                local ob, db = pcall(function() return (b.part.Position - camPos).Magnitude end)
                return (oa and da or 9e9) < (ob and db or 9e9)
            end)
        end
        local localChar = LP and LP.Character
        local tried = 0
        for _, c in ipairs(list) do
            if clearShot(c.part, localChar) then return c end
            tried = tried + 1
            if tried >= 12 then break end   -- 每轮最多 12 次射线，避免视野差时疯狂 Raycast
        end
        return nil
    end

    -- --------------------------------------------------------
    -- 主循环（Heartbeat；关闭时立即 return，零发包）
    -- --------------------------------------------------------
    local lastShot = 0
    local function loop()
        if not B.Enabled then return end
        if not getRemote() then return end
        local now = os.clock()
        if now - lastShot < B.FireDelay then return end
        if now - cacheT > 1.2 then rebuild() end
        local c = pick()
        if not c then
            B.CurTarget = "无"
            B.Status = "已开启 · 无可用目标"
            return
        end
        B.CurTarget = c.label
        if fire(c) then
            lastShot = now
            local ammo = B.Ammo
            B.Status = "射击中 · " .. c.label
                .. (ammo and (" · 弹" .. tostring(ammo)) or " · 无武器/弹药未知")
        end
    end
    local hbConn = RUS.Heartbeat:Connect(loop)

    -- --------------------------------------------------------
    -- 手机浮动大按钮 + RightShift 热键（与原脚本一致）
    -- --------------------------------------------------------
    local sg, btn = nil, nil
    local floatTask = nil

    local function applyFloat()
        if not sg then return end
        pcall(function() sg.Enabled = B.ShowFloat end)
    end
    local function refreshFloat()
        if not btn then return end
        pcall(function()
            btn.Text = string.format("rage:%s  攻击:%s\n目标:%s  发%d 错%d",
                B.Enabled and "开" or "关", B.Mode, B.CurTarget, B.Shots, B.Errors)
            btn.BackgroundColor3 = B.Enabled
                and Color3.fromRGB(30, 90, 40) or Color3.fromRGB(30, 30, 30)
        end)
    end
    local function buildFloat()
        local ok = pcall(function()
            local pg = LP and LP:FindFirstChildOfClass("PlayerGui")
            if not pg then return end
            sg = Instance.new("ScreenGui")
            sg.Name = "GunActionUI"
            sg.ResetOnSpawn = false
            sg.IgnoreGuiInset = true
            pcall(function() sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling end)
            sg.Parent = pg
            btn = Instance.new("TextButton")
            btn.Size = UDim2.new(0, 240, 0, 50)
            btn.Position = UDim2.new(0.5, -120, 0, 92)
            btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            btn.Font = Enum.Font.SourceSansBold
            btn.TextSize = 15
            btn.AutoButtonColor = false
            btn.Parent = sg
            btn.MouseButton1Click:Connect(function()
                B.Enabled = not B.Enabled
                B.Status = B.Enabled and "已开启" or "已关闭"
                refreshFloat()
            end)
            applyFloat()
            refreshFloat()
        end)
        return ok and sg ~= nil
    end
    if not buildFloat() then
        -- PlayerGui 尚未就绪（重注入 / 刚重生）：后台延迟重试
        task.spawn(function()
            for i = 1, 12 do
                task.wait(1)
                if G.GUNBOT ~= B then return end
                if buildFloat() then return end
            end
        end)
    end
    floatTask = task.spawn(function()
        while G.GUNBOT == B do
            refreshFloat()
            task.wait(0.4)
        end
    end)

    local keyConn = UIS.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        pcall(function()
            if input.KeyCode == Enum.KeyCode.RightShift then
                B.Enabled = not B.Enabled
                B.Status = B.Enabled and "已开启" or "已关闭"
                refreshFloat()
            end
        end)
    end)

    -- --------------------------------------------------------
    -- 对外接口
    -- --------------------------------------------------------
    B.SetEnabled = function(v)
        B.Enabled = v and true or false
    end
    B.SetMode = function(s)
        local t = lo(s)
        if string.find(t, "全部", 1, true) or t == "all" or t == "both" then
            B.Mode = "全部"
        elseif string.find(t, "scp", 1, true) or t == "s" then
            B.Mode = "SCP"
        elseif string.find(t, "玩家", 1, true) or t == "player" or t == "p" then
            B.Mode = "玩家"
        end
        return B.Mode
    end
    B.CycleMode = function()
        local order = { "玩家", "SCP", "全部" }
        local i = 1
        for k, v in ipairs(order) do if v == B.Mode then i = k end end
        B.Mode = order[i % 3 + 1]
        return B.Mode
    end
    B.SetLock = function(s) B.LockTarget = tostring(s or ""); return B.LockTarget end
    B.CycleTarget = function()
        rebuild()
        local opts, seenL = { "" }, {}   -- "" = 自动(最近)
        for _, c in ipairs(cache) do
            if not seenL[c.label] then
                seenL[c.label] = true
                opts[#opts + 1] = c.label
            end
        end
        table.sort(opts, function(a, b) return lo(a) < lo(b) end)
        if #opts <= 1 then B.LockTarget = ""; return "自动(最近)" end
        local idx = 1
        for k, v in ipairs(opts) do if lo(v) == lo(B.LockTarget) then idx = k end end
        B.LockTarget = opts[idx % #opts + 1]
        if B.LockTarget == "" then return "自动(最近)" end
        return B.LockTarget
    end
    B.SetPlayerFilter = function(s) B.PlayerFilter = tostring(s or ""); return B.PlayerFilter end
    B.SetSCPFilter    = function(s) B.SCPFilter    = tostring(s or ""); return B.SCPFilter end
    B.SetAimPart      = function(s) B.AimPart      = tostring(s or "Head"); return B.AimPart end
    B.SetDelay        = function(n) B.FireDelay    = math.max(0.01, tonumber(n) or 0.08); return B.FireDelay end
    B.SetRange        = function(n) B.MaxDistance  = tonumber(n) or 800; return B.MaxDistance end
    B.SetWall         = function(v) B.CheckWall    = v and true or false; return B.CheckWall end
    B.SetTeam         = function(v)
        B.RespectTeam = v and true or false
        B.TeamMode = B.RespectTeam and "both" or "off"
        return B.RespectTeam
    end
    B.SetTeamMode     = function(s)
        local t = lo(s)
        if t == "both" then B.TeamMode = "both"
        elseif t == "team" then B.TeamMode = "team"
        elseif t == "spec" then B.TeamMode = "spec"
        elseif t == "off" or t == "all" then B.TeamMode = "off"
        elseif string.find(t, "全部", 1, true) or string.find(t, "全不", 1, true) then B.TeamMode = "off"
        elseif string.find(t, "仅旁观", 1, true) then B.TeamMode = "spec"
        elseif string.find(t, "仅同队", 1, true) then B.TeamMode = "team"
        elseif string.find(t, "同队", 1, true) and string.find(t, "旁观", 1, true) then B.TeamMode = "both"
        elseif string.find(t, "旁观", 1, true) then B.TeamMode = "spec"
        elseif string.find(t, "同队", 1, true) then B.TeamMode = "team"
        end
        B.RespectTeam = (B.TeamMode == "both" or B.TeamMode == "team")
        return B.TeamMode
    end
    B.SetFromCamera   = function(v) B.FromCamera   = v and true or false; return B.FromCamera end
    B.SetDeepScan     = function(v) B.DeepScan     = v and true or false; return B.DeepScan end
    B.SetFloat        = function(v) B.ShowFloat    = v and true or false; applyFloat(); return B.ShowFloat end
    B.ResetCount      = function() B.Shots = 0; B.Errors = 0 end

    B.FireNow = function()
        rebuild()
        local c = pick()
        if not c then return false, "无可用目标" end
        B.CurTarget = c.label
        return fire(c), c.label
    end

    B.Dump = function()
        local o = {}
        o[#o + 1] = string.format("Enabled=%s Mode=%s Team=%s Lock=%s PFilter=%s SFilter=%s",
            tostring(B.Enabled), B.Mode, tostring(B.TeamMode), tostring(B.LockTarget),
            tostring(B.PlayerFilter), tostring(B.SCPFilter))
        o[#o + 1] = string.format("Remote=%s Aim=%s Dist=%s Delay=%.3f Wall=%s Team=%s Cam=%s Deep=%s Float=%s",
            tostring(B.RemoteOK), B.AimPart, tostring(B.MaxDistance), B.FireDelay,
            tostring(B.CheckWall), tostring(B.RespectTeam), tostring(B.FromCamera),
            tostring(B.DeepScan), tostring(B.ShowFloat))
        o[#o + 1] = string.format("Shots=%d Errors=%d CurTarget=%s Status=%s",
            B.Shots, B.Errors, tostring(B.CurTarget), tostring(B.Status))
        o[#o + 1] = string.format("Ammo=%s NoAmmo=%s CheckAmmo=%s Tool=%s",
            B.Ammo == nil and "读不到" or tostring(B.Ammo), tostring(B.NoAmmo),
            tostring(B.CheckAmmo), tostring(heldTool() and "手持" or "无"))
        rebuild()
        o[#o + 1] = "候选 " .. tostring(#cache) .. " 个："
        local n = 0
        for _, c in ipairs(cache) do
            if n < 40 then
                local ok, s = pcall(function()
                    return string.format("  [%s] %-18s part=%-18s pos=(%.0f,%.0f,%.0f) tag=%s wanted=%s",
                        c.kind, c.label, nameOf(c.part),
                        c.part.Position.X, c.part.Position.Y, c.part.Position.Z,
                        tostring(c.tag), tostring(wanted(c)))
                end)
                o[#o + 1] = ok and s or "  [读取失败]"
                n = n + 1
            end
        end
        return table.concat(o, "\n")
    end

    B.Off = function()
        B.Enabled = false
        pcall(function() if hbConn then hbConn:Disconnect() end end)
        pcall(function() if keyConn then keyConn:Disconnect() end end)
        pcall(function() if sg then sg:Destroy() end end)
        sg, btn = nil, nil
        cache = {}
        if G.GUNBOT == B then G.GUNBOT = nil end
        -- 兼容原脚本的 _G.GA_* 诊断别名一并清理，避免悬空引用
        pcall(function()
            for _, e in ipairs({ G, _G }) do
                if type(e) == "table" then
                    e.GA_Toggle, e.GA_SetDelay, e.GA_SetRange, e.GA_List = nil, nil, nil, nil
                end
            end
        end)
        return true
    end

    -- 兼容原脚本的 _G.GA_* 控制台命令（整合进主脚本后旧命令仍可用）
    pcall(function()
        local envs = { G }
        if _G and _G ~= G then envs[#envs + 1] = _G end
        for _, e in ipairs(envs) do
            e.GA_Toggle   = function() return B.SetEnabled(not B.Enabled) end
            e.GA_SetDelay = function(s) return B.SetDelay(s) end
            e.GA_SetRange = function(d) return B.SetRange(d) end
            e.GA_List     = function() print(B.Dump()) end
        end
    end)

    pcall(function() getRemote() end)
    pcall(function()
        print("[GUNBOT] 已加载 v15 | 远程 " .. (B.RemoteOK and "OK" or "NA")
            .. " | 模式 " .. B.Mode .. " | 默认关 | 诊断 GUNBOT.Dump()")
    end)
end

-- ============================================================
-- 自动技能 v16（当自己是 SCP 时范围内有玩家才发对应攻击 · 只发包不转向）
-- ============================================================
do
    if G.AUTOSKILL and G.AUTOSKILL.Off then pcall(function() G.AUTOSKILL.Off() end) end
    G.AUTOSKILL = nil

    local Players = game:GetService("Players")
    local RS      = game:GetService("ReplicatedStorage")
    local WS      = game:GetService("Workspace")
    local RUS     = game:GetService("RunService")
    local UIS     = game:GetService("UserInputService")
    local CS      = game:GetService("CollectionService")
    local LP      = Players.LocalPlayer

    -- --------------------------------------------------------
    -- 攻击映射表：编号 -> {remote, skills, baseReach, baseCD}
    --   skills 是可选技能列表；[1] 为主攻击（默认循环发这个）
    -- --------------------------------------------------------
    local ATK = {
        ["106"] = { remote = "SCP106Action", reach = 5.2, cd = 0.9,
                    skills = { "Pierce", "Sink", "Submerge" } },
        ["173"] = { remote = "SCP173Action", reach = 5.5, cd = 0.75,
                    skills = { "Blink", "Burst" } },
        ["682"] = { remote = "SCP682Action", reach = 8.0, cd = 1.6,
                    skills = { "Devour", "Rampage" } },
        ["049"] = { remote = "SCP049Action", reach = 4.2, cd = 1.4,
                    skills = { "Touch" } },
        ["939"] = { remote = "SCP939Action", reach = 6.5, cd = 1.4,
                    skills = { "Bite" } },
        -- 096 是被动（SawFace/SawPhoto），自动发包无意义，不纳入
    }

    -- --------------------------------------------------------
    -- 状态表（UI 直接读写）
    -- --------------------------------------------------------
    local S = {
        Enabled     = false,   -- 总开关，默认关
        SkillIdx    = 1,       -- 当前技能索引（1=主攻击）
        RangeScale  = 1.0,     -- 范围倍率（在 baseReach 上乘）
        Delay       = 0,       -- 额外发包间隔（0=用该SCP冷却）
        ShowFloat   = true,    -- 手机浮动按钮
        -- 诊断
        MySCP    = "无",
        Target   = "无",
        InRange  = 0,
        Fires    = 0,
        Errors   = 0,
        Status   = "待命（默认关闭）",
        RemoteOK = false,
    }
    G.AUTOSKILL = S

    local remotes = {}   -- 缓存已找到的 RemoteEvent
    local hbConn = nil
    local sg, btn = nil, nil
    local lastFire = 0

    local function lo(s) return string.lower(tostring(s or "")) end

    -- 从若干来源解析出「我是哪个 SCP 编号」（返回 "106" 这类纯数字串或 nil）
    local function detectMySCP()
        local function numOf(v)
            if v == nil then return nil end
            local t = tostring(v)
            local n = string.match(t, "SCP%-[%s]*0*(%d+)")
                   or string.match(t, "SCP[_]?0*(%d+)")
                   or string.match(t, "0*(%d+)")
            if n and ATK[n] then return n end
            -- 纯 "scp" 但无编号：看标签
            return nil
        end
        -- ① 复用主脚本 classifySCP（若已加载）
        if type(G.classifySCP) == "function" then
            local ok, lbl = pcall(function() return G.classifySCP(LP.Character) end)
            if ok and lbl then
                local n = numOf(lbl)
                if n then return n end
            end
        end
        -- ② 角色/玩家属性 + 标签兜底
        local ch = LP.Character
        local fields = {}
        local function push(v) if v ~= nil and tostring(v) ~= "" then fields[#fields+1] = tostring(v) end end
        push(LP:GetAttribute("Class")); push(LP:GetAttribute("Role"))
        push(LP:GetAttribute("SCP")); push(LP:GetAttribute("CurrentSCP"))
        push(LP:GetAttribute("PlayingAs"))
        if ch then
            for _, k in ipairs({ "Class", "Role", "SCP", "Form", "Controller" }) do
                pcall(function() push(ch:GetAttribute(k)) end)
            end
            pcall(function()
                for _, t in ipairs(CS:GetTags(ch)) do push(t) end
            end)
        end
        for _, f in ipairs(fields) do
            local n = numOf(f)
            if n then return n end
        end
        return nil
    end

    local function getRemote(name)
        if remotes[name] then return remotes[name] end
        local ok, r = pcall(function() return RS:WaitForChild("Remotes"):WaitForChild(name, 3) end)
        if ok and r then
            remotes[name] = r
            S.RemoteOK = true
            return r
        end
        return nil
    end

    -- 范围内是否有别的玩家角色（返回目标名、距离）
    local function findTarget(myRoot, reach)
        local bestName, bestD = nil, reach
        local myTeamRiot = isRiotMode() and teamOfPlayer(LP) or nil
        for _, p in ipairs(Players:GetPlayers()) do
            -- 暴乱模式：跳过同队玩家
            local skip = false
            if p ~= LP then
                -- 旁观者（Ghost）永不作为技能目标
                if isGhostSpec(p) then skip = true end
                if myTeamRiot then
                    local pT = teamOfPlayer(p)
                    if pT and pT == myTeamRiot then skip = true end
                end
            else
                skip = true
            end
            if not skip then
                local ok, ch = pcall(function() return p.Character end)
                if ok and ch then
                    local part = ch:FindFirstChild("HumanoidRootPart") or ch.PrimaryPart
                    if part and part:IsA("BasePart") then
                        local d = (part.Position - myRoot.Position).Magnitude
                        -- 用碰撞箱尺寸放宽一点（角色半径约 2~3）
                        local hum = ch:FindFirstChildOfClass("Humanoid")
                        local rad = 0
                        if hum then rad = math.min(hum.HipHeight or 2, 4) end
                        if d - rad <= bestD then
                            bestD = d - rad
                            bestName = p.Name
                        end
                    end
                end
            end
        end
        return bestName, bestD
    end

    local function fire()
        local n = detectMySCP()
        if not n then
            S.Status = "你当前不是受支持的 SCP（106/173/682/049/939）"
            S.MySCP = "无"; S.InRange = 0; S.Target = "无"
            return false, "非SCP"
        end
        local cfg = ATK[n]
        S.MySCP = "SCP-" .. n
        if not (cfg and cfg.skills[S.SkillIdx]) then return false, "无技能" end
        local rem = getRemote(cfg.remote)
        if not rem then
            S.Status = "远程未找到：" .. cfg.remote
            return false, "无远程"
        end
        local ch = LP.Character
        local root = ch and (ch:FindFirstChild("HumanoidRootPart") or ch.PrimaryPart)
        if not root then return false, "无角色" end

        local reach = cfg.reach * S.RangeScale
        local name, d = findTarget(root, reach)
        S.InRange = name and 1 or 0
        S.Target = name or "无"
        if not name then
            S.Status = "SCP-" .. n .. " · 范围内无目标（" .. string.format("%.1f", reach) .. "m）"
            return false, "范围内无目标"
        end

        local cd = math.max(cfg.cd, S.Delay or 0)
        local now = os.clock()
        if now - lastFire < cd then
            S.Status = "SCP-" .. n .. " · 目标 " .. name .. " · 冷却中"
            return false, "冷却中"
        end

        local skill = cfg.skills[S.SkillIdx]
        local ok, err = pcall(function() rem:FireServer(skill) end)
        if ok then
            lastFire = now
            S.Fires = S.Fires + 1
            S.Status = "SCP-" .. n .. " · 已发 " .. skill .. " → " .. name
            return true, name
        end
        S.Errors = S.Errors + 1
        S.Status = "发包失败：" .. tostring(err)
        return false, tostring(err)
    end

    -- 主循环：Heartbeat 检测 + 自动发包
    local function startLoop()
        if hbConn then hbConn:Disconnect() end
        hbConn = RUS.Heartbeat:Connect(function()
            if not S.Enabled then return end
            local n = detectMySCP()
            if not n then
                S.MySCP = "无"; S.InRange = 0; S.Target = "无"
                S.Status = "等待成为 SCP（106/173/682/049/939）"
                return
            end
            local cfg = ATK[n]
            local ch = LP.Character
            local root = ch and (ch:FindFirstChild("HumanoidRootPart") or ch.PrimaryPart)
            if not (cfg and root) then return end
            local reach = cfg.reach * S.RangeScale
            local name = findTarget(root, reach)
            S.MySCP = "SCP-" .. n
            S.InRange = name and 1 or 0
            S.Target = name or "无"
            if name then
                local cd = math.max(cfg.cd, S.Delay or 0)
                if os.clock() - lastFire >= cd then pcall(fire) end
            else
                S.Status = "SCP-" .. n .. " · 范围内无目标（" .. string.format("%.1f", reach) .. "m）"
            end
        end)
    end

    -- 手机浮动大按钮
    local function buildFloat()
        pcall(function() if sg then sg:Destroy() end end)
        sg = nil; btn = nil
        if not S.ShowFloat then return end
        local ok = pcall(function()
            sg = Instance.new("ScreenGui")
            sg.Name = "AutoSkillFloat"
            sg.ResetOnSpawn = false
            sg.DisplayOrder = 55
            local pg = LP:WaitForChild("PlayerGui")
            sg.Parent = pg
            btn = Instance.new("TextButton")
            btn.Size = UDim2.new(0, 130, 0, 52)
            btn.Position = UDim2.new(1, -140, 0.55, 0)
            btn.AnchorPoint = Vector2.new(1, 0)
            btn.Text = "技能 关"
            btn.Font = Enum.Font.GothicBold
            btn.TextSize = 18
            btn.TextColor3 = Color3.new(1, 1, 1)
            btn.BackgroundColor3 = Color3.fromRGB(120, 40, 40)
            btn.BackgroundTransparency = 0.15
            btn.Parent = sg
            local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0, 12); corner.Parent = btn
            btn.MouseButton1Click:Connect(function()
                S.SetEnabled(not S.Enabled)
            end)
        end)
        if not ok then
            pcall(function() if sg then sg:Destroy() end end)
            sg, btn = nil, nil
        end
    end

    -- 对外接口
    S.SetEnabled = function(v)
        S.Enabled = v and true or false
        if btn then
            btn.Text = S.Enabled and ("技能 开\n" .. S.MySCP) or "技能 关"
            btn.BackgroundColor3 = S.Enabled and Color3.fromRGB(40, 130, 70) or Color3.fromRGB(120, 40, 40)
        end
        S.Status = S.Enabled and "已开启 · 检测范围内玩家" or "待命（默认关闭）"
        return S.Enabled
    end
    S.SetSkill = function(i)
        local n = detectMySCP()
        local cfg = n and ATK[n]
        local max = cfg and #cfg.skills or 3
        S.SkillIdx = ((tonumber(i) or 1) - 1) % max + 1
        return S.SkillIdx
    end
    S.CycleSkill = function() return S.SetSkill(S.SkillIdx + 1) end
    S.SetRangeScale = function(v) S.RangeScale = math.max(0.2, math.min(5, tonumber(v) or 1)) end
    S.SetDelay = function(v) S.Delay = math.max(0, tonumber(v) or 0) end
    S.SetFloat = function(v)
        S.ShowFloat = v and true or false
        buildFloat()
    end
    S.FireNow = function() return fire() end
    S.ResetCount = function() S.Fires, S.Errors = 0, 0 end
    S.Dump = function()
        local lines = {
            "=== AutoSkill ===",
            string.format("Enabled=%s MySCP=%s Skill=#%d InRange=%d Target=%s",
                tostring(S.Enabled), S.MySCP, S.SkillIdx, S.InRange, S.Target),
            string.format("RangeScale=%.2f Delay=%.2f RemoteOK=%s Fires=%d Errors=%d",
                S.RangeScale, S.Delay, tostring(S.RemoteOK), S.Fires, S.Errors),
            "Status=" .. tostring(S.Status),
            "技能表:",
        }
        for n, cfg in pairs(ATK) do
            lines[#lines+1] = "  SCP-" .. n .. " -> " .. cfg.remote .. " [" .. table.concat(cfg.skills, "/")
                .. "] reach=" .. cfg.reach .. " cd=" .. cfg.cd
        end
        return table.concat(lines, "\n")
    end
    S.Off = function()
        S.Enabled = false
        pcall(function() if hbConn then hbConn:Disconnect() end end)
        hbConn = nil
        pcall(function() if sg then sg:Destroy() end end)
        sg, btn = nil, nil
        if G.AUTOSKILL == S then G.AUTOSKILL = nil end
        return true
    end

    startLoop()
    buildFloat()
    print("[AUTOSKILL] 已加载 | 6种SCP范围检测 | 默认关 | 诊断 AUTOSKILL.Dump()")
end


-- ============================================================
-- SCP 移动/奔跑键显示 v16.7（已停用 IsSCP 包装 · 默认关闭）
-- ============================================================
-- 【v16.7 重大修复】v16 曾包装 TouchLayout.IsSCP() 让非173 SCP 返回 false，
--   想借此显示移动键。MCP 真机源码证实这是严重 bug：游戏
--   TouchLayout.ShowSurvivorControls() = 触屏 and not (IsSCP() or hideHud())，
--   ControlsHUD/SlideController/InterfaceController 也都读 IsSCP()。把 049 的
--   IsSCP 伪装成 false → 游戏把 049 误判为幸存者 → 切换成人类控制布局，SCP 技能槽
--   被替换成用不了的人类按键 → "当 049 无法使用任何按键"。游戏原始 IsSCP() 里
--   Role=="SCP" 就 return true，本就正确。故 v16.7 彻底停用包装，默认关闭，
--   仅保留可选的纯 GUI 可见性增强（不碰任何判定函数），确保 049 等 SCP 技能正常。
do
    local G = (type(getgenv) == "function" and getgenv()) or _G
    if G.SPRINT and G.SPRINT.Off then pcall(function() G.SPRINT.Off() end) end
    G.SPRINT = nil

    local Players = game:GetService("Players")
    local RS      = game:GetService("ReplicatedStorage")
    local CS      = game:GetService("CollectionService")
    local UIS     = game:GetService("UserInputService")
    local LP      = Players.LocalPlayer

    local M = {
        Enabled     = false,   -- v16.7 默认关闭：注入后绝不自动干预游戏判定
        Exclude173  = true,    -- 173 不显示
        Patched     = false,   -- v16.7 起恒 false：不再包装 IsSCP
        SweepHits   = 0,
        Found       = {},
        FoundSet    = {},
        Status      = "待命",
        MySCP       = "无",
        _run        = true,
        _conns      = {},
        _origIsSCP  = nil,
        _TL         = nil,
    }
    G.SPRINT = M

    local function lo(s) return string.lower(tostring(s or "")) end

    -- 我是哪个 SCP 编号（复用主脚本 classifySCP 的权威结果）
    local function mySCPNum()
        -- ① 主脚本暴露的 classifySCP -> "SCP-173"
        if type(G.classifySCP) == "function" then
            local ok, lbl = pcall(function() return G.classifySCP(LP.Character) end)
            if ok and lbl then
                local n = tostring(lbl):match("0*(%d+)")
                if n then return n end
            end
        end
        -- ② 玩家属性 SCP/Role（实测 P.SCP="049", P.Role="SCP"）
        for _, k in ipairs({ "SCP", "Role", "CurrentSCP", "PlayingAs" }) do
            local v = LP:GetAttribute(k)
            if v ~= nil then
                local n = tostring(v):match("0*(%d+)")
                if n then return n end
            end
        end
        -- ③ 角色标签 SCP106/SCP173/...
        local ch = LP.Character
        if ch then
            local ok, tags = pcall(function() return CS:GetTags(ch) end)
            if ok and type(tags) == "table" then
                for _, t in ipairs(tags) do
                    local n = tostring(t):match("SCP%-?0*(%d+)")
                    if n then return n end
                end
            end
        end
        return nil
    end

    local function isMySCP()
        if tostring(LP:GetAttribute("Role") or ""):upper() == "SCP" then return true end
        if mySCPNum() then return true end
        return false
    end

    -- 是否希望显示移动/奔跑键：是 SCP、非 173、且模块开启
    local function wantSprint()
        if not M.Enabled then return false end
        if not isMySCP() then return false end
        if M.Exclude173 and mySCPNum() == "173" then return false end
        return true
    end

    -- v16.7：彻底停用对 TouchLayout.IsSCP 的包装（那会让 049 被误判成人类、技能全废）。
    -- 只做只读诊断：记录 IsSCP 当前实现指纹，若检测到被旧版脚本包装过则尝试还原。
    local function patchTouchLayout()
        local ok, TL = pcall(function()
            local sm = RS:FindFirstChild("SharedModules")
            local m  = sm and sm:FindFirstChild("TouchLayout")
            if not m or not m:IsA("ModuleScript") then return nil end
            return require(m)
        end)
        if not ok or type(TL) ~= "table" or type(TL.IsSCP) ~= "function" then
            M.Status = "TouchLayout 不可用（不修改任何判定）"
            return
        end
        M._TL = TL
        M._origIsSCP = TL.IsSCP
        M.Patched = false  -- v16.7 起永不包装
        M.Status = "只读诊断（IsSCP 未被修改，SCP 技能不受影响）"
    end

    -- 兜底路径：低频钳制 GUI 可见性
    local KEYWORDS = { "sprint", "run", "move", "joystick", "thumb", "slide", "奔跑", "冲刺", "移动" }
    local function looksLikeMove(inst)
        local nm = lo(inst.Name)
        for _, k in ipairs(KEYWORDS) do if nm:find(k, 1, true) then return true end end
        local hit = false
        pcall(function()
            if inst:IsA("TextButton") or inst:IsA("TextLabel") or inst:IsA("ImageButton") then
                local t = lo(inst.Text or "")
                for _, k in ipairs(KEYWORDS) do if t:find(k, 1, true) then hit = true break end end
            end
        end)
        return hit
    end
    local function forceVisible(inst)
        pcall(function() if inst:IsA("GuiObject") then inst.Visible = true end end)
        local p, guard = inst.Parent, 0
        while p and guard < 8 do
            pcall(function()
                if p:IsA("ScreenGui") then p.Enabled = true
                elseif p:IsA("GuiObject") then p.Visible = true end
            end)
            p = p.Parent
            guard = guard + 1
        end
    end
    local function sweepGUI()
        local pg = LP:FindFirstChildOfClass("PlayerGui")
        if not pg then return end
        local n = 0
        pcall(function()
            for _, inst in ipairs(pg:GetDescendants()) do
                pcall(function()
                    if (inst:IsA("ImageButton") or inst:IsA("TextButton") or inst:IsA("Frame")) and looksLikeMove(inst) then
                        forceVisible(inst); n = n + 1
                        local full = inst:GetFullName()
                        if not M.FoundSet[full] then
                            M.FoundSet[full] = true
                            M.Found[#M.Found + 1] = full
                            if #M.Found > 30 then table.remove(M.Found, 1) end
                        end
                    end
                end)
            end
        end)
        M.SweepHits = n
    end

    local function tick()
        local n = mySCPNum()
        M.MySCP = n and ("SCP-" .. n) or "无"
        if wantSprint() then sweepGUI() end
    end

    -- 对外接口
    M.SetEnabled = function(v)
        M.Enabled = v and true or false
        M.Status = M.Enabled and "已开启 · 仅强制显示移动键GUI(不碰SCP判定)" or "已关闭"
        return M.Enabled
    end
    M.SetExclude173 = function(v) M.Exclude173 = v and true or false end
    M.Refresh = function() pcall(sweepGUI) end
    M.Dump = function()
        local o = {
            "=== SPRINT Dump ===",
            "Enabled=" .. tostring(M.Enabled) .. " Exclude173=" .. tostring(M.Exclude173) .. " Patched=" .. tostring(M.Patched),
            "Me=" .. M.MySCP .. " wantSprint=" .. tostring(wantSprint()),
            "Status=" .. tostring(M.Status),
            "SweepHits=" .. tostring(M.SweepHits) .. " Found=" .. tostring(#M.Found),
        }
        for i = 1, math.min(#M.Found, 6) do o[#o + 1] = "  " .. M.Found[i] end
        return table.concat(o, "\n")
    end
    M.Off = function()
        M.Enabled = false
        M._run = false
        pcall(function() if M._TL and M._origIsSCP then M._TL.IsSCP = M._origIsSCP end end)
        for _, c in ipairs(M._conns) do pcall(function() c:Disconnect() end) end
        M._conns = {}
        M.Patched = false
        if G.SPRINT == M then G.SPRINT = nil end
        return true
    end

    patchTouchLayout()
    task.spawn(function()
        while M._run do
            pcall(tick)
            task.wait(1.0)
        end
    end)
    print("[SPRINT] v16.7 已加载 · 默认关闭 · 已停用 IsSCP 包装（049 技能正常）· Patched=" .. tostring(M.Patched))
end

-- ============================================================
-- 速度控制 v16.2（可调节走路/跑步 · 以实测原速 12/28 为下限 · RenderStepped 压制）
-- ============================================================
do
    if G.SPEED and G.SPEED.Off then pcall(function() G.SPEED.Off() end) end
    G.SPEED = nil

    local SC = {
        Enabled = false,
        WalkMin = 12, RunMin = 28,        -- 检测到的原始速度（下限）
        WalkTarget = 12, RunTarget = 28,  -- 当前设定目标
        Detected = false,
        Applied = 0,
        Paused = false,
        WalkKey = "WalkSpeed",
    }
    G.SPEED = SC

    local RS = game:GetService("ReplicatedStorage")
    local RUS = game:GetService("RunService")
    local PlayersSvc = game:GetService("Players")
    local P = P or PlayersSvc.LocalPlayer
    local WS = WS or game:GetService("Workspace")
    local RC = nil
    local hum = nil
    local function getHum()
        local ch = P and P.Character
        if not ch then hum = nil return nil end
        hum = ch:FindFirstChildOfClass("Humanoid")
        return hum
    end

    -- 从 Configuration 读取原始速度，作为下限；读不到则用默认 12/28
    local function detect()
        local ok, Cfg = pcall(function() return require(RS.RunSystem.Shared.Configuration) end)
        local w, r = 12, 28
        if ok and type(Cfg) == "table" and type(Cfg.Run) == "table" then
            local cw = tonumber(Cfg.Run.WalkSpeed)
            local cr = tonumber(Cfg.Run.RunSpeed)
            if cw and cw > 0 then w = cw end
            if cr and cr > 0 then r = cr end
        end
        -- 用当前 Humanoid 实测值兜底修正（若角色在场且读到合理值）
        local h = getHum()
        if h then
            local cur = tonumber(h.WalkSpeed)
            if cur and cur >= 1 and cur <= 200 then
                -- 走路下限取 min(配置, 实测)，更贴近真实最低
                if cur < w then w = cur end
            end
        end
        SC.WalkMin, SC.RunMin = w, r
        -- 目标不低于下限
        SC.WalkTarget = math.max(SC.WalkTarget, w)
        SC.RunTarget  = math.max(SC.RunTarget, r)
        SC.Detected = true
        return w, r
    end

    -- 是否在可玩状态（有角色、活着、不在 Lobby/旁观）
    local function playable()
        local ch = P and P.Character
        if not ch or not ch.Parent then return false end
        local h = getHum()
        if not h or h.Health <= 0 then return false end
        local anc = ch.Parent
        while anc and anc ~= WS do
            local ln = string.lower(anc.Name)
            if string.find(ln, "lobby", 1, true) or string.find(ln, "spectat", 1, true) then
                return false
            end
            anc = anc.Parent
        end
        return anc == WS
    end

    -- SCP 本体判定：自己变成 SCP 时绝不写 WalkSpeed
    -- （173/106/682/049 等移速由各自 SCP 控制器驱动，被我们覆盖就会「失去原本速度」）
    local SCP_NUM_SET = {
        ["049"] = true, ["035"] = true, ["079"] = true, ["096"] = true, ["106"] = true,
        ["173"] = true, ["682"] = true, ["777"] = true, ["939"] = true, ["966"] = true,
        ["999"] = true, ["457"] = true, ["066"] = true, ["076"] = true, ["008"] = true,
        ["610"] = true, ["131"] = true,
    }
    local scpFlag, scpAt = false, 0
    local function isScpNow()
        local now = tick()
        if now - scpAt < 0.4 then return scpFlag end
        scpAt = now
        scpFlag = false
        local ch = P and P.Character
        if not ch then return false end
        -- ① 主脚本权威判定（Class/Controller/Role/SCP/Team/标签，已排除人类阵营词）
        local okC, lbl = pcall(function() return G.classifySCP and G.classifySCP(ch) end)
        if okC and lbl then scpFlag = true; return true end
        -- ② 兜底：直接读 Class / Role / SCP / CurrentSCP 属性
        for _, k in ipairs({ "Class", "Controller", "Role", "SCP", "CurrentSCP", "PlayingAs" }) do
            local okA, v = pcall(function() return ch:GetAttribute(k) end)
            if okA and v ~= nil then
                local s = string.lower(tostring(v))
                s = string.gsub(s, "[-_%s]", "")
                if SCP_NUM_SET[s] or s == "scp" or string.find(s, "scpcharacter", 1, true) then
                    scpFlag = true
                    return true
                end
            end
        end
        return false
    end

    local function isRunning()
        if not RC then
            pcall(function() RC = require(RS.RunSystem.Controllers.RunController) end)
        end
        if RC and type(RC.IsRunning) == "function" then
            local ok, v = pcall(function() return RC.IsRunning() end)
            if ok then return v and true or false end
        end
        -- 兜底：以当前 WalkSpeed 是否超过走/跑中点判断
        local h = getHum()
        if h then
            local cur = tonumber(h.WalkSpeed) or SC.WalkMin
            return cur > (SC.WalkMin + SC.RunMin) * 0.5
        end
        return false
    end

    -- 每帧压制写入（RenderStepped 在 RunSystem 之前，实测能保持）
    SC.Conn = RUS.RenderStepped:Connect(function()
        if not SC.Enabled or SC.Paused then return end
        local h = getHum()
        if not h or not playable() then return end
        -- SCP 本体：只跳过、不写速度（否则 173/106 等会失去原生移速）
        if isScpNow() then
            SC.ScpSkip = true
            return
        end
        SC.ScpSkip = false
        local target = isRunning() and SC.RunTarget or SC.WalkTarget
        if math.abs((tonumber(h.WalkSpeed) or 0) - target) > 0.05 then
            pcall(function() h.WalkSpeed = target end)
            SC.Applied = SC.Applied + 1
        end
    end)

    -- 角色重生时重新拿 Humanoid
    pcall(function()
        SC.CharConn = P.CharacterAdded:Connect(function()
            task.delay(0.5, function()
                getHum()
                if SC.Enabled then detect() end
            end)
        end)
    end)

    SC.SetWalk = function(v)
        v = tonumber(v)
        if not v then return SC.WalkTarget end
        SC.WalkTarget = math.max(SC.WalkMin, v)   -- 以检测原速为下限
        return SC.WalkTarget
    end
    SC.SetRun = function(v)
        v = tonumber(v)
        if not v then return SC.RunTarget end
        SC.RunTarget = math.max(SC.RunMin, v)     -- 以检测原速为下限
        return SC.RunTarget
    end
    SC.SetBoth = function(w, r)
        SC.SetWalk(w); SC.SetRun(r)
    end
    SC.SetEnabled = function(v)
        SC.Enabled = v and true or false
        if SC.Enabled then
            SC.Paused = false
            if not SC.Detected then detect() end
            getHum()
            warn("[SPEED] 已开启：走路下限=" .. SC.WalkMin .. " 跑步下限=" .. SC.RunMin
                 .. " 目标=" .. SC.WalkTarget .. "/" .. SC.RunTarget)
        else
            -- 关闭：还原到检测到的原始速度（自己当前是 SCP 时不还原，交给 SCP 控制器）
            local h = getHum()
            if h and not isScpNow() then pcall(function() h.WalkSpeed = SC.WalkMin end) end
            warn("[SPEED] 已关闭：WalkSpeed 还原为 " .. SC.WalkMin)
        end
    end
    SC.Detect = detect
    SC.Dump = function()
        local h = getHum()
        return table.concat({
            "=== SPEED Dump ===",
            "Enabled=" .. tostring(SC.Enabled) .. " Paused=" .. tostring(SC.Paused),
            "检测原速(下限): Walk=" .. SC.WalkMin .. " Run=" .. SC.RunMin .. " Detected=" .. tostring(SC.Detected),
            "目标速度: Walk=" .. SC.WalkTarget .. " Run=" .. SC.RunTarget,
            "当前 WalkSpeed=" .. tostring(h and h.WalkSpeed or "-") .. " IsRunning=" .. tostring(isRunning()),
            "我是SCP=" .. tostring(isScpNow()) .. " 跳过写入=" .. tostring(SC.ScpSkip == true),
            "Applied=" .. SC.Applied,
        }, "\n")
    end
    SC.Off = function()
        SC.Enabled = false
        if SC.Conn then pcall(function() SC.Conn:Disconnect() end) end
        if SC.CharConn then pcall(function() SC.CharConn:Disconnect() end) end
        local h = getHum()
        if h and not isScpNow() then pcall(function() h.WalkSpeed = SC.WalkMin end) end
        G.SPEED = nil
    end

    -- 初始检测（不开启，仅读下限）
    pcall(function() detect() end)
    print("[SPEED] 已加载 · 检测原速 Walk=" .. SC.WalkMin .. " Run=" .. SC.RunMin
          .. " · RenderStepped 压制 · 默认关闭")
end

-- ============================================================
-- 自动开门 AUTODOOR v16.6（门前直开 · fireproximityprompt 绕过按钮距离）
-- ============================================================
-- MCP 真机实证（逐条验证，非猜测）：
--   1) 门的真正开门按钮 = ProximityPrompt "DoorPrompt"，ActionText="Open"、
--      ObjectText="Door"、HoldDuration=0、MaxActivationDistance=6，挂在
--      Door.Button...PromptAttachment，attrs{SCP049Key,HandPrompt}。
--      之前误触发的是 "ClassPrompt"(Override: Close / Blast Door)——那不是开门按钮，
--      所以 Fires 一直涨门却不开。v16.6 只认 ActionText 含 open 且不含 close 的门 PP。
--   2) 执行器内置 fireproximityprompt(pp,1,true) 可即时触发 PP。真机验证：
--      站门前 fire 该 DoorPrompt → 门板 DoorPanel 滑动 6m、ActionText Open→Close（真开）；
--      距门 400m 时同样调用 → 门不动（服务器仍校验真实距离，安全、不穿门作弊）。
--   3) 距离判定用门按钮世界坐标，RangePad 默认 20m（v16.8 从8→20，真机16m仍可开门；
--      服务器仍校验真实距离，超出会被丢弃、无害。可用 AUTODOOR.SetRange(n) 调到2-50m）。
-- 策略：门列表每 2 秒缓存一次；距离检测每 3 帧跑一次（轻量、响应快）；单门冷却 0.8s。
-- 附带可拖动悬浮圆点开关(手机友好)。默认关闭零开销。
-- 对外：G.AUTODOOR.{SetEnabled,SetCooldown,SetRange,SetFloat,FireNearby,Dump,Off}
-- ============================================================
do
    if G.AUTODOOR and G.AUTODOOR.Off then pcall(function() G.AUTODOOR.Off() end) end
    G.AUTODOOR = nil

    local WS  = game:GetService("Workspace")
    local RUS = game:GetService("RunService")
    local LP  = PlayersSvc and PlayersSvc.LocalPlayer or (game:GetService("Players").LocalPlayer)

    local D = {
        Enabled   = false,   -- 默认关闭
        ShowFloat = false,   -- 悬浮圆点开关默认隐藏（面板 toggle 开启）
        Interval  = 0.15,    -- 兼容旧接口
        Cooldown  = 0.4,     -- 同一扇门触发冷却(秒)：0.8→0.4，更快连续开门
        RangePad  = 28,      -- 门前触发半径(m)：20→28（服务器校验真实距离，远了无效无害）
        Doors     = 0,       -- 当前缓存的开门按钮数
        Nearby    = 0,       -- 本轮在门前半径内的门数
        Fires     = 0,       -- 累计触发次数
        LastDoor  = "无",
        Status    = "待命（默认关闭）",
        ScanConn  = nil,
        sg        = nil,
        btn       = nil,
        floatTask = nil,
        -- 兼容旧 Dump/UI 字段
        ShownHits = 0,
        PollHits  = 0,
    }
    G.AUTODOOR = D

    -- 执行器内置函数：绕过 ProximityPrompt 客户端距离，即时触发（服务器仍校验真实距离）
    local FPP = (getgenv and getgenv().fireproximityprompt) or _G.fireproximityprompt
    local lastFire  = {}   -- [ProximityPrompt] = os.clock() 上次触发时间
    local doorCache = {}   -- {{pp=ProximityPrompt, w=Vector3}, ...}

    local function lo(s) return string.lower(tostring(s or "")) end

    -- 这是不是「真正能开的门」按钮：ActionText 含 open 且不含 close；ObjectText 含 door
    -- 排除 Override: Close / Blast Door / 刷卡器 ClassPrompt / 物资箱 / 取件
    local function isDoorOpenPP(x)
        if not x then return false end
        local ok, isDoor = pcall(function()
            if not x:IsA("ProximityPrompt") then return false end
            local act = lo(x.ActionText)
            local obj = lo(x.ObjectText)
            if not string.find(obj, "door", 1, true) then return false end
            if not string.find(act, "open", 1, true) then return false end
            if string.find(act, "close", 1, true) then return false end
            return true
        end)
        return ok and isDoor == true
    end

    -- PP 世界坐标：优先 Attachment.WorldPosition，其次父 Part
    local function ppWorld(x)
        local w
        pcall(function()
            local p = x.Parent
            if p and p:IsA("Attachment") then
                w = p.WorldPosition
            elseif p and p:IsA("BasePart") then
                w = p.Position
            elseif p and p.Parent and p.Parent:IsA("BasePart") then
                w = p.Parent.Position
            end
        end)
        return w
    end

    local function getHRP()
        local ch = LP and LP.Character
        return ch and ch:FindFirstChild("HumanoidRootPart") or nil
    end

    -- 可玩状态：有角色、活着、不在 Lobby/旁观
    local function playable()
        local ch = LP and LP.Character
        if not ch or not ch.Parent then return false end
        local hum = ch:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        local anc = ch.Parent
        while anc and anc ~= WS do
            local ln = lo(anc.Name)
            if string.find(ln, "lobby", 1, true) or string.find(ln, "spectat", 1, true) then
                return false
            end
            anc = anc.Parent
        end
        return anc == WS
    end

    -- 触发一扇门：优先 fireproximityprompt（即时、绕过按钮距离），回退 InputHold
    local function trigger(pp)
        local ok = false
        pcall(function()
            if FPP then
                FPP(pp, 0.01, true)
            else
                pp:InputHoldBegin()
                task.delay(0.05, function() pcall(function() pp:InputHoldEnd() end) end)
            end
            ok = true
        end)
        if ok then
            D.Fires = D.Fires + 1
            D.LastDoor = lo(pp.ActionText) .. "/" .. lo(pp.ObjectText)
        end
        return ok
    end

    -- 刷新门缓存（v16.10 性能重构：门是静态场景物件，全量遍历降到6秒一次，且与开箱错峰）
    -- 关键提速：先用 IsA("ProximityPrompt") 廉价过滤，避免对场景每个实例都进 pcall
    local function refreshCache()
        local list = {}
        for _, x in ipairs(WS:GetDescendants()) do
            if x:IsA("ProximityPrompt") and isDoorOpenPP(x) then
                local w = ppWorld(x)
                if w then list[#list + 1] = { pp = x, w = w, act = x.ActionText } end
            end
        end
        doorCache = list
        D.Doors = #list
    end

    -- 每 2 帧的距离检测（原4帧）：只做轻量失效检查 + 距离计算（不再每轮重跑完整 isDoorOpenPP）
    local function scan()
        if not D.Enabled or not playable() then return end
        local hrp = getHRP()
        if not hrp then return end
        local myPos, now, near = hrp.Position, os.clock(), 0
        for _, e in ipairs(doorCache) do
            local pp = e.pp
            -- 轻量失效：门被销毁/禁用/已开(ActionText变Close)则跳过；完整重判留给低频 refreshCache
            local alive = false
            pcall(function()
                alive = (pp.Parent ~= nil and pp.Enabled == true and pp.ActionText == e.act)
            end)
            if alive then
                local d = (myPos - e.w).Magnitude
                if d <= D.RangePad then
                    near = near + 1
                    if now - (lastFire[pp] or -999) >= D.Cooldown then
                        lastFire[pp] = now
                        trigger(pp)
                    end
                end
            end
        end
        D.Nearby = near
    end

    local function startScan()
        if D.ScanConn then return end
        pcall(refreshCache)
        D._acc, D._cacheT, D._dirty = 0, os.clock(), false
        -- 新出现互动按钮 → 立即标脏，下一帧就重建缓存（比原来 2s 轮询更快，稳态开销只剩 6s 一次）
        if not D.AddedConn then
            D.AddedConn = WS.DescendantAdded:Connect(function(x)
                pcall(function() if x:IsA("ProximityPrompt") then D._dirty = true end end)
            end)
        end
        D.ScanConn = RUS.Heartbeat:Connect(function()
            D._acc = (D._acc or 0) + 1
            if D._acc < 2 then return end   -- 每2帧测距
            D._acc = 0
            local t = os.clock()
            if D._dirty or t - (D._cacheT or 0) >= 6 then
                D._cacheT = t
                D._dirty = false
                pcall(refreshCache)
            end
            pcall(scan)
        end)
    end
    local function stopScan()
        if D.ScanConn then pcall(function() D.ScanConn:Disconnect() end) end
        D.ScanConn = nil
        D.Doors, D.Nearby = 0, 0
    end

    -- -------- 悬浮圆点开关（可拖动）--------
    local function refreshFloat()
        if not D.btn then return end
        local want = D.Enabled and "门\n开" or "门\n关"
        if D._lastWant == want then return end  -- v16.10：状态没变不写UI，避免每0.4s触发重绘卡顿
        D._lastWant = want
        pcall(function()
            D.btn.Text = want
            D.btn.BackgroundColor3 = D.Enabled
                and Color3.fromRGB(35, 130, 70) or Color3.fromRGB(55, 55, 62)
        end)
    end
    local function applyFloat()
        if not D.sg then return end
        pcall(function() D.sg.Enabled = D.ShowFloat end)
    end
    local function buildFloat()
        local ok = pcall(function()
            local pg = LP and LP:FindFirstChildOfClass("PlayerGui")
            if not pg then return end
            D.sg = Instance.new("ScreenGui")
            D.sg.Name = "AutoDoorUI"
            D.sg.ResetOnSpawn = false
            D.sg.IgnoreGuiInset = true
            pcall(function() D.sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling end)
            D.sg.Parent = pg
            D.btn = Instance.new("TextButton")
            D.btn.Size = UDim2.new(0, 62, 0, 62)
            D.btn.Position = UDim2.new(1, -74, 0, 90)   -- 右上角，避开其它浮动按钮
            D.btn.BackgroundColor3 = Color3.fromRGB(55, 55, 62)
            D.btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            D.btn.Font = Enum.Font.SourceSansBold
            D.btn.TextSize = 16
            D.btn.TextWrapped = true
            D.btn.AutoButtonColor = false
            D.btn.ZIndex = 10
            D.btn.Parent = D.sg
            pcall(function()
                local corner = Instance.new("UICorner")
                corner.CornerRadius = UDim.new(1, 0)
                corner.Parent = D.btn
                local stroke = Instance.new("UIStroke")
                stroke.Color = Color3.fromRGB(255, 255, 255)
                stroke.Thickness = 2
                stroke.Parent = D.btn
            end)
            local dragging, dragStart, startPos, moved = false, nil, nil, 0
            D.btn.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Touch
                   or input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = true
                    moved = 0
                    dragStart = input.Position
                    startPos = D.btn.Position
                end
            end)
            D.btn.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.Touch
                   or input.UserInputType == Enum.UserInputType.MouseMovement) and dragStart then
                    local delta = input.Position - dragStart
                    moved = math.max(moved, delta.Magnitude)
                    D.btn.Position = UDim2.new(
                        startPos.X.Scale, startPos.X.Offset + delta.X,
                        startPos.Y.Scale, startPos.Y.Offset + delta.Y)
                end
            end)
            D.btn.InputEnded:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.Touch
                   or input.UserInputType == Enum.UserInputType.MouseButton1) then
                    dragging = false
                    if moved < 12 then
                        D.SetEnabled(not D.Enabled)
                    end
                end
            end)
            applyFloat()
            refreshFloat()
        end)
        return ok and D.sg ~= nil
    end
    if not buildFloat() then
        task.spawn(function()
            for _ = 1, 12 do
                task.wait(1)
                if G.AUTODOOR ~= D then return end
                if buildFloat() then return end
            end
        end)
    end
    D.floatTask = task.spawn(function()
        while G.AUTODOOR == D do
            refreshFloat()
            task.wait(0.4)
        end
    end)

    -- -------- 对外接口 --------
    D.SetEnabled = function(v)
        D.Enabled = v and true or false
        if D.Enabled then
            startScan()
            D.Status = "开启（门前自动开 · 免碰按钮）"
            warn("[AUTODOOR] v16.6 已开启：门前 " .. D.RangePad
                .. "m 内自动触发开门按钮（免手点，服务器校验真实距离），冷却 " .. D.Cooldown .. "s")
        else
            stopScan()
            D.Status = "待命（已关闭）"
            warn("[AUTODOOR] 已关闭")
        end
        refreshFloat()
        return D.Enabled
    end
    D.SetInterval = function(n) D.Interval = math.max(0.05, tonumber(n) or 0.15); return D.Interval end
    D.SetCooldown = function(n) D.Cooldown = math.max(0.2, tonumber(n) or 0.8); return D.Cooldown end
    D.SetRange = function(n) D.RangePad = math.max(2, math.min(50, tonumber(n) or 20)); pcall(refreshCache); return D.RangePad end
    D.SetFloat = function(v)
        D.ShowFloat = v and true or false
        if D.ShowFloat and not D.sg then buildFloat() end
        applyFloat()
        return D.ShowFloat
    end
    D.FireNearby = function()
        local hrp = getHRP()
        if not hrp then return 0, "无角色" end
        local myPos, fired = hrp.Position, 0
        local now = os.clock()
        for _, e in ipairs(doorCache) do
            if isDoorOpenPP(e.pp) and (myPos - e.w).Magnitude <= D.RangePad then
                lastFire[e.pp] = now
                if trigger(e.pp) then fired = fired + 1 end
            end
        end
        return fired, "已对 " .. fired .. " 扇附近的门发包"
    end
    D.Dump = function()
        return table.concat({
            "=== AUTODOOR v16.6 Dump ===",
            "Enabled=" .. tostring(D.Enabled) .. " ShowFloat=" .. tostring(D.ShowFloat),
            "冷却=" .. tostring(D.Cooldown) .. "s 门前半径=" .. tostring(D.RangePad) .. "m",
            "门按钮(缓存)=" .. tostring(D.Doors) .. " 门前可开=" .. tostring(D.Nearby),
            "累计触发=" .. tostring(D.Fires) .. " 最近=" .. tostring(D.LastDoor),
            "触发方式=" .. (FPP and "fireproximityprompt(即时·免碰按钮)" or "InputHold(回退)"),
            "轮询=" .. (D.ScanConn and "已连" or "未连"),
            "Status=" .. tostring(D.Status),
            "判定: ActionText含open且不含close 且 ObjectText含door（排除Close/刷卡器/箱/取件）",
        }, "\n")
    end
    D.Off = function()
        D.Enabled = false
        stopScan()
        if D.floatTask then pcall(function() task.cancel(D.floatTask) end) end
        pcall(function() if D.sg then D.sg:Destroy() end end)
        D.sg, D.btn, D.floatTask = nil, nil, nil
        lastFire, doorCache = {}, {}
        G.AUTODOOR = nil
    end

    -- 控制台诊断别名
    pcall(function()
        local envs = { G }
        if _G and _G ~= G then envs[#envs + 1] = _G end
        for _, e in ipairs(envs) do
            e.AUTODOOR_DUMP   = function() print(D.Dump()) end
            e.AUTODOOR_TOGGLE = function() return D.SetEnabled(not D.Enabled) end
        end
    end)

    print("[AUTODOOR] 已加载 v16.6 · 门前直开(fireproximityprompt·免碰按钮) · 默认关闭 · AUTODOOR_DUMP()")
end

-- ============================================================
-- 自动开箱 AUTOCRATE v16.9（箱前直开 · fireproximityprompt 复用门实证）
-- ============================================================
-- 复用已被真机实证的两大组件，非猜测：
--   1) 开箱判据（同 v16.3 crateKind）：真机 Workspace.Map 中含 crate 的 Model 里，
--      只有 BedCrate1-4 / DeadEndCrate 带 ProximityPrompt(ActionText="Open",
--      ObjectText="Supply Crate") 能真开；Crate/Bunker_Crate/CrateStack/MilCrate/
--      PadlockCrate 全是无 PP 装饰箱；门是 Open/Door、电线 SupplyCable 无 PP。
--      故判据 = ActionText含open/search/loot 且不含close 且 ObjectText含crate/supply
--      （门 ObjectText=Door 被排除，装饰箱无 PP 被排除，电线无 PP 被排除）。
--   2) 触发方式（同 v16.6 门）：执行器 fireproximityprompt(pp,1,true) 即时触发，
--      绕过客户端按钮距离；服务器仍校验真实距离，超距丢弃、无害。
-- 箱子打开后开箱 PP 会被禁用/销毁，isCrateOpenPP 每轮重判 + 缓存2s刷新自动失效；
-- 单箱冷却防连发。默认关闭零开销，附可拖动悬浮圆点（手机友好）。
-- 对外：G.AUTOCRATE.{SetEnabled,SetCooldown,SetRange,SetFloat,FireNearby,Dump,Off}
-- ============================================================
do
    if G.AUTOCRATE and G.AUTOCRATE.Off then pcall(function() G.AUTOCRATE.Off() end) end
    G.AUTOCRATE = nil

    local WS  = game:GetService("Workspace")
    local RUS = game:GetService("RunService")
    local LP  = PlayersSvc and PlayersSvc.LocalPlayer or (game:GetService("Players").LocalPlayer)

    local C = {
        Enabled   = false,   -- 默认关闭
        ShowFloat = false,   -- 悬浮圆点默认隐藏
        Interval  = 0.15,    -- 兼容旧接口
        Cooldown  = 0.6,     -- 同一箱子触发冷却(秒)：1.2→0.6，更快开箱
        RangePad  = 22,      -- 箱前触发半径(m)：15→22；服务器校验真实距离
        Crates    = 0,       -- 缓存的开箱按钮数
        Nearby    = 0,       -- 本轮在半径内的箱数
        Fires     = 0,       -- 累计触发次数
        LastCrate = "无",
        Status    = "待命（默认关闭）",
        ScanConn  = nil,
        sg        = nil,
        btn       = nil,
        floatTask = nil,
    }
    G.AUTOCRATE = C

    local FPP = (getgenv and getgenv().fireproximityprompt) or _G.fireproximityprompt
    local lastFire  = {}   -- [ProximityPrompt] = os.clock()
    local crateCache = {}  -- {{pp=ProximityPrompt, w=Vector3}, ...}
    local function lo(s) return string.lower(tostring(s or "")) end

    -- 这是不是「真正能开的物资箱」按钮：开箱动作 + ObjectText含crate/supply，排除门/close/取件
    local function isCrateOpenPP(x)
        if not x then return false end
        local ok, isCrate = pcall(function()
            if not x:IsA("ProximityPrompt") then return false end
            if not x.Enabled then return false end
            local act = lo(x.ActionText)
            local obj = lo(x.ObjectText)
            if string.find(obj, "door", 1, true) then return false end  -- 排除门
            if string.find(act, "close", 1, true) then return false end -- 排除关闭
            local opens = string.find(act, "open", 1, true)
                or string.find(act, "search", 1, true)
                or string.find(act, "loot", 1, true)
            if not opens then return false end
            if string.find(obj, "crate", 1, true) or string.find(obj, "supply", 1, true) then
                return true
            end
            -- 兜底：ObjectText 没写 crate/supply 时，看祖先 Model 名字含 crate 词根（排电线）
            local anc, depth, found = x.Parent, 0, false
            while anc and depth < 8 do
                if anc:IsA("Model") then
                    local nm = lo(anc.Name)
                    if string.find(nm, "crate", 1, true)
                       and not string.find(nm, "cable", 1, true)
                       and not string.find(nm, "conduit", 1, true)
                       and not string.find(nm, "wire", 1, true) then
                        found = true
                    end
                    break
                end
                anc = anc.Parent
                depth = depth + 1
            end
            return found
        end)
        return ok and isCrate == true
    end

    local function ppWorld(x)
        local w
        pcall(function()
            local p = x.Parent
            if p and p:IsA("Attachment") then w = p.WorldPosition
            elseif p and p:IsA("BasePart") then w = p.Position
            elseif p and p.Parent and p.Parent:IsA("BasePart") then w = p.Parent.Position end
        end)
        return w
    end
    local function getHRP()
        local ch = LP and LP.Character
        return ch and ch:FindFirstChild("HumanoidRootPart") or nil
    end
    local function playable()
        local ch = LP and LP.Character
        if not ch or not ch.Parent then return false end
        local hum = ch:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        local anc = ch.Parent
        while anc and anc ~= WS do
            local ln = lo(anc.Name)
            if string.find(ln, "lobby", 1, true) or string.find(ln, "spectat", 1, true) then
                return false
            end
            anc = anc.Parent
        end
        return anc == WS
    end

    local function trigger(pp)
        local ok = false
        pcall(function()
            if FPP then FPP(pp, 0.01, true)
            else
                pp:InputHoldBegin()
                task.delay(0.05, function() pcall(function() pp:InputHoldEnd() end) end)
            end
            ok = true
        end)
        if ok then
            C.Fires = C.Fires + 1
            C.LastCrate = lo(pp.ActionText) .. "/" .. lo(pp.ObjectText)
        end
        return ok
    end

    local function refreshCache()
        local list = {}
        for _, x in ipairs(WS:GetDescendants()) do
            if x:IsA("ProximityPrompt") and isCrateOpenPP(x) then
                local w = ppWorld(x)
                if w then list[#list + 1] = { pp = x, w = w, act = x.ActionText } end
            end
        end
        crateCache = list
        C.Crates = #list
    end

    local function scan()
        if not C.Enabled or not playable() then return end
        local hrp = getHRP()
        if not hrp then return end
        local myPos, now, near = hrp.Position, os.clock(), 0
        for _, e in ipairs(crateCache) do
            local pp = e.pp
            -- 轻量失效检查：已开/被销毁的箱子自动跳过（完整重判留给低频 refreshCache）
            local alive = false
            pcall(function()
                alive = (pp.Parent ~= nil and pp.Enabled == true and pp.ActionText == e.act)
            end)
            if alive then
                local d = (myPos - e.w).Magnitude
                if d <= C.RangePad then
                    near = near + 1
                    if now - (lastFire[pp] or -999) >= C.Cooldown then
                        lastFire[pp] = now
                        trigger(pp)
                    end
                end
            end
        end
        C.Nearby = near
    end

    local function startScan()
        if C.ScanConn then return end
        pcall(refreshCache)
        C._acc, C._cacheT, C._dirty = 0, os.clock(), false
        if not C.AddedConn then
            C.AddedConn = WS.DescendantAdded:Connect(function(x)
                pcall(function() if x:IsA("ProximityPrompt") then C._dirty = true end end)
            end)
        end
        C.ScanConn = RUS.Heartbeat:Connect(function()
            C._acc = (C._acc or 0) + 1
            if C._acc < 2 then return end   -- 每2帧测距
            C._acc = 0
            local t = os.clock()
            if C._dirty or t - (C._cacheT or 0) >= 6 then
                C._cacheT = t
                C._dirty = false
                pcall(refreshCache)
            end
            pcall(scan)
        end)
    end
    local function stopScan()
        if C.ScanConn then pcall(function() C.ScanConn:Disconnect() end) end
        C.ScanConn = nil
        C.Crates, C.Nearby = 0, 0
    end

    -- -------- 悬浮圆点开关（可拖动，位于门圆点下方）--------
    local function refreshFloat()
        if not C.btn then return end
        local want = C.Enabled and "箱\n开" or "箱\n关"
        if C._lastWant == want then return end  -- 状态没变不写UI，避免每0.4s重绘卡顿
        C._lastWant = want
        pcall(function()
            C.btn.Text = want
            C.btn.BackgroundColor3 = C.Enabled
                and Color3.fromRGB(150, 120, 40) or Color3.fromRGB(55, 55, 62)
        end)
    end
    local function applyFloat()
        if not C.sg then return end
        pcall(function() C.sg.Enabled = C.ShowFloat end)
    end
    local function buildFloat()
        local ok = pcall(function()
            local pg = LP and LP:FindFirstChildOfClass("PlayerGui")
            if not pg then return end
            C.sg = Instance.new("ScreenGui")
            C.sg.Name = "AutoCrateUI"
            C.sg.ResetOnSpawn = false
            C.sg.IgnoreGuiInset = true
            pcall(function() C.sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling end)
            C.sg.Parent = pg
            C.btn = Instance.new("TextButton")
            C.btn.Size = UDim2.new(0, 62, 0, 62)
            C.btn.Position = UDim2.new(1, -74, 0, 164)  -- 门圆点(90)下方，避开
            C.btn.BackgroundColor3 = Color3.fromRGB(55, 55, 62)
            C.btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            C.btn.Font = Enum.Font.SourceSansBold
            C.btn.TextSize = 16
            C.btn.TextWrapped = true
            C.btn.AutoButtonColor = false
            C.btn.ZIndex = 10
            C.btn.Parent = C.sg
            pcall(function()
                local corner = Instance.new("UICorner")
                corner.CornerRadius = UDim.new(1, 0)
                corner.Parent = C.btn
                local stroke = Instance.new("UIStroke")
                stroke.Color = Color3.fromRGB(255, 255, 255)
                stroke.Thickness = 2
                stroke.Parent = C.btn
            end)
            local dragging, dragStart, startPos, moved = false, nil, nil, 0
            C.btn.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Touch
                   or input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging, moved = true, 0
                    dragStart, startPos = input.Position, C.btn.Position
                end
            end)
            C.btn.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.Touch
                   or input.UserInputType == Enum.UserInputType.MouseMovement) and dragStart then
                    local delta = input.Position - dragStart
                    moved = math.max(moved, delta.Magnitude)
                    C.btn.Position = UDim2.new(
                        startPos.X.Scale, startPos.X.Offset + delta.X,
                        startPos.Y.Scale, startPos.Y.Offset + delta.Y)
                end
            end)
            C.btn.InputEnded:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.Touch
                   or input.UserInputType == Enum.UserInputType.MouseButton1) then
                    dragging = false
                    if moved < 12 then C.SetEnabled(not C.Enabled) end
                end
            end)
            applyFloat()
            refreshFloat()
        end)
        return ok and C.sg ~= nil
    end
    if not buildFloat() then
        task.spawn(function()
            for _ = 1, 12 do
                task.wait(1)
                if G.AUTOCRATE ~= C then return end
                if buildFloat() then return end
            end
        end)
    end
    C.floatTask = task.spawn(function()
        while G.AUTOCRATE == C do
            refreshFloat()
            task.wait(0.4)
        end
    end)

    -- -------- 对外接口 --------
    C.SetEnabled = function(v)
        C.Enabled = v and true or false
        if C.Enabled then
            startScan()
            C.Status = "开启（箱前自动开 · 免碰按钮）"
            warn("[AUTOCRATE] v16.9 已开启：箱前 " .. C.RangePad
                .. "m 内自动触发开箱按钮（免手点，服务器校验真实距离），冷却 " .. C.Cooldown .. "s")
        else
            stopScan()
            C.Status = "待命（已关闭）"
            warn("[AUTOCRATE] 已关闭")
        end
        refreshFloat()
        return C.Enabled
    end
    C.SetInterval = function(n) C.Interval = math.max(0.05, tonumber(n) or 0.15); return C.Interval end
    C.SetCooldown = function(n) C.Cooldown = math.max(0.3, tonumber(n) or 1.2); return C.Cooldown end
    C.SetRange = function(n) C.RangePad = math.max(2, math.min(40, tonumber(n) or 15)); pcall(refreshCache); return C.RangePad end
    C.SetFloat = function(v)
        C.ShowFloat = v and true or false
        if C.ShowFloat and not C.sg then buildFloat() end
        applyFloat()
        return C.ShowFloat
    end
    C.FireNearby = function()
        local hrp = getHRP()
        if not hrp then return 0, "无角色" end
        local myPos, fired, now = hrp.Position, 0, os.clock()
        for _, e in ipairs(crateCache) do
            if isCrateOpenPP(e.pp) and (myPos - e.w).Magnitude <= C.RangePad then
                lastFire[e.pp] = now
                if trigger(e.pp) then fired = fired + 1 end
            end
        end
        return fired, "已对 " .. fired .. " 个附近的箱子发包"
    end
    C.Dump = function()
        return table.concat({
            "=== AUTOCRATE v16.9 Dump ===",
            "Enabled=" .. tostring(C.Enabled) .. " ShowFloat=" .. tostring(C.ShowFloat),
            "冷却=" .. tostring(C.Cooldown) .. "s 箱前半径=" .. tostring(C.RangePad) .. "m",
            "开箱按钮(缓存)=" .. tostring(C.Crates) .. " 附近可开=" .. tostring(C.Nearby),
            "累计触发=" .. tostring(C.Fires) .. " 最近=" .. tostring(C.LastCrate),
            "触发方式=" .. (FPP and "fireproximityprompt(即时·免碰按钮)" or "InputHold(回退)"),
            "轮询=" .. (C.ScanConn and "已连" or "未连"),
            "Status=" .. tostring(C.Status),
            "判定: open/search/loot 且 ObjectText含crate/supply（排除Door/close/装饰箱/电线）",
        }, "\n")
    end
    C.Off = function()
        C.Enabled = false
        stopScan()
        if C.floatTask then pcall(function() task.cancel(C.floatTask) end) end
        pcall(function() if C.sg then C.sg:Destroy() end end)
        C.sg, C.btn, C.floatTask = nil, nil, nil
        lastFire, crateCache = {}, {}
        G.AUTOCRATE = nil
    end

    pcall(function()
        local envs = { G }
        if _G and _G ~= G then envs[#envs + 1] = _G end
        for _, e in ipairs(envs) do
            e.AUTOCRATE_DUMP   = function() print(C.Dump()) end
            e.AUTOCRATE_TOGGLE = function() return C.SetEnabled(not C.Enabled) end
        end
    end)

    print("[AUTOCRATE] 已加载 v16.9 · 箱前直开(fireproximityprompt·免碰按钮) · 默认关闭 · AUTOCRATE_DUMP()")
end
-- ============================================================
-- 任务模式自动逃脱 AUTOESCAPE v2.2（内嵌版 · 由「全自动挂机」调度）
-- 原独立脚本 v2.2 原样保留核心逻辑，只做三处适配：
--   ① 投票关闭（AutoVote=false），统一由 AUTOFARM 投 Escape；
--   ② start/stop 加代次守卫，避免模块被反复开关后残留两条主循环；
--   ③ 外层包一层 do…end，局部变量不污染主 chunk（Lua 单函数 200 局部上限）。
-- 状态源：RS.RoundMode / RoundPhase / EscapeChecklist / EscapeTargets /
--         EscapeCarriers / EscapeExitPosition / LP.InRound / LP.Role / LP.Ghost
-- ============================================================
do
local G = getgenv()
local PlayersSvc = game:GetService("Players")

-- 【清理】恢复加速研究期间注入的实验 hook（这些 hook 会触发反作弊导致被踢）。
-- 只恢复本脚本自己 hook 过的函数，绝不动游戏其它逻辑。
pcall(function()
    if G._escapeHooked then
        local RS = game:GetService("ReplicatedStorage")
        local ev = RS and RS:FindFirstChild("Remotes") and RS.Remotes:FindFirstChild("EscapeEvent")
        if ev and restorefunction then pcall(function() restorefunction(ev.FireServer) end) end
    end
    if G._ppHooked and restorefunction and G._ppOriginal then
        pcall(function()
            restorefunction(fireproximityprompt)
            fireproximityprompt = G._ppOriginal
            G.fireproximityprompt = G._ppOriginal
        end)
    end
    G._escapeHooked = nil; G._ppHooked = nil; G._evInHooked = nil
    G._escapeLog = nil; G._ppLog = nil; G._evIn = nil; G._ppOriginal = nil
end)

do
    if G.AUTOESCAPE and G.AUTOESCAPE.Off then pcall(function() G.AUTOESCAPE.Off() end) end
    G.AUTOESCAPE = nil

    local LP = PlayersSvc.LocalPlayer
    local WS = game:GetService("Workspace")
    local RS = game:GetService("ReplicatedStorage")
    local HS = game:GetService("HttpService")
    local FPP = (getgenv and getgenv().fireproximityprompt) or _G.fireproximityprompt

    -- 【瞬间互动】fireproximityprompt 的第二个参数是"按住时长"，传 0.01 即
    -- 立刻触发、完全跳过长按动画（旧版传 pp.hold，断路器/门/电脑要按住 1~3s）
    local FIRE_HOLD = 0.01
    local function fireNow(prompt, hold)
        if not prompt or not FPP then return false end
        local ok, res = pcall(function() return FPP(prompt, hold or FIRE_HOLD, true) end)
        if ok and (res == true or res == nil) then return true end
        -- 少数执行器不吃第三参/不吃 0：回退成不带 hold
        local ok2 = pcall(function() return FPP(prompt) end)
        return ok2
    end

    -- 快速互动：任意 PP 的 hold 一开始立即 fire，跳过长按动画（用户提供脚本思路）
    local PPS = game:GetService("ProximityPromptService")
    local FastInteractConn = nil
    local function enableFastInteract()
        if FastInteractConn then return end
        FastInteractConn = PPS.PromptButtonHoldBegan:Connect(function(prompt)
            if prompt and prompt:IsA("ProximityPrompt") and FPP then
                fireNow(prompt)
            end
        end)
    end
    local function disableFastInteract()
        if FastInteractConn then
            pcall(function() FastInteractConn:Disconnect() end)
            FastInteractConn = nil
        end
    end

    local F = {
        Enabled      = false,
        AutoVote     = false,    -- 内嵌版：投票统一由 AUTOFARM 负责，避免一局投两次
        Tick         = 0.2,      -- 主循环间隔(秒) · 瞬间互动：决策更快
        NodeHold     = 17,       -- 节点触发后地板下保持时长(秒)，>15s
        HideDepth    = 12,       -- 藏身距离节点(studs)，<NODE_RANGE=16；向上藏天花板上方，防地面SCP(049/173)
        StallSec     = 6,        -- 上传停滞多少秒判定可能超范围→逐档下调藏身高度重定位
        PPRefresh    = 3,        -- PP 列表刷新间隔(秒)
        Phase        = "待命（默认关闭）",
        Current      = "无",
        Escapes      = 0,
        Votes        = 0,
        Conn         = nil,
        LoopTask     = nil,
        VotedThisPhase = false,
        CountedThisRound = false,
        LocalDone    = {},       -- v16.13：本地判定已完成的步骤文本（服务器 checklist 会滞后）
        LastExit     = nil,      -- v16.13：最近一次有效逃离坐标（诊断用）
        ExitSrc      = "无",     -- v16.13：逃离坐标来源（属性 / targets / 场景）
        _exitScanPos = nil,      -- v16.13：场景出口扫描缓存
        BadExitPos   = nil,      -- v16.21：站不住(被服务器拉回)的逃离坐标黑名单
        _badExitAt   = 0,
        LastDoorPos  = nil,      -- v16.21：最近一次金库门坐标（scene 兜底的高度基准）
        _exitScanAt  = -10,   -- 负数：保证首次立即扫描
        _ppCache     = nil,
        _ppCacheTime = 0,
        BreakerDone  = {},       -- v16.20：新版任务「3 个断路器」，记录已触发坐标，防同一面板反复拉
    }
    G.AUTOESCAPE = F

    local function lo(s) return string.lower(tostring(s or "")) end

    -- ============ 角色工具 ============
    local function getHRP()
        local ch = LP and LP.Character
        return ch and ch:FindFirstChild("HumanoidRootPart") or nil
    end
    local function getHum()
        local ch = LP and LP.Character
        return ch and ch:FindFirstChildOfClass("Humanoid") or nil
    end

    -- 温和瞬移(不锚定)：直接置位清零速度，用于触发 PP 前（真机验证锚定会阻止触发）
    local function tpSoft(pos)
        local ch = LP and LP.Character
        if not ch then return false end
        local ok = pcall(function()
            local hrp = ch:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            hrp.Anchored = false
            hrp.CFrame = CFrame.new(pos)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
        return ok
    end

    -- 锚定瞬移：先【不锚定】置位让服务器同步新位置，再【锚定】固定。
    -- 关键1：先 Anchored=true 再改 CFrame，位置不复制到服务器→SCP按旧位置击杀。
    -- 关键2：绝不 ChangeState(Physics)，那会让角色变成布娃娃躺地（视频 bug 根因）。
    local function tpAnchor(pos)
        local ch = LP and LP.Character
        if not ch then return false end
        local ok = pcall(function()
            local hrp = ch:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            -- 若已处于布娃娃/Physics，先恢复正常站立，避免躺地
            local hum = ch:FindFirstChildOfClass("Humanoid")
            if hum and hum:GetState() == Enum.HumanoidStateType.Physics then
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
            -- 1) 不锚定置位 → 物理引擎更新位置并复制到服务器
            hrp.Anchored = false
            hrp.CFrame = CFrame.new(pos)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            task.wait(0.12)          -- 等位置同步到服务器
            -- 2) 锚定在已同步的位置（不改 HumanoidState，避免布娃娃）
            hrp.Anchored = true
            hrp.CFrame = CFrame.new(pos)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
        return ok
    end

    -- ============ 逃脱状态读取 ============
    local function inEscapeRound()
        if RS:GetAttribute("RoundMode") ~= "Escape" then return false end
        if RS:GetAttribute("RoundPhase") ~= "Playing" then return false end
        if LP:GetAttribute("InRound") ~= true then return false end
        if LP:GetAttribute("Role") == "SCP" then return false end
        if LP:GetAttribute("Ghost") == true then return false end
        return true
    end

    local function readChecklist()
        local raw = RS:GetAttribute("EscapeChecklist")
        if type(raw) ~= "string" or raw == "" then return nil end
        local ok, data = pcall(function() return HS:JSONDecode(raw) end)
        if not ok or type(data) ~= "table" or type(data.steps) ~= "table" then return nil end
        return data.steps
    end

    local function readTargets()
        local raw = RS:GetAttribute("EscapeTargets")
        if type(raw) ~= "string" or raw == "" then return {} end
        local ok, data = pcall(function() return HS:JSONDecode(raw) end)
        if not ok or type(data) ~= "table" then return {} end
        local list = {}
        for _, t in ipairs(data) do
            if type(t) == "table"
                and type(t.x) == "number" and type(t.y) == "number" and type(t.z) == "number" then
                list[#list + 1] = {
                    pos   = Vector3.new(t.x, t.y, t.z),
                    label = tostring(t.label or ""),
                }
            end
        end
        return list
    end

    local function readExit()
        local v = RS:GetAttribute("EscapeExitPosition")
        if typeof(v) == "Vector3" then return v end
        return nil
    end

    -- 电梯位置：只认服务器下发的权威坐标，绝不用场景固定实例坐标。
    -- 【v2.2 严重BUG修正】曾试图读 Vault_Exit.Markers.LiftCarZone 等固定名实例来
    -- "提前"拿电梯坐标，但地图每局随机旋转/布局，实例坐标(如 -72,73,-356)与服务器
    -- 真实 EXIT(如 356,73,-24)完全不同 → 传送到虚空无限下坠。已彻底删除该逻辑。
    -- 现在：优先 EscapeExitPosition 属性；未下发时用 targets 里 label=EXIT 的坐标
    -- (同样是服务器权威、跟随本局布局)，二者都没有才返回 nil 让流程等待。
    local function readLiftPos()
        local v = readExit()
        if v then return v, "EscapeExitPosition" end
        -- 【v16.13】label 不再要求精确等于 "EXIT"：实际下发过 "EXIT"/"Exit"/"EXIT ZONE"
        -- 等写法，精确匹配会在门开后读不到坐标 → 角色卡在门口不去逃离。
        for _, t in ipairs(readTargets()) do
            local lb = lo(t.label)
            if lb ~= "" and (lb == "exit" or lb:find("exit", 1, true)
                or lb:find("escape", 1, true) or lb:find("lift", 1, true)
                or lb:find("elevator", 1, true)) then
                return t.pos, "targets:" .. tostring(t.label)
            end
        end
        -- 最后兜底：场景里名字明确是出口区域的 Part（5 秒最多扫一次，避免每 tick 遍历）
        -- 【v16.21 关键修复 · 「005 拿了钥匙却不开门」/「门后站死」的真凶】
        -- 旧版只要名字里有 exitzone 就直接拿来当逃离坐标，本局实际命中：
        --   Workspace.Map.Generated.Border.Vault_Exit.Markers.ExitZone @(-377,135,-72)
        -- 那是金库出口竖井【顶部】的判定标记（周围全是 ShaftWall / GatePost / Hazard，
        -- 是一段封死竖井，根本站不住），而真正的电梯在门后 y≈105。
        -- 于是 doVaultDoor 一触发钥匙就「读到出口」→ 立刻 doExit → 把人钉进竖井 12 秒，
        -- 门其实没开、清单不推进 → 现场就是「拿钥匙不开门 / 站着不动」。
        -- 现在必须同时满足：① 与门(或 targets 目标)同高 |Δy| ≤ 15
        --                   ② 水平距离门 ≤ 120 studs
        -- 不满足就返回 nil，宁可等服务器下发 EscapeExitPosition，绝不乱传。
        local now = os.clock()
        if F._exitScanPos and (now - F._exitScanAt) < 5 then
            return F._exitScanPos, "scene(缓存)"
        end
        if (now - (F._exitScanAt or 0)) >= 5 then
            F._exitScanAt = now
            local anchor = F.LastDoorPos
            if not anchor then
                for _, t in ipairs(readTargets()) do anchor = t.pos; break end
            end
            local hit = nil
            if anchor then
                pcall(function()
                    for _, d in ipairs(WS:GetDescendants()) do
                        local nm = lo(d.Name)
                        if d:IsA("BasePart")
                            and (nm:find("exitzone", 1, true) or nm:find("exittrigger", 1, true)
                                or nm:find("escapezone", 1, true) or nm:find("escaperegion", 1, true)) then
                            local pp = d.Position
                            local dx, dz = pp.X - anchor.X, pp.Z - anchor.Z
                            if math.abs(pp.X) < 5000 and math.abs(pp.Z) < 5000
                                and pp.Y > -100 and pp.Y < 2000
                                and math.abs(pp.Y - anchor.Y) <= 15
                                and (dx * dx + dz * dz) <= 14400 then   -- 水平 ≤ 120 studs
                                hit = pp
                                break
                            end
                        end
                    end
                end)
            end
            F._exitScanPos = hit
        end
        if F._exitScanPos then return F._exitScanPos, "scene" end
        return nil, nil
    end

    local function currentStep()
        local steps = readChecklist()
        if not steps then return nil end
        for _, s in ipairs(steps) do
            if type(s) == "table" and s.done ~= true then
                local raw = tostring(s.text or "")
                -- v16.13：跳过本地已判定完成的步骤（例如门已开但服务器 checklist 没置 done）
                if raw == "" or not F.LocalDone[raw] then
                    return s, lo(raw), raw
                end
            end
        end
        return nil
    end

    -- ============ PP 扫描（带缓存） ============
    -- 返回全场景 ProximityPrompt 列表 {pp, action, obj, hold, enabled, part, pos}
    -- 缓存所有 PP（含 disabled），因为节点/电脑上传开始后 PP 会变 en=false，
    -- 但仍需按位置找到它来判断进度。
    local function scanAllPPs(force)
        local now = os.clock()
        if not force and F._ppCache and (now - F._ppCacheTime) < F.PPRefresh then
            return F._ppCache
        end
        local list = {}
        -- 【关键】PP 可能挂在 Attachment 下（如断路器 BreakerPrompt.ResetBreaker）：
        -- 旧写法只找 parent 自己/直接子级 BasePart → 断路器 pos=nil，
        -- findPP 无法按距离区分三个面板，永远拿到同一个 → 第三个闸门永远触发不到、
        -- 人或钉在原地面板前不动。这里沿父级向上最多 4 层找最近的 BasePart。
        local function hostPart(of)
            local cur = of
            for _ = 1, 4 do
                if not cur or cur == WS then break end
                if cur:IsA("BasePart") then return cur end
                local bp = cur:FindFirstChildOfClass("BasePart")
                if bp then return bp end
                cur = cur.Parent
            end
            return nil
        end
        pcall(function()
            for _, d in ipairs(WS:GetDescendants()) do
                if d:IsA("ProximityPrompt") then
                    local parent = d.Parent
                    local part = hostPart(parent)
                    list[#list + 1] = {
                        pp      = d,
                        action  = lo(d.ActionText),
                        obj     = lo(d.ObjectText),
                        hold    = d.HoldDuration or 0,
                        enabled = d.Enabled,
                        part    = part,
                        pos     = part and part.Position or nil,
                    }
                end
            end
        end)
        F._ppCache = list
        F._ppCacheTime = now
        return list
    end

    -- 按 action 关键词 和/或 obj 关键词 匹配 PP，返回最近的一个
    -- onlyEnabled=true 时只返回可触发的(enabled) PP
    local function findPP(actionKey, objKey, nearPos, onlyEnabled)
        local pps = scanAllPPs()
        local best, bestDist = nil, math.huge
        for _, p in ipairs(pps) do
            if onlyEnabled and not p.enabled then
                -- 跳过
            else
                if (not actionKey or p.action:find(actionKey, 1, true))
                    and (not objKey or p.obj:find(objKey, 1, true)) then
                    local dist = 0
                    if nearPos and p.pos then dist = (p.pos - nearPos).Magnitude end
                    if dist < bestDist then
                        best, bestDist = p, dist
                    end
                end
            end
        end
        return best
    end

    -- 触发一个 PP：传送到其附近(不锚定) → fireproximityprompt
    -- explicitPos: 当 PP 挂在 Attachment 上(无 part 坐标)时，用 targets 下发的坐标
    local function triggerPP(pp, explicitPos)
        if not pp or not FPP then return false end
        -- 已经被别人触发/已禁用：直接算完成，不再空等
        local okEn, en = pcall(function() return pp.pp and pp.pp.Enabled end)
        if okEn and en == false then return true end
        local targetPos = pp.pos or explicitPos
        local ok = false
        pcall(function()
            if targetPos then
                -- 站在 PP 前方（下降 0.9 ≈ 地板），保证进入 MaxActivationDistance
                tpSoft(targetPos + Vector3.new(0, -0.9, 0))
                task.wait(0.05)          -- 只等一帧位置同步（旧版 0.35s 白等）
            end
            ok = fireNow(pp.pp)
        end)
        return ok
    end

    -- 触发"上传类"PP 并即时验证是否真正开始：
    --   真机证据：Start upload / Upload drive 触发成功后 PP.Enabled 立即变 false。
    --   失败(仍 enabled)时快速重试，不再藏起来空等 NodeHold 才发现没成功。
    local function fireUploadAndVerify(p, explicitPos, maxAttempts)
        if not p or not p.pp or not FPP then return false end
        maxAttempts = maxAttempts or 4
        for _ = 1, maxAttempts do
            -- 已 disabled → 上传已在进行，视为成功
            local ok, en = pcall(function() return p.pp.Enabled end)
            if ok and en == false then return true end
            -- 不锚定传送到 PP 前再触发
            local targetPos = p.pos or explicitPos
            pcall(function()
                if targetPos then tpSoft(targetPos + Vector3.new(0, -0.9, 0)) end
            end)
            task.wait(0.05)
            fireNow(p.pp)
            task.wait(0.12)                      -- 旧版 0.35s，瞬间互动后只需确认 disabled
            local ok2, en2 = pcall(function() return p.pp.Enabled end)
            if ok2 and en2 == false then return true end
        end
        return false
    end

    -- 拾取"记忆驱动器"类PP并验证成功：反复触发直到 PP 变 disabled 或目标从 targets 消失。
    -- 【v2.1 修正】旧 doPickupAllDrives 只触发一次就 wait(0.9) 跳过、从不验证，
    --   偶发触发失败(距离/hold/PP缓存过期)就永久漏掉 → "拿不起来，要反复几次"。
    --   真机证据同上传：拾取成功后该 PP.Enabled 立即变 false。
    -- 每次强制 scanAllPPs(true) 刷新缓存，避免拿到刚被禁用却仍缓存为 enabled 的旧PP。
    local function firePickupAndVerify(actionKey, objKey, nearPos, maxAttempts)
        maxAttempts = maxAttempts or 8
        -- 目标是否还在场（从 EscapeTargets 按坐标匹配，<4 视为同一个）
        local function targetStillThere()
            if not nearPos then return false end
            for _, t in ipairs(readTargets()) do
                if t.pos and (t.pos - nearPos).Magnitude < 4 then return true end
            end
            return false
        end
        for _ = 1, maxAttempts do
            if not targetStillThere() then return true end  -- 目标已从 targets 消失=拿起成功
            scanAllPPs(true)
            local p = findPP(actionKey, objKey, nearPos, false)  -- 不过滤 enabled，拿到后自行判
            if p and p.pp then
                local ok, en = pcall(function() return p.pp.Enabled end)
                if ok and en == false then return true end       -- 已 disabled=拿起成功
                local targetPos = p.pos or nearPos
                pcall(function()
                    if targetPos then tpSoft(targetPos + Vector3.new(0, -0.9, 0)) end
                    task.wait(0.05)
                    fireNow(p.pp)
                end)
                task.wait(0.12)                 -- 旧版 0.5s；瞬间触发后 PP 立刻 disabled
                local ok2, en2 = pcall(function() return p.pp.Enabled end)
                if ok2 and en2 == false then return true end
            end
        end
        return not targetStillThere()
    end

    -- 上传保持：锚定在屏幕【正上方】HideDepth，直到 isDone() 为真。
    -- 【v2.1 修正 · 真机实证】删除旧的"停滞超时→逐档降高 12→8→4→0"逻辑：
    --   上传本身就需要 15s(NODE_UPLOAD_SECONDS)，而旧 StallSec=6 会把正常的
    --   "还没上传完"误判成停滞，导致角色一路降到屏幕位置(地面高度)暴露被杀。
    --   真机连续采样已复现 y:115.6→111.6(高度8)→107.6(高度4)→103.6(高度0)。
    --   且上传 PP 挂在 Screen 上，坐标与节点坐标一致，藏上方 12 时球形距离
    --   仅 12 < NODE_RANGE 16，本就在范围内——降档根本无助于"不在范围内"。
    -- 新策略：固定安全高度 + 每 8s 原地重同步(不锚定置位→锚定)防服务器位置
    --   漂移；仅当位置真的漂移>3 才重定位。超时未完成交主循环下一轮重触发。
    local function holdUpload(screenPos, maxWait, isDone)
        if not screenPos then return false end
        local hidePos = screenPos + Vector3.new(0, F.HideDepth, 0)
        tpAnchor(hidePos)
        local start = os.clock()
        local resync = start
        while os.clock() - start < maxWait do
            if not F.Enabled or not inEscapeRound() then break end
            if isDone() then return true end
            -- 每 8s 原地重同步一次，高度不变，绝不往下掉（防服务器位置漂移 pause）
            if os.clock() - resync >= 8 then
                tpAnchor(hidePos)
                resync = os.clock()
            end
            local hrp = getHRP()
            if hrp and (not hrp.Anchored or (hrp.Position - hidePos).Magnitude > 3) then
                tpAnchor(hidePos)
            end
            task.wait(F.Tick)
        end
        return isDone()
    end

