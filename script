-- ============================================================
-- 无限体力（旁观安全版 · 默认关闭）
-- 之前「旁观状态卡死」最大嫌疑 = 本模块无条件改写
--   RunController.StaminaFraction = function() return 1 end
-- 让重生/退出旁观的状态机一直读到「满体力」而失同步。
-- 防护：
--   ① 默认关闭，必须 UI 手动开启，绝不隐式生效；
--   ② 仅当角色「活着且在场景内」才改写；死亡/消失/进入旁观
--      立即 unhook + 还原数值与原函数，重生后再恢复；
--   ③ G.INF_STAMINA.Off() 可彻底断开并还原一切。
-- 对外接口：G.INF_STAMINA.{SetEnabled, SetMax, Off, Enabled}
-- ============================================================
do
    if G.INF_STAMINA and G.INF_STAMINA.Off then pcall(function() G.INF_STAMINA.Off() end) end
    G.INF_STAMINA = nil

    local RS = game:GetService("ReplicatedStorage")
    local RC = nil
    local f = nil

    local ST = {
        Enabled = false,          -- 默认关闭
        Max = 10000000,
        Applied = 0, Orig = {},
        Hooked = false, Paused = false,
    }
    G.INF_STAMINA = ST

    local function ensureRC()
        if RC then return true end
        local ok, r = pcall(function() return require(RS.RunSystem.Controllers.RunController) end)
        if ok and r then
            RC = r
            f = RC.StaminaFraction
            ST.OrigRCFraction = f
            return true
        end
        return false
    end

    local getup = nil
    pcall(function() if type(debug) == "table" then getup = debug.getupvalue end end)
    if type(getup) ~= "function" and type(getupvalue) == "function" then getup = getupvalue end

    local function eachStamina(cb)
        if not f or type(getup) ~= "function" then return end
        local i = 1
        while i <= 16 do
            local ok, v = pcall(function() return getup(f, i) end)
            if not ok or v == nil then break end
            if type(v) == "table" then
                local sub = rawget(v, "Stamina")
                if type(sub) == "table" then pcall(function() cb(sub) end) end
            end
            i = i + 1
        end
    end

    -- 「可玩」= 有角色、Humanoid 存活、且角色挂在游戏场景（非 Lobby/旁观容器）
    local function playable()
        local ch = P and P.Character
        if not ch or not ch.Parent then return false end
        local hum = ch:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        local anc = ch.Parent
        while anc and anc ~= WS do
            local ln = string.lower(anc.Name)
            if string.find(ln, "lobby", 1, true) or string.find(ln, "spectat", 1, true) then
                return false
            end
            anc = anc.Parent
        end
        return anc == WS
    end

    local function restoreValues()
        for t, o in pairs(ST.Orig) do
            pcall(function()
                if o.V ~= nil then rawset(t, "Value", o.V) end
                if o.M ~= nil then rawset(t, "Maximum", o.M) end
                if o.X ~= nil then rawset(t, "Max", o.X) end
            end)
        end
        ST.Orig = {}
    end

    local function unhook()
        if ST.Hooked then
            pcall(function() if RC then RC.StaminaFraction = ST.OrigRCFraction end end)
            ST.Hooked = false
        end
    end

    local function apply()
        if not ST.Enabled or ST.Paused or not playable() then return end
        if not ensureRC() then return end
        local big = ST.Max or 10000000
        eachStamina(function(t)
            local hasV = type(rawget(t, "Value")) == "number"
            local hasM = type(rawget(t, "Maximum")) == "number"
            local hasX = type(rawget(t, "Max")) == "number"
            if not (hasV or hasM or hasX) then return end
            if ST.Orig[t] == nil then
                ST.Orig[t] = { V = rawget(t, "Value"), M = rawget(t, "Maximum"), X = rawget(t, "Max") }
            end
            if hasV then rawset(t, "Value", big) end
            if hasM then rawset(t, "Maximum", big) end
            if hasX then rawset(t, "Max", big) end
            ST.Applied = ST.Applied + 1
        end)
        if not ST.Hooked and RC then
            local ok = pcall(function() RC.StaminaFraction = function(...) return 1 end end)
            if ok then ST.Hooked = true end
        end
    end

    local function pause()
        if ST.Paused then return end
        ST.Paused = true
        unhook()
        restoreValues()
    end

    local function resume()
        if not ST.Paused then return end
        ST.Paused = false
        apply()
    end

    local function needsApply()
        local need = false
        local big = ST.Max or 10000000
        eachStamina(function(t)
            local m, v = rawget(t, "Maximum"), rawget(t, "Value")
            if (type(m) == "number" and m ~= big) or (type(v) == "number" and v ~= big) then
                need = true
            end
        end)
        return need
    end

    ST.SetMax = function(v)
        v = tonumber(v)
        if not v or v <= 0 then v = 10000000 end
        ST.Max = v
        apply()
    end

    ST.SetEnabled = function(v)
        ST.Enabled = v and true or false
        if ST.Enabled then
            ST.Paused = false
            if playable() then apply() else pause() end
            warn("[ESP] 无限体力已开启（旁观安全版）：死亡/旁观自动暂停")
        else
            pause()
            warn("[ESP] 无限体力已关闭（数值与原函数已还原）")
        end
    end

    ST.Off = function()
        ST.Enabled = false
        pause()
        if ST.Heartbeat then ST.Heartbeat:Disconnect() end
        if ST.Conn then ST.Conn:Disconnect() end
        if ST.DeathConn then ST.DeathConn:Disconnect() end
        G.INF_STAMINA = nil
    end

    ST.Conn = P.CharacterAdded:Connect(function(ch)
        task.delay(0.5, function() if ST.Enabled then resume(); apply() end end)
        task.delay(2,   function() if ST.Enabled then resume(); apply() end end)
        task.spawn(function()
            pcall(function()
                local hum = ch:WaitForChild("Humanoid", 5)
                if ST.DeathConn then ST.DeathConn:Disconnect() end
                if hum then ST.DeathConn = hum.Died:Connect(function() pause() end) end
            end)
        end)
    end)

    local acc = 0
    ST.Heartbeat = RUS.Heartbeat:Connect(function(dt)
        if not ST.Enabled then return end
        acc = acc + dt
        if acc < 2 then return end
        acc = 0
        if not playable() then pause(); return end
        if ST.Paused then resume() end
        if needsApply() then apply() end
    end)

    if not ensureRC() then
        warn("[ESP] 无限体力：RunController 暂不可用，模块待命（开启时会自动重试，不影响透视）")
    end
end

-- ============================================================
-- 096 拦截（防护）· 旁观安全 + 低开销版
-- 【卡顿修复】旧版三个性能杀手已移除：
--   ① 后台循环每 1.5s 调用 getgc(true) 全 Lua 堆扫描（对每个对象两次 pcall），
--      且无条件运行 → 脚本一执行就周期性卡死。现改为 ReplicatedStorage
--      一次性扫描 + DescendantAdded 增量，绝不轮询 getgc。
--   ② 全局 __namecall hook 热路径里调用 isMe096()（8 次 pcall + 属性读取），
--      游戏每帧成千上万次 namecall 全被拖慢。现状态由 2s 低频循环缓存成
--      布尔 B.Active，hook 里只读一个布尔、零 pcall。
--   ③ 关闭/观战时仍常驻 hook。现关闭即 restore() 卸载，默认零 hook 开销。
-- 旁观安全：观战/死亡/自己扮演 096 → 整体放行，退出观战不卡死。
-- 【v10 · 为什么「开着拦截仍被 096 杀死」· MCP 反编译实证】
--   旧版试图吞掉客户端自报看脸，但：
--   ① SCP096Config.Sight 里 SERVER_MAX_DISTANCE=150 / SPOT_DISTANCE=90
--      是「服务端专用」常量（客户端源码从不引用）→ 服务器独立算视线，
--      直接把 SCP096Target 写到 LocalPlayer 上（服务器权威属性）。
--   ② Slash.NON_TARGET_DAMAGE=0 / RANGE=7.5 → 只有被标记者才受伤害，
--      且伤害是服务器权威改 Humanoid.Health；SCP096Effects 里的
--      Slash/Hit/Kill 只是特效广播，不造成伤害。客户端 FireServer
--      hook 管不到服务器改血量。
--   ③ FourPixels（照片脸）是「096 玩家自己的客户端」发的技能，
--      别人发的包，你本地 hook 根本拦不到。
--   实测：hook 其实是生效的（探针 SawFace 被吞、Blocked 计数增长），
--   所以这不是代码 bug，而是「客户端吞上报」这条路本身有天花板。
--   ⇒ v10 保留拦截（精确词表、只拦 096 事件，避免误吞他人上报），
--     并补上真正能救命的：SCP096Target 变化即时预警 + 096 状态/距离透视。
-- 对外：G.BLOCK096.{SetEnabled, ResetCount, Dump, Off, Enabled, Blocked,
--        Hooked, Paused, Active, Targeted, Warned, State096, Dist096, Error, Log}
-- ============================================================
do
    if G.BLOCK096 and G.BLOCK096.Off then pcall(function() G.BLOCK096.Off() end) end
    G.BLOCK096 = nil

    local B = {
        Enabled=false, Blocked=0, Hooked=0, Log={},
        Stopped=false, Paused=false, MeIs096=false, Active=false,
        Targeted=false, Warned=0, State096="?", Dist096=-1,
        Status="待命（默认关闭）",
    }
    G.BLOCK096 = B

    local RS = game:GetService("ReplicatedStorage")
    local CS = game:GetService("CollectionService")

    local function log(s)
        B.Log[#B.Log + 1] = s
        if #B.Log > 120 then table.remove(B.Log, 1) end
    end

    -- v10 精确词表（SCP096Client 反编译实证）：客户端只会上报这 3 种
    -- 自报看脸。旧表的 "spcface" 是臆造词（源码 0 匹配），"fourpixels"
    -- 是 096 玩家自己发的技能，不该吞；WATCH_WORDS 收窄到 "096" 避免
    -- 误把别的角色含 face/photo 的 RemoteEvent 纳入白名单而误吞他人上报。
    local BLOCK_WORDS  = { "sawface", "sawphotoface", "sawphoto" }
    local WATCH_WORDS  = { "096" }
    local IGNORE_WORDS = { "pulse" }

    -- ===== v10 新增：服务器权威标记预警 + 096 状态透视 =====
    local function scan096()
        local found = nil
        pcall(function()
            for _, m in ipairs(CS:GetTagged("SCP096")) do
                if m:IsA("Model") then
                    local st = m:GetAttribute("State")
                    local root = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
                    local ch = P and P.Character
                    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
                    local d = -1
                    if root and hrp then d = (root.Position - hrp.Position).Magnitude end
                    found = { state = tostring(st or "?"), dist = d }
                    break
                end
            end
        end)
        B.State096 = found and found.state or "?"
        B.Dist096  = found and found.dist or -1
    end

    local diagConns = {}
    local function hookDiag()
        if #diagConns > 0 then return end
        pcall(function()
            table.insert(diagConns, P:GetAttributeChangedSignal("SCP096Target"):Connect(function()
                pcall(function()
                    local v = P:GetAttribute("SCP096Target") == true
                    if v and not B.Targeted then
                        B.Warned = B.Warned + 1
                        log("★ 服务器已把你标记为 096 目标！立刻拉开距离 / 进掩体")
                        B.Status = "⚠ 已被 096 锁定（服务器权威）"
                        warn("[ESP] ⚠ 你已被 SCP-096 锁定！Slash 范围 7.5m，立刻远离")
                    elseif not v and B.Targeted then
                        log("096 目标标记已解除")
                        B.Status = "监测中（标记已解除）"
                    end
                    B.Targeted = v
                end)
            end))
        end)
        -- SCP096Effects 只读诊断：绝不吞事件，仅记录服务器广播供排查
        pcall(function()
            local r = RS:FindFirstChild("Remotes")
            local e = r and r:FindFirstChild("SCP096Effects")
            if e and e:IsA("RemoteEvent") then
                table.insert(diagConns, e.OnClientEvent:Connect(function(kind)
                    if kind == "Breakout" or kind == "Kill" or kind == "FourPixels" then
                        log("服务器广播 096 事件: " .. tostring(kind))
                    end
                end))
            end
        end)
    end
    local function unhookDiag()
        for _, c in ipairs(diagConns) do pcall(function() c:Disconnect() end) end
        diagConns = {}
    end

    local function hasW(s, words)
        s = string.lower(tostring(s))
        for _, w in ipairs(words) do
            if string.find(s, w, 1, true) then return true end
        end
        return false
    end

    -- 以下两个函数只在「2s 低频状态刷新」里调用，绝不放进 hook 热路径
    local function isMe096()
        local ch = P and P.Character
        if ch then
            for _, k in ipairs({ "Class", "Controller" }) do
                local ok, v = pcall(function() return ch:GetAttribute(k) end)
                if ok and v and string.find(string.lower(tostring(v)), "096", 1, true) then return true end
            end
        end
        if P then
            for _, k in ipairs({ "Class", "Team", "Role", "SCP", "CurrentSCP", "PlayingAs" }) do
                local ok, v = pcall(function() return P:GetAttribute(k) end)
                if ok and v and string.find(string.lower(tostring(v)), "096", 1, true) then return true end
            end
        end
        return false
    end

    local function spectating()
        if not P then return false end
        local okT, team = pcall(function() return P.Team end)
        if okT and team then
            local n = string.lower(tostring(team.Name))
            if string.find(n, "spectat", 1, true) or string.find(n, "旁观", 1, true)
                or string.find(n, "观众", 1, true) or string.find(n, "lobby", 1, true)
                or string.find(n, "dead", 1, true) then return true end
        end
        for _, k in ipairs({ "Spectating", "IsSpectator", "Spectator", "Dead", "IsDead", "Alive", "Status" }) do
            local ok, v = pcall(function() return P:GetAttribute(k) end)
            if ok and v ~= nil then
                if k == "Alive" then
                    if v == false then return true end
                else
                    local sv = string.lower(tostring(v))
                    if string.find(sv, "spectat", 1, true) or string.find(sv, "旁观", 1, true)
                        or string.find(sv, "观众", 1, true) or sv == "dead" or sv == "lobby" then return true end
                end
            end
        end
        local ch = P.Character
        if ch then
            local anc = ch.Parent
            while anc and anc ~= WS do
                local n = string.lower(anc.Name)
                if string.find(n, "spectat", 1, true) or string.find(n, "lobby", 1, true)
                    or string.find(n, "dead", 1, true) then return true end
                anc = anc.Parent
            end
            local hum = ch:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health <= 0 then return true end
        end
        return false
    end

    -- 目标 RemoteEvent 白名单：弱键表，靠 RS 一次性扫描 + 增量维护，不再扫 getgc 全堆
    local TARGETS = setmetatable({}, { __mode = "k" })
    local function consider(obj)
        pcall(function()
            if obj:IsA("RemoteEvent") and hasW(obj.Name, WATCH_WORDS) then
                TARGETS[obj] = true
            end
        end)
    end
    local function recount()
        local n = 0
        for _ in pairs(TARGETS) do n = n + 1 end
        B.Hooked = n
        return n
    end
    -- 一次性扫描：只遍历 ReplicatedStorage，比全 Lua 堆小几个数量级
    local function scanTargets()
        pcall(function()
            for _, obj in ipairs(RS:GetDescendants()) do
                if obj:IsA("RemoteEvent") then consider(obj) end
            end
        end)
        recount()
    end

    local function wrap(fn)
        if type(newcclosure) == "function" then
            local ok, c = pcall(function() return newcclosure(fn) end)
            if ok and c then return c end
        end
        return fn
    end

    -- 只挂一次全局 namecall；关闭/观战即卸载，默认零常驻开销
    local hookObj, oldNC, hooked = nil, nil, false

    local function pass(self, ...)
        if oldNC then return oldNC(self, ...) end
        local m = getnamecallmethod()
        if m and self then
            local ok, f = pcall(function() return self[m] end)
            if ok and f then return f(self, ...) end
        end
        return nil
    end

    local function install()
        if hooked then return true end
        if type(hookmetamethod) ~= "function" or type(getnamecallmethod) ~= "function" then
            B.Error = "missing_api"
            return false
        end
        hookObj = nil
        for r in pairs(TARGETS) do hookObj = r; break end
        hookObj = hookObj or game
        local ok = pcall(function()
            oldNC = hookmetamethod(hookObj, "__namecall", wrap(function(self, ...)
                -- 热路径：只读一个布尔，零 pcall / 零属性读取
                if not B.Active then return pass(self, ...) end
                if getnamecallmethod() ~= "FireServer" then return pass(self, ...) end
                if not TARGETS[self] then return pass(self, ...) end
                local args = { ... }
                if not (#args == 1 and type(args[1]) == "string" and hasW(args[1], IGNORE_WORDS)) then
                    for j = 1, #args do
                        if type(args[j]) == "string" and hasW(args[j], BLOCK_WORDS) then
                            B.Blocked = B.Blocked + 1
                            log("拦截 -> " .. tostring(args[j]))
                            return nil
                        end
                    end
                end
                return pass(self, ...)
            end))
        end)
        if ok and oldNC then
            hooked = true
            B.Error = nil
            return true
        end
        B.Error = "hook_failed"
        return false
    end

    local function restore()
        if hooked and oldNC and hookObj then
            pcall(function() hookmetamethod(hookObj, "__namecall", oldNC) end)
        end
        hooked = false
        oldNC = nil
    end

    -- 低频状态刷新：仅开启时运行，2s 一次，只做纯属性读取（十几个 pcall，微秒级）
    local function refreshState()
        pcall(function()
            B.Paused  = spectating()
            B.MeIs096 = isMe096()
            scan096()
            -- 不依赖「已扫到目标」：开启先挂 hook（此时纯转发无害），
            -- 目标由 RS 扫描 / DescendantAdded 增量加入 TARGETS 后自动生效
            B.Active = B.Enabled and not B.Stopped and not B.Paused and not B.MeIs096
            if B.Active then install() else restore() end
        end)
    end

    -- 目标延迟生成时增量纳入；连接放在 refreshState 之后，避免前向引用
    B.RSConn = RS.DescendantAdded:Connect(function(obj)
        pcall(function()
            if obj:IsA("RemoteEvent") and hasW(obj.Name, WATCH_WORDS) and not TARGETS[obj] then
                TARGETS[obj] = true
                recount()
                if B.Enabled then pcall(refreshState) end
            end
        end)
    end)

    -- 后台循环：仅开启时做低频状态维护；关闭时完全不跑，零后台开销
    task.spawn(function()
        while not B.Stopped do
            if B.Enabled then pcall(refreshState) end
            task.wait(2)
        end
    end)

    B.SetEnabled = function(v)
        B.Enabled = v and true or false
        if B.Enabled then
            scanTargets()   -- 开启时一次性扫 RS（不是 getgc 全堆）
            hookDiag()      -- v10：服务器标记预警 + 096 状态透视
            B.Status = "监测中（标记预警已开）"
        else
            unhookDiag()
            B.Status = "已关闭（hook 已卸载）"
        end
        pcall(refreshState)   -- 立即刷新；关闭时 restore() 卸载 hook
        warn("[ESP] 096 拦截 " .. (B.Enabled and "已开启（含服务器标记预警）" or "已关闭（hook 已卸载）"))
    end
    B.ResetCount = function() B.Blocked = 0; B.Warned = 0 end
    B.Dump = function()
        return string.format(
            "Enabled=%s Active=%s Blocked=%d Hooked=%d Targeted=%s Warned=%d State096=%s Dist096=%.0f MeIs096=%s Paused=%s Error=%s Status=%s",
            tostring(B.Enabled), tostring(B.Active), B.Blocked, B.Hooked,
            tostring(B.Targeted), B.Warned, tostring(B.State096),
            (B.Dist096 >= 0 and B.Dist096 or -1),
            tostring(B.MeIs096), tostring(B.Paused), tostring(B.Error),
            tostring(B.Status))
    end
    B.Off = function()
        B.Stopped = true
        B.Enabled = false
        B.Active = false
        unhookDiag()
        restore()
        if B.RSConn then pcall(function() B.RSConn:Disconnect() end); B.RSConn = nil end
        TARGETS = {}
        G.BLOCK096 = nil
    end
end

-- ============================================================
-- 035 诱惑拦截（防护）· 极速版（MCP 反编译实证）
-- 【真实机制】来源 ReplicatedStorage.ClientModules.SCP035Client /
--   SharedModules.SCP035Config（本游戏 PlaceVersion 1438）
--   ① 服务器把「正在被诱惑」写在角色属性上：SCP035Bar(number)、
--      SCP035Phase、SCP035LureTarget；游戏自身 RenderStepped 就是靠
--      type(Character:GetAttribute("SCP035Bar"))=="number" 判断(第1130行)。
--   ② 玩家按 Space / ButtonA / 触摸 → 客户端执行
--      ReplicatedStorage.Remotes.SCP035Action:FireServer("Mash")
--      (第76 / 1102行)，挣脱完全由服务器累计 Mash 判定。
--   ③ Config: START_BAR=0.3, MASH_FAR/NEAR≈0.016, MASK_MASH=0.01,
--      MASK_PRESS_RATE=5, MAX_PRESSES_PER_SECOND=14, TICK=0.1。
-- 【极速策略 · 服务器几乎无反作弊】
--   检测到 SCP035Bar 出现 → 首帧立即连发 Burst(默认32)次 "Mash"
--   → 之后每个心跳(task.wait() 无参 ≈ 1/60s)续发，直到属性消失。
--   Rate=0 = 极速；SetRate(1~14) 切回限速；SetBurst(n) 调爆发量。
--   若服务端仍按 14/s 硬限流，超出部分只是被丢弃(不惩罚)，
--   客户端已打到引擎允许的最快，挣脱只会更快、不会更慢。
--   ★ 不模拟键盘/触摸(手机适用)、不 hook __namecall、不吞任何包、
--     不改本地属性或数值 → 不会重演 096 卡观战、不会卡顿。
-- 【零开销】默认关闭，不挂连接不跑循环；开启后仅一个 0.25s 轮询，
--   仅诱惑期间才发上报；结束/超时/旁观/死亡/自己扮演035 立即停。
-- 对外：G.LURE035.{SetEnabled, SetRate, SetBurst, ResetCount, Off,
--        Dump, Enabled, Active, Escapes, Mashes, Rate, Burst, Status, Error, Log}
-- ============================================================
do
    if G.LURE035 and G.LURE035.Off then pcall(function() G.LURE035.Off() end) end
    G.LURE035 = nil

    local L = {
        Enabled = false, Active = false, Stopped = false, Running = false,
        Rate = 0, Burst = 32, Escapes = 0, Mashes = 0,
        Status = "待命（默认关闭）", Error = nil, Log = {},
    }
    G.LURE035 = L

    local RS = game:GetService("ReplicatedStorage")
    local CS = game:GetService("CollectionService")
    local action = nil

    local function log(s)
        L.Log[#L.Log + 1] = s
        if #L.Log > 80 then table.remove(L.Log, 1) end
    end

    local function findAction()
        if action then return action end
        pcall(function()
            local r = RS:FindFirstChild("Remotes")
            local a = r and r:FindFirstChild("SCP035Action")
            if a and a:IsA("RemoteEvent") then action = a end
        end)
        return action
    end
    findAction()

    local function lureOn()
        local ch = P and P.Character
        if not ch then return false end
        local ok, v = pcall(function() return ch:GetAttribute("SCP035Bar") end)
        return ok and type(v) == "number"
    end

    -- 旁观 / 死亡 / 大厅 / 自己扮演 035 → 一律放行（不干预状态机）
    local function isSpectating()
        if not P then return true end
        local okT, team = pcall(function() return P.Team end)
        if okT and team then
            local n = string.lower(tostring(team.Name))
            if string.find(n, "spectat", 1, true) or string.find(n, "旁观", 1, true)
                or string.find(n, "观众", 1, true) or string.find(n, "lobby", 1, true)
                or string.find(n, "dead", 1, true) then return true end
        end
        local okC, ch = pcall(function() return P.Character end)
        if not okC or not ch then return true end
        local okH, host = pcall(function() return CS:HasTag(ch, "SCP035Host") end)
        if okH and host then return true end
        local h = ch:FindFirstChildOfClass("Humanoid")
        if h and h.Health <= 0 then return true end
        return false
    end

    local stopMash
    local function startMash()
        if L.Active or L.Stopped then return end
        if not L.Enabled then return end
        if not findAction() then return end
        if isSpectating() then return end
        L.Active = true
        L.Status = "拦截中 · 极速挣脱上报"
        log("诱惑开始：检测到 SCP035Bar（极速模式）")
        task.spawn(function()
            local t0 = os.clock()
            -- 首帧爆发：不等帧，一次性把有效 Mash 尽量打满 → 追求瞬间挣脱
            for _ = 1, L.Burst do
                if not L.Active or not L.Enabled or L.Stopped then break end
                pcall(function() action:FireServer("Mash") end)
                L.Mashes = L.Mashes + 1
            end
            while L.Active and not L.Stopped do
                if not L.Enabled then break end
                if isSpectating() then break end
                local ch = P and P.Character
                if not ch then break end
                local ok, v = pcall(function() return ch:GetAttribute("SCP035Bar") end)
                if not ok or type(v) ~= "number" then
                    L.Escapes = L.Escapes + 1
                    L.Status = "已挣脱（诱惑结束）"
                    log("诱惑结束 → 服务器判定挣脱成功")
                    stopMash(true)
                    return
                end
                local okp, ph = pcall(function() return ch:GetAttribute("SCP035Phase") end)
                if okp and ph == "Controlled" then
                    L.Status = "已被控制（拦截未赶上）"
                    log("SCP035Phase=Controlled")
                    break
                end
                if os.clock() - t0 > 30 then
                    L.Status = "超时停止（防误判）"
                    log("30s 硬超时")
                    break
                end
                pcall(function() action:FireServer("Mash") end)
                L.Mashes = L.Mashes + 1
                if L.Rate > 0 then
                    task.wait(1 / L.Rate)   -- 限速模式（1~14/s）
                else
                    task.wait()             -- 极速：仅让出一个心跳，零人为节流
                end
            end
            stopMash(false)
        end)
    end

    stopMash = function(keep)
        L.Active = false
        if not keep then
            L.Status = L.Enabled and "待命（监测中）" or "已关闭"
        end
    end

    -- 仅在开启期间运行；关闭后循环自然退出 → 零后台开销
    local function ensureLoop()
        if L.Running or L.Stopped then return end
        L.Running = true
        task.spawn(function()
            while L.Enabled and not L.Stopped do
                pcall(function()
                    if not action then findAction() end
                    if lureOn() then startMash() end
                end)
                task.wait(0.25)
            end
            L.Running = false
        end)
    end

    L.SetEnabled = function(v)
        L.Enabled = v and true or false
        if L.Enabled then
            findAction()
            -- v10 修正：`action and nil or msg` 中 true and nil == nil，会恒显示找不到
            if action then L.Error = nil else L.Error = "未找到 SCP035Action（等待生成）" end
            L.Status = L.Error or "待命（监测中）"
            ensureLoop()
            warn("[ESP] 035 诱惑拦截 已开启（极速 · 首帧" .. tostring(L.Burst) .. "连发 · 手机适用无键盘）")
        else
            stopMash(false)
            L.Status = "已关闭（零开销）"
            warn("[ESP] 035 诱惑拦截 已关闭")
        end
    end
    L.SetRate = function(n)
        n = tonumber(n) or 0
        L.Rate = (n <= 0) and 0 or math.clamp(math.floor(n), 1, 14)
    end
    L.SetBurst = function(n)
        L.Burst = math.clamp(math.floor(tonumber(n) or 32), 1, 200)
    end
    L.ResetCount = function() L.Escapes = 0; L.Mashes = 0 end
    L.Dump = function()
        local bar, ph = "nil", "nil"
        pcall(function()
            local ch = P and P.Character
            if ch then
                bar = tostring(ch:GetAttribute("SCP035Bar"))
                ph = tostring(ch:GetAttribute("SCP035Phase"))
            end
        end)
        return string.format(
            "Enabled=%s Active=%s Rate=%s Burst=%d Escapes=%d Mashes=%d Bar=%s Phase=%s Action=%s Status=%s",
            tostring(L.Enabled), tostring(L.Active),
            (L.Rate == 0 and "MAX" or tostring(L.Rate)), L.Burst,
            L.Escapes, L.Mashes, bar, ph,
            tostring(action and action:GetFullName()), tostring(L.Status))
    end
    L.Off = function()
        L.Stopped = true
        L.Enabled = false
        stopMash(false)
        G.LURE035 = nil
    end
end

-- ============================================================
-- 106 口袋空间防护 v12（零假门 · 服务器确认出口信标 · TP 出口）· MCP 真机实证
-- 内嵌版：复用主脚本的 G(getgenv) 与 P(LocalPlayer)；由「防护」栏开关控制，默认关闭、关闭即零开销。
-- ------------------------------------------------------------
-- 【v12 三条改动】①「只透视正确门」→ 默认【零门框】：服务器从不下发正确门号
--   （12 门只有 Index、门属性变化实测 0 条、每次洗牌 ⇒ 画 12 门必含 6 假门），
--   仅在「服务器 PocketExit 广播」或「手动 SetExitDoor(n)」确认时高亮唯一出口。
--   ②「自动前往出口」→ CFrame/PivotTo 瞬移到服务器确认的主世界 ExitFloor 落点。
--   ③「塌陷区自动脱离」→ 已删除（无效），仅保留只读预警。
-- 【实证】SCP106Effects.OnClientEvent("PocketExit", Vector3, "ExitFloor")：
--   坐标在主世界 y=100（如 164.62,100,31.72），门在口袋空间 x≈-3000，
--   源码 SCP106Client.lua:586 只用于「距该点<40 相机抖动」。真人被拉入→逃出时
--   同秒广播该事件，是服务器确认的安全落点。旧版「匹配最近门」从未成功。
-- 【诚实】拉入为服务器权威传送 + 权威属性，受害方无可吞 FireServer 上报；
--   CFrame 瞬移出 pocket 是否被判「逃脱」需真机验证（本服几乎无反作弊）。
-- 对外接口：G.GUARD106.{SetEnabled, SetAutoEscape, SetShowAllDoors,
--   SetExitDoor, TP, ResetCount, Off, Dump, ...}
-- ============================================================
do
    -- 复用主脚本的 G(getgenv) 与 P(LocalPlayer)
    if G.GUARD106 and G.GUARD106.Off then pcall(function() G.GUARD106.Off() end) end
    G.GUARD106 = nil

    local L = {
        Enabled = false, Stopped = false, InPocket = false, Running = false,
        AutoEscape = false,       -- v12：捕获出口后自动 TP（瞬移），默认关
        ShowAllDoors = false,     -- v12：默认零门框；true 才画 12 门(明确含假门)
        ExitDoor = nil,           -- 手动指认的门号（唯一会被高亮的门）
        ExitPos = nil,            -- 服务器 PocketExit 广播的主世界 ExitFloor 落点
        ExitTag = nil,            -- 第 3 参数 "ExitFloor"
        Doors = 0,
        Pulls = 0, Escapes = 0, TPs = 0, ExitEvents = 0, Wades = 0,
        Status = "待命（默认关闭 · 零门框）", Error = nil, Log = {},
    }
    G.GUARD106 = L

    local RS = game:GetService("ReplicatedStorage")
    local WS = game:GetService("Workspace")
    local CS = game:GetService("CollectionService")
    local effects = nil

    local HEAVY = Enum.Font.GothamBold
    pcall(function() HEAVY = Enum.Font.GothamBlack end)
    local GREEN = Color3.fromRGB(70, 225, 120)
    local AMBER = Color3.fromRGB(255, 178, 62)
    local OUTLINE = Color3.new(0, 0, 0)

    local function log(s)
        L.Log[#L.Log + 1] = s
        if #L.Log > 90 then table.remove(L.Log, 1) end
    end

    local function findEffects()
        if effects then return effects end
        pcall(function()
            local r = RS:FindFirstChild("Remotes")
            local e = r and r:FindFirstChild("SCP106Effects")
            if e and e:IsA("RemoteEvent") then effects = e end
        end)
        return effects
    end
    findEffects()

    -- 旁观 / 死亡 / 大厅 / 无角色 / 自己扮演 106 → 一律放行
    local function exempt()
        if not P then return true end
        local okT, team = pcall(function() return P.Team end)
        if okT and team then
            local n = string.lower(tostring(team.Name))
            if string.find(n, "spectat", 1, true) or string.find(n, "旁观", 1, true)
                or string.find(n, "观众", 1, true) or string.find(n, "lobby", 1, true)
                or string.find(n, "dead", 1, true) then return true end
        end
        local okS, sc = pcall(function() return P:GetAttribute("SCP") end)
        if okS and string.find(tostring(sc), "106", 1, true) then return true end
        local ch = P.Character
        if not ch then return true end
        local h = ch:FindFirstChildOfClass("Humanoid")
        if h and h.Health <= 0 then return true end
        return false
    end

    -- ================= 门 / 出口透视（v12：默认零门框）=================
    local marks = {}   -- [DoorModel] = {hl,bg,tl,portal,idx,col,label}
    local beacon = nil -- 主世界 ExitFloor 落点信标（服务器确认的唯一出口）

    local function clearMarks()
        for _, rec in pairs(marks) do
            pcall(function() if rec.hl then rec.hl:Destroy() end end)
            pcall(function() if rec.bg then rec.bg:Destroy() end end)
        end
        marks = {}
        L.Doors = 0
    end

    local function clearBeacon()
        if beacon then
            pcall(function() if beacon.part then beacon.part:Destroy() end end)
            beacon = nil
        end
    end

    local function doorList()
        local pd = WS:FindFirstChild("PocketDimension")
        local dm = pd and pd:FindFirstChild("Doors")
        if not dm then return nil end
        local out = {}
        for _, d in ipairs(dm:GetChildren()) do
            pcall(function()
                if d:IsA("Model") then
                    local portal = d:FindFirstChild("Portal")
                    if portal and portal:IsA("BasePart") then
                        out[#out + 1] = {
                            model = d, portal = portal,
                            idx = tonumber(d:GetAttribute("Index")) or 0,
                        }
                    end
                end
            end)
        end
        return out
    end

    local function addMark(d, isConfirmed, label)
        if marks[d.model] then return end
        pcall(function()
            local col = isConfirmed and GREEN or AMBER
            local hl = Instance.new("Highlight")
            hl.Name = "MCP106_HL"
            hl.Adornee = d.model
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.FillTransparency = 0.55
            hl.OutlineTransparency = 0.05
            hl.FillColor = col
            hl.OutlineColor = col
            hl.Parent = d.model

            local bg = Instance.new("BillboardGui")
            bg.Name = "MCP106_BG"
            bg.Adornee = d.portal
            bg.AlwaysOnTop = true
            bg.MaxDistance = 5000
            bg.Size = UDim2.new(0, 240, 0, 40)
            bg.StudsOffset = Vector3.new(0, 2.2, 0)
            bg.Parent = d.portal

            local tl = Instance.new("TextLabel", bg)
            tl.Size = UDim2.new(1, 0, 1, 0)
            tl.BackgroundTransparency = 1
            tl.TextStrokeTransparency = 0
            tl.TextStrokeColor3 = OUTLINE
            tl.Font = HEAVY
            tl.TextSize = 17
            tl.TextColor3 = col
            tl.Text = label

            marks[d.model] = {
                hl = hl, bg = bg, tl = tl, portal = d.portal,
                idx = d.idx, col = col, label = label,
            }
        end)
    end

    -- 策略：ShowAllDoors → 12 门琥珀(含假门)；ExitDoor → 仅那一扇绿；否则零门框
    local function ensureMarks()
        local list = doorList()
        if not list then return end
        if not L.ShowAllDoors and not L.ExitDoor then
            clearMarks()
            return
        end
        for m, rec in pairs(marks) do
            local keep = L.ShowAllDoors and true or (L.ExitDoor ~= nil and rec.idx == L.ExitDoor)
            if not keep then
                pcall(function() if rec.hl then rec.hl:Destroy() end end)
                pcall(function() if rec.bg then rec.bg:Destroy() end end)
                marks[m] = nil
            end
        end
        for _, d in ipairs(list) do
            if L.ShowAllDoors then
                addMark(d, false, "门 #" .. tostring(d.idx) .. "（真假未知）")
            elseif L.ExitDoor and d.idx == L.ExitDoor then
                addMark(d, true, "✅ 指认出口 #" .. tostring(d.idx))
            end
        end
        local n = 0
        for _ in pairs(marks) do n = n + 1 end
        L.Doors = n
    end

    -- 主世界 ExitFloor 落点信标（服务器 PocketExit 广播，唯一 100% 确认的出口）
    local function ensureBeacon()
        if not L.ExitPos then return end
        if beacon and beacon.part and beacon.part.Parent then
            pcall(function() beacon.part.Position = L.ExitPos + Vector3.new(0, 2, 0) end)
            return
        end
        pcall(function()
            local part = Instance.new("Part")
            part.Name = "MCP106_ExitBeacon"
            part.Size = Vector3.new(2, 2, 2)
            part.Position = L.ExitPos + Vector3.new(0, 2, 0)
            part.Anchored = true
            part.CanCollide = false
            part.Transparency = 1
            part.Parent = WS

            local hl = Instance.new("Highlight")
            hl.Name = "MCP106_BeaconHL"
            hl.Adornee = part
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.FillTransparency = 0.5
            hl.FillColor = GREEN
            hl.OutlineColor = GREEN
            hl.Parent = part

            local bg = Instance.new("BillboardGui", part)
            bg.Name = "MCP106_BeaconBG"
            bg.Adornee = part
            bg.AlwaysOnTop = true
            bg.MaxDistance = 100000
            bg.Size = UDim2.new(0, 300, 0, 46)
            bg.StudsOffset = Vector3.new(0, 3, 0)

            local tl = Instance.new("TextLabel", bg)
            tl.Size = UDim2.new(1, 0, 1, 0)
            tl.BackgroundTransparency = 1
            tl.TextStrokeTransparency = 0
            tl.TextStrokeColor3 = OUTLINE
            tl.Font = HEAVY
            tl.TextSize = 18
            tl.TextColor3 = GREEN
            tl.Text = "✅ 服务器确认出口 (ExitFloor)"

            beacon = { part = part, tl = tl }
        end)
    end

    local function refreshMarks()
        local myPos = nil
        pcall(function()
            local ch = P and P.Character
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            if hrp then myPos = hrp.Position end
            if not myPos and WS.CurrentCamera then myPos = WS.CurrentCamera.CFrame.Position end
        end)
        for _, rec in pairs(marks) do
            pcall(function()
                local dist = myPos and (rec.portal.Position - myPos).Magnitude or 0
                rec.tl.Text = rec.label .. "  " .. string.format("%.0fm", dist)
            end)
        end
        if beacon and beacon.tl and myPos and L.ExitPos then
            pcall(function()
                local dist = (L.ExitPos - myPos).Magnitude
                beacon.tl.Text = "✅ 服务器确认出口  " .. string.format("%.0fm", dist)
            end)
        end
    end

    -- ================= v12：TP 到出口（取代旧 MoveTo 慢跑）=================
    local lastTP = 0
    local function doTP(reason)
        if os.clock() - lastTP < 1.5 then return false end
        if not L.InPocket or L.Stopped then return false end
        if exempt() then return false end
        local ch = P and P.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end
        local target, label = nil, nil
        -- 优先：服务器确认的主世界 ExitFloor 落点（= 物理直接逃出 pocket）
        if L.ExitPos then
            target = L.ExitPos + Vector3.new(0, 3, 0)
            label = "主世界 ExitFloor " .. tostring(L.ExitPos)
        elseif L.ExitDoor then
            for _, d in ipairs(doorList() or {}) do
                if d.idx == L.ExitDoor then
                    target = d.portal.Position + Vector3.new(0, 3, 0)
                    label = "指认门 #" .. tostring(L.ExitDoor)
                    break
                end
            end
        end
        if not target then
            L.Status = "尚无确认出口（等待 PocketExit 广播 / 手动 SetExitDoor）"
            return false
        end
        local ok = false
        pcall(function()
            local cf = CFrame.new(target)
            if ch.PivotTo then ch:PivotTo(cf) else hrp.CFrame = cf end
            ok = true
        end)
        if not ok then return false end
        lastTP = os.clock()
        L.TPs = L.TPs + 1
        L.Status = "⚡ 已 TP → " .. label
        log("TP #" .. tostring(L.TPs) .. " (" .. tostring(reason) .. ") → " .. label)
        return true
    end

    -- ================= v12：塌陷区只读预警（不再自动 MoveTo 脱离）=================
    local function sinkAlert(pos, radius)
        if not L.Enabled or L.Stopped then return end
        if exempt() then return end
        L.Wades = L.Wades + 1
        L.Status = "⚠ 塌陷区/下沉预警 · 自行远离（无自动脱离）"
        log("塌陷区预警 " .. tostring(pos) .. " r=" .. tostring(radius))
    end

    local function checkCorroded()
        local ch = P and P.Character
        if not ch then return end
        pcall(function()
            if ch:GetAttribute("SCP106Corroded") == true then
                L.Status = "⚠ 正被 106 拉入（下沉中）· 即将进入口袋空间"
            end
        end)
    end

    -- ================= 口袋空间进入 / 离开 =================
    local ensureLoop
    local function enterPocket(src)
        if L.InPocket or not L.Enabled or L.Stopped then return end
        if exempt() then return end
        L.InPocket = true
        L.Pulls = L.Pulls + 1
        L.Status = "已进入口袋空间 · " .. (L.ExitPos and "出口已锁定，可 TP" or "零门框（不透视假门）")
        log("进入口袋空间(" .. tostring(src) .. ") · 默认零门框")
        pcall(ensureMarks)
        pcall(ensureBeacon)
        pcall(refreshMarks)
        ensureLoop()
        if L.AutoEscape then pcall(doTP, "自动·进入口袋") end
    end

    local function leavePocket(src, escaped)
        if not L.InPocket then return end
        L.InPocket = false
        if escaped then L.Escapes = L.Escapes + 1 end
        clearMarks()
        L.Status = escaped and "已逃出口袋空间 ✓" or "已离开口袋空间"
        log((escaped and "成功逃脱" or "离开") .. "(" .. tostring(src) .. ")")
    end

    -- ================= 事件监听（只读，绝不吞事件）=================
    local conns = {}
    local function disconnectAll()
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        conns = {}
    end

    local function hookEvents()
        if #conns > 0 then return true end
        if not findEffects() then return false end
        pcall(function()
            table.insert(conns, effects.OnClientEvent:Connect(function(...)
                local kind, a, b = ...
                local argc = select("#", ...)
                pcall(function()
                    if kind == "PocketExit" and typeof(a) == "Vector3" then
                        L.ExitPos = a
                        L.ExitTag = tostring(b)
                        L.ExitEvents = L.ExitEvents + 1
                        L.Status = "✅ 捕获服务器确认出口 (ExitFloor) #" .. tostring(L.ExitEvents)
                        log("PocketExit #" .. tostring(L.ExitEvents)
                            .. " pos=" .. tostring(a) .. " tag=" .. tostring(b)
                            .. " argc=" .. tostring(argc))
                        pcall(ensureBeacon)
                        if L.InPocket then pcall(refreshMarks) end
                        if L.AutoEscape and L.InPocket then pcall(doTP, "自动·捕获出口") end
                    elseif kind == "PocketEnter" then
                        enterPocket("PocketEnter")
                    elseif kind == "PocketLeave" then
                        leavePocket("PocketLeave", false)
                    elseif kind == "PocketEscaped" then
                        leavePocket("PocketEscaped", true)
                    elseif kind == "PocketRoom" then
                        log("PocketRoom（换房间，出口信息保留）")
                    elseif kind == "Sinkhole" then
                        log("Sinkhole 广播 " .. tostring(a) .. " r=" .. tostring(b) .. " argc=" .. tostring(argc))
                        if typeof(a) == "Vector3" then sinkAlert(a, b) end
                    elseif kind == "Pierced" then
                        log("被 106 穿刺预警 " .. tostring(a) .. " argc=" .. tostring(argc))
                    end
                end)
            end))
        end)
        pcall(function()
            table.insert(conns, P:GetAttributeChangedSignal("InPocketDimension"):Connect(function()
                pcall(function()
                    if P:GetAttribute("InPocketDimension") then
                        enterPocket("InPocketDimension")
                    else
                        leavePocket("InPocketDimension", false)
                    end
                end)
            end))
        end)
        pcall(function()
            table.insert(conns, CS:GetInstanceAddedSignal("SCP106Sinkhole"):Connect(function(obj)
                pcall(function()
                    if obj:IsA("BasePart") then
                        log("塌陷区生成 " .. obj:GetFullName())
                        sinkAlert(obj.Position, 18)
                    end
                end)
            end))
        end)
        return true
    end

    -- 单个低频循环：仅在开启期间运行，0.3s 一次、纯实例读取
    ensureLoop = function()
        if L.Running or L.Stopped then return end
        L.Running = true
        task.spawn(function()
            while L.Enabled and not L.Stopped do
                pcall(function()
                    if exempt() then return end
                    if L.InPocket then
                        pcall(ensureMarks)
                        pcall(ensureBeacon)
                        pcall(refreshMarks)
                        if L.AutoEscape and (L.ExitPos or L.ExitDoor) then
                            pcall(doTP, "自动·循环")
                        end
                    else
                        checkCorroded()
                    end
                end)
                task.wait(0.3)
            end
            L.Running = false
            if not L.Enabled then L.Status = "已关闭（零开销）" end
        end)
    end

    -- ================= 对外接口 =================
    L.SetEnabled = function(v)
        L.Enabled = v and true or false
        if L.Enabled then
            -- 注意：不能用 `ok and nil or msg`（true and nil == nil，会恒显示错误）
            if hookEvents() then
                L.Error = nil
                L.Status = "待命（零门框 · 监测 PocketExit）"
            else
                L.Error = "未找到 SCP106Effects（等待生成）"
                L.Status = L.Error
            end
            pcall(function()
                if P:GetAttribute("InPocketDimension") then
                    enterPocket("启动时已在口袋空间")
                end
            end)
            ensureLoop()
            warn("[ESP] 106 v12 已开启（零假门 / 确认出口信标 / TP 出口）")
        else
            leavePocket("手动关闭", false)
            disconnectAll()
            clearBeacon()
            L.Status = "已关闭（零开销）"
            warn("[ESP] 106 v12 已关闭")
        end
    end
    L.SetAutoEscape   = function(v) L.AutoEscape = v and true or false end
    L.SetShowAllDoors = function(v)
        L.ShowAllDoors = v and true or false
        pcall(clearMarks)
        if L.InPocket then pcall(ensureMarks) end
    end
    L.SetExitDoor = function(n)
        L.ExitDoor = tonumber(n)
        pcall(clearMarks)
        if L.InPocket then pcall(ensureMarks) end
        log("手动指认出口门 #" .. tostring(L.ExitDoor))
    end
    L.SetAutoWade = function() end   -- v12：自动脱离已移除，保留空接口兼容旧调用
    L.TP = function() return doTP("手动") end
    L.ResetCount = function()
        L.Pulls = 0; L.Escapes = 0; L.TPs = 0; L.ExitEvents = 0; L.Wades = 0
    end
    L.Dump = function()
        return string.format(
            "Enabled=%s InPocket=%s AutoEscape=%s ShowAllDoors=%s ExitDoor=%s ExitPos=%s ExitTag=%s Doors=%d ExitEvents=%d TPs=%d Pulls=%d Escapes=%d Wades=%d Effects=%s Status=%s",
            tostring(L.Enabled), tostring(L.InPocket), tostring(L.AutoEscape),
            tostring(L.ShowAllDoors), tostring(L.ExitDoor), tostring(L.ExitPos),
            tostring(L.ExitTag), L.Doors, L.ExitEvents, L.TPs,
            L.Pulls, L.Escapes, L.Wades,
            tostring(effects and effects:GetFullName()), tostring(L.Status))
    end
    L.Off = function()
        L.Stopped = true
        L.Enabled = false
        L.InPocket = false
        disconnectAll()
        clearMarks()
        clearBeacon()
        G.GUARD106 = nil
    end
end

-- ============================================================
-- 173 防护（不眨眼 · 拦截优先）· MCP 反编译实证
-- 独立模块：整段注入即可，默认自启；主脚本 SCP.lua 内已内置同一模块。
-- ------------------------------------------------------------
-- 【真实机制】来源 ReplicatedStorage.ClientModules.SCP173Client.lua /
--   SharedModules.SCP173Config.lua（游戏「[939更新] 在SCP中生存下来」
--   PlaceVersion 1438，经 Roblox MCP 反编译 + 运行时实测）
--   ① 眨眼 = 客户端【本地计时】驱动：
--      SCP173Client.lua:589 updateMeter 每帧算
--         1 - (now - last) / (Blink.INTERVAL * BlinkIntervalScale)
--      归零 → blink()(:455) → SCP173Action:FireServer("Blink")(:464)
--      + 本地把 SCP173Overlay 的 LidTop/LidBottom 合上 0.32s(黑屏)。
--      Blink.INTERVAL=4；BlinkIntervalScale（SCP-131 道具）最大 3 倍。
--      blink() 全模块仅 4 个调用点：自动计时 1 + 手动按键/点 Eye 2。
--   ② 服务器【没有】强制眨眼下发：SCP173Effects.OnClientEvent 只有
--      Moved / Snap / Burst / PowerOut / Notice 五种(:1270-1368)，
--      无任何 "Blink" 广播；SERVER_GRACE=0.75 客户端源码零引用
--      （服务端专用宽限）。→ 眨眼完全由你自己的客户端发起，
--      服务器只被动接收 "Blink" 上报。
--   ③ 注视：perceive()(:678) 每 0.2s 上报
--      SCP173Action:FireServer("Watch", bool看见173, 相机位置)；
--      服务器据此维护 173 模型上的 Observed / Watchers 属性。
--      Observed=false 时 173 才可自由移动 / 瞬移 / 扭脖击杀。
--   ④ 173 权威属性（本次在场实测）：Observed, Watchers,
--      Controller(AI/Player), TeleportReadyAt, BurstReadyAt,
--      Invulnerable, RootHeight, Pose。Burst(灯光故障 RADIUS=45/
--      DURATION=15/COOLDOWN=30) 期间 zoneAt 会让 perceive 跳过 →
--      不上报「看见」，173 被放开 —— 这是最危险的窗口。
--
-- 【为什么不 hook / 不吞包 / 不按键】
--   之前 096 卡观战的根因是全局 __namecall hook 误吞退出观战上报。
--   173 这里不需要任何 hook：MCP 实测 require(SCP173Config) 返回
--   【同一张表】(same_table=true)、Blink.INTERVAL 可写(write_ok=true)，
--   且客户端每帧【动态读】 v_u_20.INTERVAL（源码 :589，非缓存值）。
--   → 把这张共享表的 INTERVAL 改大，进度条永不归零 → blink() 永不
--   调用 → "Blink" 上报与眼皮闭合【根本不发生】。比吞包更干净：
--   不改状态机、不碰网络层、手机无键盘也适用；关闭时写回原值即
--   完整还原。全程不引入 __namecall / hookmetamethod / getgc。
--
-- 【三层防护】（v13：已移除无效的 ForceWatch，见下方诚实说明）
--   NoBlink    改共享 Config 表 INTERVAL → 永不自动眨眼/永不上报（核心）
--   FreezeLids 低频钳制眼皮 GUI → 即使别的路径触发也不黑屏（兜底）
--   Esp        173 穿墙高亮 + Observed/Watchers/距离/瞬移与爆发冷却
--              + Snap(附近扭脖) / Burst(灯光故障) 只读预警
--
-- 【诚实说明】服务端脚本未同步到 MCP（客户端不可见），SERVER_GRACE
--   提示服务器可能有自己的眨眼宽限计时，无法 100% 断言「服务器
--   完全不判眨眼」。但客户端不发 Blink 上报、不闭眼是源码实证的；
--   Esp 与预警作为兜底，让你随时知道 173 何时 Observed=false 能移动。
--   ★ v13 已移除 ForceWatch：Sight 表 CAMERA_SLACK=140 / STALE=0.9 /
--   AIM_STALE=1 / AIM_FOV=70 / MAX_AIM_DISTANCE=600 / NPC_VIEW_ANGLE
--   在客户端源码引用数均为 0（纯服务器用）；Watch(:714) 只上报相机
--   坐标不带朝向，服务器独立重算距离/视锥/遮挡，客户端补发
--   Watch(true) 无效，伪造坐标还会撞 CAMERA_SLACK 校验。
--
-- 【安全】默认关闭（本独立文件末尾自启）；旁观/死亡/无角色/
--   自己扮演 SCP 自动放行并还原 Config；关闭即还原 + 断连 + 清 ESP，
--   零后台开销；所有游戏访问 pcall 包裹。
-- 对外接口：G.GUARD173.{SetEnabled, SetNoBlink, SetFreezeLids,
--   SetEsp, SetInterval, ResetCount, Dump, Off,
--   Enabled, NoBlink, Patched, Has173, Observed, Watchers, Dist173,
--   BlinkSuppressed, BlinkDetected, Status, Log}
-- ============================================================
do
    -- 复用主脚本的 G(getgenv) 与 P(LocalPlayer)
    if G.GUARD173 and G.GUARD173.Off then pcall(function() G.GUARD173.Off() end) end
    G.GUARD173 = nil

    local RS = game:GetService("ReplicatedStorage")
    local CS = game:GetService("CollectionService")
    local WS = game:GetService("Workspace")

    local L = {
        Enabled = false, Stopped = false, Running = false, Paused = false,
        Patched = false,
        NoBlink = true,          -- 核心：改共享 Config 表 INTERVAL（零 hook）
        FreezeLids = true,       -- 兜底：钳制眼皮 GUI 不黑屏
        Esp = true,              -- 173 穿墙高亮 + 状态 + 预警
        Interval = 1000000000,   -- 改表后的「眨眼间隔」秒（等价永不）
        OrigInterval = 4,
        StartAt = 0,
        Has173 = false, Observed = nil, Watchers = 0, Controller = nil,
        Dist173 = -1, TeleportIn = -1, BurstIn = -1,
        BlinkSuppressed = 0, BlinkDetected = 0,
        SnapWarns = 0, BurstWarns = 0,
        Status = "待命（默认关闭）", Error = nil, Log = {},
    }
    G.GUARD173 = L

    local function log(s)
        L.Log[#L.Log + 1] = s
        if #L.Log > 80 then table.remove(L.Log, 1) end
    end

    -- ── 共享 Config 表：两张（普通模式 / ReusableSCPs 模式）都 patch、都还原 ──
    local configs = {}
    local function findConfigs()
        if #configs > 0 then return end
        local getters = {
            function() return RS.SharedModules.SCP173Config end,
            function() return RS.ReusableSCPsFolder.Shared.SCP173Config end,
        }
        for _, f in ipairs(getters) do
            pcall(function()
                local m = f()
                if m and m:IsA("ModuleScript") then
                    local ok, cfg = pcall(require, m)
                    if ok and type(cfg) == "table" and type(cfg.Blink) == "table" then
                        configs[#configs + 1] = { tab = cfg.Blink, orig = cfg.Blink.INTERVAL }
                    end
                end
            end)
        end
        if configs[1] and type(configs[1].orig) == "number" then
            L.OrigInterval = configs[1].orig
        end
    end

    local function patchConfig()
        findConfigs()
        if #configs == 0 then return false end
        local n = 0
        for _, c in ipairs(configs) do
            pcall(function() c.tab.INTERVAL = L.Interval; n = n + 1 end)
        end
        L.Patched = n > 0
        return L.Patched
    end

    local function restoreConfig()
        for _, c in ipairs(configs) do
            pcall(function() c.tab.INTERVAL = c.orig end)
        end
        L.Patched = false
    end

    -- ── 引用缓存 ──
    local action, effects = nil, nil
    local overlay, lids, blinkBar = nil, {}, nil
    local model173 = nil
    local marks = {}             -- [model] = { hl, bb, tl }
    local conns = {}
    local lastSeg = -1

    local function findAction()
        if action and effects then return end
        pcall(function()
            local r = RS:FindFirstChild("Remotes")
            action = r and r:FindFirstChild("SCP173Action")
            effects = r and r:FindFirstChild("SCP173Effects")
        end)
    end

    local function scan173()
        local found = nil
        pcall(function()
            local t = CS:GetTagged("SCP173")
            if #t > 0 then found = t[1] end
        end)
        if not found then pcall(function() found = WS:FindFirstChild("SCP-173") end) end
        model173 = found
        L.Has173 = found ~= nil
        return found
    end

    -- 旁观 / 死亡 / 无角色 / 自己扮演 SCP → 一律放行（并还原 Config）
    local function eligible()
        if not P then return false end
        local bad = false
        pcall(function()
            if P:GetAttribute("Role") == "SCP" or P:GetAttribute("SCP") ~= nil then
                bad = true; return
            end
            local t = P.Team
            if t then
                local n = string.lower(tostring(t.Name))
                if string.find(n, "spectat", 1, true) or string.find(n, "旁观", 1, true)
                    or string.find(n, "观众", 1, true) or string.find(n, "lobby", 1, true)
                    or string.find(n, "dead", 1, true) then bad = true; return end
            end
            local ch = P.Character
            if not ch then bad = true; return end
            local h = ch:FindFirstChildOfClass("Humanoid")
            if not h or h.Health <= 0 then bad = true; return end
        end)
        return not bad
    end

    -- ── ESP（仅 173 在场时创建，离开立即销毁）──
    local function clearMarks()
        for m, rec in pairs(marks) do
            pcall(function() if rec.hl then rec.hl:Destroy() end end)
            pcall(function() if rec.bb then rec.bb:Destroy() end end)
            marks[m] = nil
        end
    end

    local function ensureMark(m)
        if not L.Esp or marks[m] then return end
        pcall(function()
            local root = m.PrimaryPart or m:FindFirstChild("HumanoidRootPart")
                or m:FindFirstChildOfClass("BasePart")
            if not root then return end
            local hl = Instance.new("Highlight")
            hl.Name = "MCP173_HL"
            hl.FillColor = Color3.fromRGB(255, 70, 70)
            hl.OutlineColor = Color3.fromRGB(255, 215, 120)
            hl.FillTransparency = 0.62
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Adornee = m
            hl.Parent = m
            local bb = Instance.new("BillboardGui")
            bb.Name = "MCP173_BB"
            bb.Size = UDim2.new(0, 240, 0, 78)
            bb.AlwaysOnTop = true
            bb.MaxDistance = 600
            bb.Adornee = root
            bb.Parent = root
            local tl = Instance.new("TextLabel")
            tl.Name = "MCP173_TL"
            tl.Size = UDim2.new(1, 0, 1, 0)
            tl.BackgroundTransparency = 1
            tl.TextColor3 = Color3.fromRGB(255, 238, 190)
            tl.TextStrokeTransparency = 0.35
            tl.TextScaled = true
            tl.Font = Enum.Font.GothamBold
            tl.Text = "SCP-173"
            tl.Parent = bb
            marks[m] = { hl = hl, bb = bb, tl = tl }
        end)
    end

    -- 只读监听服务器效果广播（不吞、不 hook）
    local function hookEffects()
        findAction()
        if not effects then return false end
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        conns = {}
        pcall(function()
            conns[#conns + 1] = effects.OnClientEvent:Connect(function(kind, a)
                pcall(function()
                    if kind == "Snap" then
                        L.SnapWarns = L.SnapWarns + 1
                        log("⚠ 附近扭脖击杀 Snap @ " .. tostring(a))
                    elseif kind == "Burst" or kind == "PowerOut" then
                        L.BurstWarns = L.BurstWarns + 1
                        log("⚠ 灯光故障 " .. tostring(kind) .. " · 173 可能被放开")
                    elseif kind == "Moved" then
                        L.Status = "⚠ 173 刚瞬移"
                    end
                end)
            end)
        end)
        return true
    end

    local function disconnectAll()
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        conns = {}
    end

    -- 纯只读：读眨眼进度条段数，检测「进度条重置 = 发生了一次眨眼」
    local function readSeg()
        local n = -1
        pcall(function()
            if not blinkBar or blinkBar.Parent == nil then
                blinkBar = nil
                local pg = P:FindFirstChildOfClass("PlayerGui")
                local g = pg and pg:FindFirstChild("SCP173Blink")
                local meter = g and g:FindFirstChild("Meter")
                blinkBar = meter and meter:FindFirstChild("Bar")
            end
            if blinkBar then
                n = 0
                for i = 1, 20 do
                    local s = blinkBar:FindFirstChild("Segment" .. i)
                    if s and s.Visible then n = n + 1 end
                end
            end
        end)
        return n
    end

    -- 眼皮兜底：把 LidTop/LidBottom 高度与 Blackout 透明度钳回「睁眼」
    local function freezeLids()
        pcall(function()
            if not overlay or overlay.Parent == nil then
                overlay = nil; lids = {}
                local pg = P:FindFirstChildOfClass("PlayerGui")
                overlay = pg and pg:FindFirstChild("SCP173Overlay")
                if overlay then
                    for _, n in ipairs({ "LidTop", "LidBottom", "Blackout" }) do
                        local f = overlay:FindFirstChild(n)
                        if f then lids[#lids + 1] = f end
                    end
                end
            end
            for _, f in ipairs(lids) do
                if f.Name == "Blackout" then
                    if f.BackgroundTransparency ~= 1 then f.BackgroundTransparency = 1 end
                else
                    local sz = f.Size
                    if sz.Y.Scale ~= 0 or sz.Y.Offset ~= 0 then
                        f.Size = UDim2.new(sz.X.Scale, sz.X.Offset, 0, 0)
                    end
                end
            end
        end)
    end

    local function tick()
        if not eligible() then
            if not L.Paused then
                L.Paused = true
                restoreConfig()
                clearMarks()
                L.Status = "旁观/死亡/扮演SCP · 已自动放行（Config 已还原）"
                log("自动放行")
            end
            return
        end
        if L.Paused then L.Paused = false; log("恢复防护") end

        -- ① 核心拦截：改共享 Config 表 → 永不眨眼 / 永不发 Blink
        if L.NoBlink then
            if not patchConfig() then
                L.Error = "未找到 SCP173Config（等待生成）"
            else
                L.Error = nil
            end
        elseif L.Patched then
            restoreConfig()
        end

        -- ② 读 173 权威状态 + 刷新 ESP
        local m = scan173()
        if m then
            pcall(function()
                L.Observed = m:GetAttribute("Observed")
                L.Watchers = tonumber(m:GetAttribute("Watchers")) or 0
                L.Controller = m:GetAttribute("Controller")
                local now = WS:GetServerTimeNow()
                local tp = tonumber(m:GetAttribute("TeleportReadyAt"))
                local bu = tonumber(m:GetAttribute("BurstReadyAt"))
                L.TeleportIn = tp and math.max(0, tp - now) or -1
                L.BurstIn = bu and math.max(0, bu - now) or -1
                local root = m.PrimaryPart or m:FindFirstChild("HumanoidRootPart")
                    or m:FindFirstChildOfClass("BasePart")
                local ch = P.Character
                local hr = ch and ch:FindFirstChild("HumanoidRootPart")
                if root and hr then
                    L.Dist173 = (root.Position - hr.Position).Magnitude
                end
            end)
            if L.Esp then
                ensureMark(m)
                local rec = marks[m]
                if rec and rec.tl then
                    local dd = L.Dist173 >= 0 and string.format("%.0fm", L.Dist173) or "?"
                    local obs = (L.Observed == true) and "被注视✓" or "⚠无人注视"
                    rec.tl.Text = string.format(
                        "SCP-173 [%s]\n%s · 注视%d · %s\n瞬移%.1fs 爆发%.1fs",
                        tostring(L.Controller or "?"), obs, L.Watchers, dd,
                        math.max(0, L.TeleportIn), math.max(0, L.BurstIn))
                    rec.hl.FillColor = (L.Observed == true)
                        and Color3.fromRGB(90, 220, 120) or Color3.fromRGB(255, 70, 70)
                end
            end
        else
            clearMarks()
            L.Dist173 = -1
        end
        if not L.Esp then clearMarks() end

        -- ③ 眼皮兜底
        if L.FreezeLids then freezeLids() end

        -- ④ 只读自检：进度条从接近空跳回满 = 一次未被阻止的眨眼
        local seg = readSeg()
        if seg >= 0 then
            if lastSeg >= 0 and lastSeg <= 2 and seg >= 18 then
                L.BlinkDetected = L.BlinkDetected + 1
                log("检测到一次未被阻止的眨眼（进度条重置）")
            end
            lastSeg = seg
        end
        if L.NoBlink and L.Patched then
            L.BlinkSuppressed = math.floor(
                (os.clock() - L.StartAt) / math.max(1, L.OrigInterval))
        end

        if L.Error then
            L.Status = "不可用 (" .. tostring(L.Error) .. ")"
        elseif not L.Has173 then
            L.Status = "待命（当前无 173 实例）"
        elseif L.NoBlink and L.Patched then
            L.Status = "已拦截：永不眨眼 · Observed=" .. tostring(L.Observed)
        else
            L.Status = "监测中"
        end
    end

    local function startLoop()
        if L.Running then return end
        L.Running = true
        L.StartAt = os.clock()
        findAction()
        hookEffects()
        task.spawn(function()
            while L.Running and not L.Stopped and G.GUARD173 == L do
                pcall(tick)
                task.wait(0.25)
            end
        end)
    end

    -- ── 对外接口 ──
    L.SetEnabled = function(v)
        v = v and true or false
        if v == L.Enabled then return end
        L.Enabled = v
        if v then
            L.Stopped = false
            L.Error = nil
            findAction()
            startLoop()
            log("开启")
        else
            L.Running = false
            restoreConfig()
            disconnectAll()
            clearMarks()
            L.Status = "已关闭（Config 已还原、ESP 已清理）"
            log("关闭")
        end
    end
    L.SetNoBlink = function(v) L.NoBlink = v and true or false end
    L.SetFreezeLids = function(v) L.FreezeLids = v and true or false end
    L.SetEsp = function(v)
        L.Esp = v and true or false
        if not L.Esp then clearMarks() end
    end
    L.SetInterval = function(n)
        local x = tonumber(n)
        if not x or x < 4 then return end
        L.Interval = x
        if L.Patched then patchConfig() end
    end
    L.ResetCount = function()
        L.BlinkSuppressed = 0; L.BlinkDetected = 0
        L.SnapWarns = 0; L.BurstWarns = 0
        L.StartAt = os.clock()
    end
    L.Dump = function()
        return string.format(
            "Enabled=%s NoBlink=%s Patched=%s FreezeLids=%s Esp=%s Paused=%s | " ..
            "INTERVAL=%s(orig %s) Has173=%s Observed=%s Watchers=%d Controller=%s Dist=%.0f " ..
            "TeleIn=%.1f BurstIn=%.1f | BlinkSuppressed=%d BlinkDetected=%d " ..
            "SnapWarns=%d BurstWarns=%d Cfg=%d Action=%s Effects=%s Status=%s",
            tostring(L.Enabled), tostring(L.NoBlink), tostring(L.Patched),
            tostring(L.FreezeLids), tostring(L.Esp),
            tostring(L.Paused), tostring(L.Interval), tostring(L.OrigInterval),
            tostring(L.Has173), tostring(L.Observed), L.Watchers,
            tostring(L.Controller), L.Dist173, L.TeleportIn, L.BurstIn,
            L.BlinkSuppressed, L.BlinkDetected,
            L.SnapWarns, L.BurstWarns, #configs,
            tostring(action and action:GetFullName()),
            tostring(effects and effects:GetFullName()), tostring(L.Status))
    end
    L.Off = function()
        L.Stopped = true
        L.Enabled = false
        L.Running = false
        restoreConfig()
        disconnectAll()
        clearMarks()
        G.GUARD173 = nil
    end
end

-- ============================================================
-- SCP-294 饮料效果显示（防护栏开关项）· 拿起杯子显示效果
-- 机制：杯子是带 SCP294Cup 标签的 Tool，DrinkId 属性(=饮料表键，如 EnergyDrink)
--   才是查表 Id；DrinkToken 是服务器验证 UUID 不用于查表。查到官方 Name/Notice/Effect 显示。
-- 安全：只在 CoreGui 建显示 UI，不碰 PlayerGui/触摸层/相机；不 hook 任何
--   Remote；纯事件驱动、零全树扫描。缝合版默认开启，防护栏可关。
-- 对外：G.SCP294_DRINK.{SetEnabled, SetTime, List, Dump, Off, On, Enabled}
-- ============================================================
do
    if G.SCP294_DRINK and G.SCP294_DRINK.Off then pcall(function() G.SCP294_DRINK.Off() end) end
    G.SCP294_DRINK = nil

    local RS      = game:GetService("ReplicatedStorage")
    local CS      = game:GetService("CollectionService")
    local Players = game:GetService("Players")
    local LP      = Players.LocalPlayer

    local D = {
        Enabled = true, ShowTime = 6, TokenAttr = "DrinkToken", CupTag = "SCP294Cup",
        Shown = 0, Last = "无", Status = "运行中",
        gui = nil, conns = {}, hideAt = 0,
    }
    G.SCP294_DRINK = D

    local T = nil
