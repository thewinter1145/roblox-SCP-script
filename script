local function classifySCPRaw(m)
  if not m:IsA("Model") then return nil end
  local ln = string.lower(m.Name)
  for _, k in ipairs(STATIC_KW) do
    if string.find(ln, k, 1, true) then return nil end
  end
  local hum = m:FindFirstChildOfClass("Humanoid")
  if not hum then return nil end
  local anc = m.Parent
  while anc and anc ~= WS do
    if anc.Name == "Lobby" then return nil end
    anc = anc.Parent
  end
  local cls = tostring(m:GetAttribute("Class") or "")
  local ctl = tostring(m:GetAttribute("Controller") or "")
  local disp = tostring(hum.DisplayName or "")

  local okPC, pl = pcall(function() return PlayersSvc:GetPlayerFromCharacter(m) end)
  if okPC and pl then
    local fields = {}
    local nameFields = {}
    local function push(v)
      if v ~= nil and tostring(v) ~= "" then fields[#fields + 1] = tostring(v) end
    end
    local function pushName(v)
      if v ~= nil and tostring(v) ~= "" then nameFields[#nameFields + 1] = tostring(v) end
    end
    push(cls); push(ctl)
    pushName(disp)
    for _, k in ipairs({ "Class", "Controller", "Role", "SCP", "CurrentSCP",
              "PlayingAs", "SCPNumber", "SCPType", "SCPClass", "Form" }) do
      pcall(function() push(m:GetAttribute(k)) end)
      pcall(function() push(pl:GetAttribute(k)) end)
    end
    pcall(function() if pl.Team then push(pl.Team.Name) end end)
    pcall(function()
      for _, t in ipairs(game:GetService("CollectionService"):GetTags(m)) do
        if not string.find(string.lower(t), "lured", 1, true) then push(t) end
      end
    end)
    for _, f in ipairs(fields) do
      local n = scpNumberIn(f, true) or scpNumberIn(f, false)
      if n then return "SCP-" .. n end
    end
    for _, f in ipairs(nameFields) do
      local n = scpNumberIn(f, false)
      if n then return "SCP-" .. n end
    end
    for _, f in ipairs(fields) do
      if scpWordIn(f) or string.find(string.lower(f), "scpcharacter", 1, true) then
        return "SCP-???"
      end
    end
    return nil
  end
  local num = scpNumberIn(cls, true) or scpNumberIn(ctl, true)
  if num then return "SCP-" .. num end
  num = scpNumberIn(m.Name, false) or scpNumberIn(disp, false)
  if num then return "SCP-" .. num end
  local all = string.lower(m.Name .. " " .. disp .. " " .. cls)
  if string.find(all, "scp[-_]?%d", 1) then
    local lbl = (string.find(ln, "scp", 1, true) and m.Name)
      or (string.find(string.lower(disp), "scp", 1, true) and disp) or cls
    return lbl
  end
  return nil
end

local function classifySCP(m)
  local label = classifySCPRaw(m)
  if not label then return nil end
  if isInactiveBody(m) then return nil end
  return label
end
pcall(function() G.classifySCP = classifySCP end)

local function isLocalSCP()
  local ch = P and P.Character
  if ch and classifySCP(ch) then return true end
  local function humanWord(t)
    for _, h in ipairs(HUMAN_HINT) do
      if string.find(t, h, 1, true) then return true end
    end
    return false
  end
  for _, k in ipairs({ "Class", "Team", "Role", "SCP", "CurrentSCP", "PlayingAs" }) do
    local ok, v = pcall(function() return P:GetAttribute(k) end)
    if ok and v ~= nil then
      local t = string.lower(tostring(v))
      if scpNumberIn(v, true) then return true end
      if not humanWord(t) and (t == "scp" or string.find(t, "scpcharacter", 1, true)) then
        return true
      end
    end
  end
  local okT, team = pcall(function() return P.Team end)
  if okT and team then
    local t = string.lower(tostring(team.Name))
    if scpNumberIn(t, true) then return true end
    if not humanWord(t) and (t == "scp" or string.find(t, "scpcharacter", 1, true)) then
      return true
    end
  end
  return false
end

