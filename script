        lbl.BackgroundTransparency = 1
        lbl.Text = text
        lbl.TextColor3 = Color3.fromRGB(225, 230, 240)
        lbl.Font = HEAVY
        lbl.TextSize = 14
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = row
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0.34, 0, 0, 26)
        btn.Position = UDim2.new(0.66, 0, 0, 4)
        btn.BorderSizePixel = 0
        btn.Text = "关"
        btn.TextColor3 = Color3.fromRGB(230, 235, 245)
        btn.Font = HEAVY
        btn.TextSize = 13
        btn.Parent = row
        local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(0, 6); bc.Parent = btn
        local state = getv()
        local function refresh()
            if state then btn.BackgroundColor3 = ONC; btn.Text = "开" else btn.BackgroundColor3 = OFFC; btn.Text = "关" end
        end
        refresh()
        btn.MouseButton1Click:Connect(function()
            state = not (getv() and true or false)   -- 以真实状态取反，避免显示与实际脱节
            setv(state)
            if G.CRATE_ESP then G.CRATE_ESP.Reconcile() end
            refresh()
        end)
        -- 允许外部（总开关联动）把按钮显示拉回真实状态
        row.Sync = function()
            state = getv() and true or false
            refresh()
        end
        return row
    end

