-- ESP 专用：这几号一律不画框（999 友好史莱姆 / 131 眼球 / 005 钥匙）
-- 只挡「显示」；isLocalSCP / GUNBOT / 自动技能仍用原 classifySCP，行为不变
local ESP_HIDE_NUMS = { ["999"] = true, ["131"] = true, ["005"] = true }
-- label 可能是 "SCP-999"，也可能是原始模型名 "SCP999_Model"，两种都要认
local function labelHidden(label)
    if not label then return false end
    local c = compact(label)
    for k in pairs(ESP_HIDE_NUMS) do
        local pat = "scp" .. k
        local i = 1
        while true do
            i = string.find(c, pat, i, true)
            if not i then break end
            local nxt = string.sub(c, i + #pat, i + #pat)
            if not string.match(nxt, "%d") then return true end
            i = i + 1
        end
    end
    return false
end
local function classifyForESP(m)
    local label = classifySCP(m)
    if labelHidden(label) then return nil end
    return label
end
-- 原分类命中被隐藏编号（用于挡「玩家透视」把它当普通玩家画出来）
local function hiddenSCP(m)
    return labelHidden(classifySCP(m))
end
pcall(function() G.classifyForESP = classifyForESP end)

-- 本地玩家是否 SCP（猎杀模式判定）
-- 【v14 修复】旧版只要 Team / 属性里出现 "scp" 字样就判「自己是 SCP」，
--   像 "SCP Foundation"（基金会人类阵营）、"SCP Personnel" 会误命中 →
--   HuntMode=true → fullScan 跳过 SCP、refreshChams 清掉全部 SCP 标记，
--   表现就是「所有 SCP 突然都不透视了」。
--   现在只认：① 明确 SCP 编号（049/173/...）② 裸 "scp" 角色值
--   ③ SCPCharacter 标签；并排除 HUMAN_HINT 里的人类阵营词。
local function isLocalSCP()
    local ch = P and P.Character
    if ch and classifySCP(ch) then return true end
    local function humanWord(t)
        for _, h in ipairs(HUMAN_HINT) do
            if string.find(t, h, 1, true) then return true end
        end
        return false
    end
    for _, k in ipairs({ "Class", "Team", "Role", "SCP", "CurrentSCP", "PlayingAs" }) do
        local ok, v = pcall(function() return P:GetAttribute(k) end)
        if ok and v ~= nil then
            local t = string.lower(tostring(v))
            if scpNumberIn(v, true) then return true end
            if not humanWord(t) and (t == "scp" or string.find(t, "scpcharacter", 1, true)) then
                return true
            end
        end
    end
    local okT, team = pcall(function() return P.Team end)
    if okT and team then
        local t = string.lower(tostring(team.Name))
        if scpNumberIn(t, true) then return true end
        if not humanWord(t) and (t == "scp" or string.find(t, "scpcharacter", 1, true)) then
            return true
        end
    end
    return false
end

