  local function scanCrates()
    local list = {}
    for _, x in ipairs(WS:GetDescendants()) do
      if isCratePP(x) then
        local w = ppWorld(x)
        if w then list[#list + 1] = { pp = x, w = w } end
      end
    end
    F.Crates = #list
    return list
  end

  local function lootOne(c)
    local pp, w = c.pp, c.w
    if not isCratePP(pp) then return false end
    tp(w + Vector3.new(0, 1.6, 0))
    task.wait(0.08)
    firePrompt(pp)
    for _ = 1, 3 do
      task.wait(0.15)
      if not pp.Parent then return true end
      if not pp.Enabled then return true end
      firePrompt(pp)
    end
    pcall(function()
      local hum = getHum()
      if hum then hum:MoveTo(w) end
    end)
    task.wait(0.22)
    if pp.Parent and pp.Enabled then firePrompt(pp) end
    task.wait(0.18)
    return (not pp.Parent) or (not pp.Enabled)
  end

  local function lootCrates()
    local t0 = os.clock()
    local crates = scanCrates()
    F.Looted = 0
    if #crates == 0 then
      F.Phase = "无箱可捡"
      return 0
    end
    for i, c in ipairs(crates) do
      if not F.Enabled or not F.Looting then break end
      if isCratePP(c.pp) then
        F.Phase = string.format("捡箱 %d/%d", i, #crates)
        if lootOne(c) then
          F.Looted = F.Looted + 1
        end
        F.LastCrate = string.format("(%.0f,%.0f,%.0f)",
          c.w.X, c.w.Y, c.w.Z)
      end
    end
    F.Phase = string.format("捡箱完成 %d/%d · 用时 %.1fs",
      F.Looted, #crates, os.clock() - t0)
    return F.Looted
  end

