-- 本地玩家是否 SCP（猎杀模式判定）
-- 【v14 修复】旧版只要 Team / 属性里出现 "scp" 字样就判「自己是 SCP」，
--   像 "SCP Foundation"（基金会人类阵营）、"SCP Personnel" 会误命中 →
--   HuntMode=true → fullScan 跳过 SCP、refreshChams 清掉全部 SCP 标记，
--   表现就是「所有 SCP 突然都不透视了」。
--   现在只认：① 明确 SCP 编号（049/173/...）② 裸 "scp" 角色值
--   ③ SCPCharacter 标签；并排除 HUMAN_HINT 里的人类阵营词。
local function isLocalSCP()
    local ch = P and P.Character
    if ch and classifySCP(ch) then return true end
    local function humanWord(t)
        for _, h in ipairs(HUMAN_HINT) do
            if string.find(t, h, 1, true) then return true end
        end
        return false
    end
    for _, k in ipairs({ "Class", "Team", "Role", "SCP", "CurrentSCP", "PlayingAs" }) do
        local ok, v = pcall(function() return P:GetAttribute(k) end)
        if ok and v ~= nil then
            local t = string.lower(tostring(v))
            if scpNumberIn(v, true) then return true end
            if not humanWord(t) and (t == "scp" or string.find(t, "scpcharacter", 1, true)) then
                return true
            end
        end
    end
    local okT, team = pcall(function() return P.Team end)
    if okT and team then
        local t = string.lower(tostring(team.Name))
        if scpNumberIn(t, true) then return true end
        if not humanWord(t) and (t == "scp" or string.find(t, "scpcharacter", 1, true)) then
            return true
        end
    end
    return false
end

