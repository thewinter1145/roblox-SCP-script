    -- 节点通电：Start upload → 触发后藏地板下保持 15s+
    -- nodePos: 节点坐标（来自 targets 的 NODE/UPLOAD label）
    local function doNode(nodePos)
        F.Current = string.format("节点通电 @ %.0f,%.0f", nodePos.X, nodePos.Z)
        -- 找该节点位置的 PP（不过滤 enabled，上传中 PP 会变 false）
        local p = findPP("start upload", nil, nodePos, false)
        if not p or not p.pos then
            F.Phase = "③ 找不到该节点的上传电脑"
            return false
        end
        -- 1) 若 PP 仍可触发 → 近距离触发并即时验证是否真的开始上传
        --    失败(PP 没变 disabled)立即返回，主循环下一轮马上重试，不空等
        if p.enabled then
            if not fireUploadAndVerify(p, nil, 4) then
                F.Phase = "③ 节点互动失败(即时重试)"
                return false
            end
        end
        -- 2) 上传已确认开始 → 藏到【电脑屏幕】正上方锚定保持，停滞则自适应降高重定位
        --    （用 p.pos 屏幕实际位置，不是 nodePos；两者可能相差很远）
        local function nodeDone()
            for _, t in ipairs(readTargets()) do
                if t.pos and (t.pos - nodePos).Magnitude < 2 then return false end
            end
            return true   -- 该节点从 targets 消失 = 完成
        end
        holdUpload(p.pos, F.NodeHold, nodeDone)
        return true
    end

