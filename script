  local function onPhase()
    if not F.Enabled then return end
    local phase = RS:GetAttribute("RoundPhase")
    local mode  = RS:GetAttribute("RoundMode")

    if phase == "Voting" then
      F.Mode = "投票"
      F.LootedRound = false
      if F.AutoVote and not F.VotedThisPhase then
        F.VotedThisPhase = true
        task.spawn(function()
          task.wait(0.6)
          local ok, want = voteRound()
          F.Phase = ok and ("已投 " .. tostring(want)) or "投票失败"
        end)
      elseif not F.AutoVote then
        F.Phase = "投票中(不自动投票)"
      end
    elseif phase == "Playing" then
      F.VotedThisPhase = false
      F.Mode = tostring(mode or "?")
      if mode == "Escape" then
-- ==========
        if LP:GetAttribute("Role") == "SCP" or LP:GetAttribute("Ghost") == true then
          F.Looting = false
          setEscape(false)
          F.Phase = "任务模式：本局你是 SCP/旁观"
        elseif F.Looting then
          F.Phase = "任务模式：捡箱中（捡完自动交权）"
        elseif F.AutoLoot and not F.LootedRound then
          local e = escapeEngine()
          if e and e.Enabled then
            F.LootedRound = true
            F.Phase = "任务模式：逃脱进行中(跳过捡箱)"
          else
            F.Looting = true
            F.Phase = "任务模式：先捡箱"
            task.spawn(function()
              local n = lootCrates()
              F.LootedRound = true
              F.Looting = false
              if not F.Enabled then return end
              if shouldEscape() then
                if setEscape(true) then
                  F.Phase = string.format("任务模式：捡箱%d个 → 自动逃脱", n)
                else
                  F.Phase = "任务模式：缺少 AUTOESCAPE 引擎"
                end
              else
                F.Phase = "任务模式：未参与(旁观/已逃脱)"
              end
            end)
          end
        elseif shouldEscape() then
          F.Phase = "任务模式：自动逃脱"
          if not setEscape(true) then
            F.Phase = "任务模式：缺少 AUTOESCAPE 引擎"
          end
        else
          setEscape(false)
          F.Phase = "任务模式：未参与(旁观/已逃脱)"
        end
      else
-- ==========
        setEscape(false)
        if F.AutoLoot and not F.Looting then
          F.Looting = true
          task.spawn(function()
            F.Phase = "开始捡箱"
            lootCrates()
            if F.Enabled and F.AutoRoof then
              local hunt = G.STAFFHUNT
              if hunt and hunt.HasTarget and hunt.HasTarget() then
                F.Phase = "发现特殊研究员：跳过躲藏"
              else
                gotoRoof()
              end
            end
            F.Looting = false
            if F.Enabled and F.Phase ~= "已传天花板" then
              F.Phase = "挂机中"
            end
          end)
        end
      end
    elseif phase == "Intermission" or phase == "Lobby" or phase == "Results" then
      F.Looting = false
      F.VotedThisPhase = false
      F.Crates, F.Looted = 0, 0
      F.LootedRound = false
      F.Mode = "无"
      setEscape(false)
      F.Phase = (phase == "Lobby") and "大厅" or ((phase == "Results") and "回合结算" or "局间休息")
    end
  end

  local function start()
    if F.Conn then return end
    F.Conn = RS:GetAttributeChangedSignal("RoundPhase"):Connect(onPhase)
    F.ModeConn = RS:GetAttributeChangedSignal("RoundMode"):Connect(onPhase)
    pcall(onPhase)
    if F.AutoClaim then
      F.ClaimConn = task.spawn(function()
        while G.AUTOFARM == F do
          task.wait(F.ClaimEvery)
          if F.Enabled and F.AutoClaim and not F.Claiming then
            pcall(claimSmart)
          end
        end
      end)
      -- 回合/模式变化时立即检测奖励（结算常在此刻发生）
      F.RewardConn = RS:GetAttributeChangedSignal("RoundPhase"):Connect(function()
        task.spawn(function() task.wait(1.2); fastClaim("回合结算") end)
      end)
      -- 玩家奖励属性变化时立即领
      pcall(function()
        F.RewardAttrConn = LP:GetAttributeChangedSignal("RewardReady"):Connect(function()
          fastClaim("奖励属性")
        end)
      end)
    end
  end
  local function stop()
    setEscape(false)
    if F.Conn then pcall(function() F.Conn:Disconnect() end) end
    if F.ModeConn then pcall(function() F.ModeConn:Disconnect() end) end
    if F.RewardConn then pcall(function() F.RewardConn:Disconnect() end) end
    if F.RewardAttrConn then pcall(function() F.RewardAttrConn:Disconnect() end) end
    F.Conn = nil
    F.ModeConn = nil
    F.RewardConn = nil
    F.RewardAttrConn = nil
    F.Looting = false
  end

