        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1, 0, 0, 30)
        b.Position = UDim2.new(0, 0, 0, y)
        b.BackgroundColor3 = Color3.fromRGB(40, 70, 110)
        b.BorderSizePixel = 0
        b.TextColor3 = Color3.fromRGB(225, 240, 255)
        b.Font = HEAVY
        b.TextSize = 13
        b.Parent = parent
        local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 6); c.Parent = b
        local function refresh() b.Text = prefix .. tostring(getv()) end
        refresh()
        b.MouseButton1Click:Connect(function()
            local cur = tostring(getv())
            local idx = 1
            for i, o in ipairs(opts) do if tostring(o) == cur then idx = i end end
            setv(opts[idx % #opts + 1])
            refresh()
        end)
        return b
    end

