        GB:AddToggle("esp" .. key, {
            Text = text, Default = (key == "SCP"),   -- v14：与引擎默认一致
            Callback = function(v)
                if G.CRATE_ESP then
                    G.CRATE_ESP[key .. "Enabled"] = v
                    G.CRATE_ESP.Reconcile()
                end
                -- SCP透视 就是总闸：饮水机 + 新SCP 物件一并跟随，不再单独列表
