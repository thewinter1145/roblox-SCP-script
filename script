local SCP_NUMS = { "682", "173", "096", "049", "106", "035", "777", "939", "999" }
local function compact(s)
    return string.gsub(string.lower(tostring(s or "")), "[-_%s]", "")
end
local function scpNumberIn(s, allowBare)
    local c = compact(s)
    if allowBare then
        for _, num in ipairs(SCP_NUMS) do
            if c == num then return num end
        end
        local bare = string.match(c, "^(%d%d%d)$")   -- 任意 3 位纯编号
        if bare then return bare end
    end
    for _, num in ipairs(SCP_NUMS) do
        if string.find(c, "scp" .. num, 1, true) then return num end
    end
    local n = string.match(c, "scp(%d%d%d)")          -- 通用 SCPxxx 标签
    if n then return n end
    return nil
end

-- 权威字段里含 "scp" 字样即视为 SCP（无具体编号时统一返回 "SCP"）。
-- 仅用于 Class / Controller / 玩家属性 / Team 这类游戏自己写的字段，
-- 绝不用于玩家昵称或 DisplayName，避免「昵称带 SCP」误判。
-- 排除常见人类阵营词，防止把 "SCP Foundation"/"MTF" 之类判成 SCP。
local HUMAN_HINT = { "foundation", "mtf", "classd", "scientist",
                     "security", "researcher", "personnel" }
local function scpWordIn(s)
    local c = compact(s)
    if not string.find(c, "scp", 1, true) then return nil end
    for _, h in ipairs(HUMAN_HINT) do
        if string.find(c, h, 1, true) then return nil end
    end
    return "SCP"
end

local STATIC_KW = { "chamber", "zone", "room", "cell", "instances", "spawn",
                    "sludge", "sense", "pestilence", "ragdoll", "door", "gate",
                    "wall", "sign", "prop", "decor", "display", "corpse", "statue" }

-- ============================================================
-- 失效 / 残留 SCP 身体判定
-- SCP-035 是「附身面具」：把面具戴到别人身上令其死亡，被戴的人可能变成
-- 新的 035。宿主转移后，上一具身体仍带着 035 的 Class/名字标记留在场上，
-- 但它已经不是有效 SCP —— 这正是「透视到 035 之前的身体」的原因。
-- 定义在全局层，供 classifySCP 与 ESP 刷新循环共用。
-- 注意：只在「已判出是 SCP」之后调用，避免对 Workspace 每个 Model
--       都跑一轮属性检测（防止全扫描掉帧）。
-- ============================================================
local function isInactiveBody(m)
    local hum = m:FindFirstChildOfClass("Humanoid")
    if hum then
        local ok, hp = pcall(function() return hum.Health end)
        if ok and hp and hp <= 0 then return true end
        local okS, st = pcall(function() return hum:GetState() end)
        if okS and st == Enum.HumanoidStateType.Dead then return true end
    end
    for _, k in ipairs({ "Dead", "IsDead", "IsCorpse", "Corpse", "IsRagdoll",
                         "Inactive", "IsInactive", "Abandoned", "IsAbandoned",
                         "OldBody", "IsOldBody", "IsShell", "IsEmpty" }) do
        local ok, v = pcall(function() return m:GetAttribute(k) end)
        if ok and v == true then return true end
    end
    local n = string.lower(tostring(m.Name))
    for _, w in ipairs({ "corpse", "ragdoll", "dead", "remains", "oldbody",
                         "oldshell", "abandoned", "bodyshell", "emptybody" }) do
        if string.find(n, w, 1, true) then return true end
    end
    return false
end

