local function buildUI()
  local pg
  pcall(function() pg = P and P:WaitForChild("PlayerGui", 6) end)
  if not pg then pcall(function() pg = game:GetService("CoreGui") end) end
  if not pg then
    warn("[ESP] 未找到 PlayerGui，UI 跳过（透视引擎仍在后台运行，可用 G.CRATE_ESP.Reconcile() 开关）")
    return
  end

  local Library
  local okLib = pcall(function()
    Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/NightForRoblox/Obsidian/refs/heads/main/Library.lua"))()
  end)
  if not okLib or not Library then
    pcall(function()
      Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/deividcomsono/Obsidian/refs/heads/main/Library.lua"))()
    end)
  end

  if Library then
    local okOb, err = pcall(buildObsidianUI, Library)
    if okOb then return end
    warn("[ESP] 黑曜石构建失败，回退原生面板: " .. tostring(err))
  else
    warn("[ESP] 黑曜石库加载失败，回退原生面板")
  end
  pcall(buildNativeUI, pg)
end

task.spawn(function()
  local ok, err = pcall(buildUI)
  if not ok then warn("[ESP] UI 加载失败: " .. tostring(err)) end
end)
