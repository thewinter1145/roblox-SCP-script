    -- 通用开关行；parent 指定挂到哪一页
    local function makeToggle(y, text, getv, setv, parent)
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, 34)
        row.Position = UDim2.new(0, 0, 0, y)
        row.BackgroundTransparency = 1
