  doExit = function(exitPos)
    if LP:GetAttribute("Escaped") == true then return true end
    F.Current = "坐电梯逃离"
    local function valid(p)
      if not p then return false end
      if p.X ~= p.X or p.Y ~= p.Y or p.Z ~= p.Z then return false end
      if math.abs(p.X) > 5000 or math.abs(p.Z) > 5000 then return false end
      if p.Y < -100 or p.Y > 2000 then return false end
      return true
    end
    local src = "服务器属性"
    if not valid(exitPos) then
      local alt, asrc = readLiftPos()
      if valid(alt) then exitPos, src = alt, tostring(asrc or "回退来源") end
    end
    if not valid(exitPos) then
