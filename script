  local function findRoof()
    local best, bestTop = nil, -math.huge
    for _, p in ipairs(WS:GetDescendants()) do
      if p:IsA("BasePart") then
        local nm = lo(p.Name)
        if string.find(nm, "roof", 1, true) or string.find(nm, "ceiling", 1, true) then
          local top = p.Position.Y + p.Size.Y / 2
          if top > bestTop then bestTop = top; best = p end
        end
      end
    end
    return best, bestTop
  end

  local function gotoRoof()
    local roof, top = findRoof()
    if not roof then
      F.Phase = "无天花板"
      return false
    end
    local target = roof.Position + Vector3.new(0, roof.Size.Y / 2 + 5, 0)
    local ok = tp(target)
    if ok then F.Phase = "已传天花板" end
    return ok
  end

-- ==========
  -- 成就奖励（MISSIONS → ACHIEVEMENTS）：实测接口 ClaimAchievement(key)，服务器判定可领返回 true
  local ACH_KEYS = {
    "Streak","Played","Spec939","Research","Escapes","SCPKills","Alive",
    "Emotes","Level","SCPRounds","Slides","Spec049","SCPWins","Doors",
    "Crates","Quests","Lifer","Spec096","Survive",
  }
  local ACH_SIG_KEYS = {"Wins","Escapes","Level","QuestsDone","RoundsPlayed","SCPWins",
    "BestStreak","Crates","Doors","Slides","SurviveSeconds","RoundsSurvived","SCPKills"}
  local function achSignature(state)
    if type(state) ~= "table" or type(state.Mission) ~= "table" then return "" end
    local parts = {}
    -- 覆盖全部字段，任何成就对应统计一变就立即触发
    local ach = state.Mission.Ach or {}
    for k, v in pairs(ach) do parts[#parts + 1] = "a" .. tostring(k) .. "=" .. tostring(v) end
    local val = state.Mission.Values or {}
    for k, v in pairs(val) do parts[#parts + 1] = "v" .. tostring(k) .. "=" .. tostring(v) end
    table.sort(parts)
    return table.concat(parts, "|")
  end

  local function claimRewards()
    local ok, res = pcall(function()
      local remotes = RS:FindFirstChild("Remotes")
      local rr = remotes and remotes:FindFirstChild("RewardsRequest")
      if not rr then return nil end
      local a, b, state = rr:InvokeServer("Snapshot")
      return { rr = rr, state = state }
    end)
    if not ok or not res then return 0, "无RewardsRequest" end
    local rr, state = res.rr, res.state
    if type(state) ~= "table" or state.Loaded ~= true then return 0, "未加载" end
    local n = 0
    local what = {}
    if state.CanClaim == true then
      pcall(function() rr:InvokeServer("ClaimDaily", nil) end)
      n = n + 1; what[#what + 1] = "每日"
    end
    if type(state.Quests) == "table" then
      for i, q in ipairs(state.Quests) do
        if type(q) == "table" and q.Claimed ~= true and (q.Progress or 0) >= (q.Target or 0) then
          pcall(function() rr:InvokeServer("ClaimQuest", i) end)
          n = n + 1; what[#what + 1] = "任务" .. i
        end
      end
    end
    -- 时长奖励（已按用户要求关闭，不再领取）
    -- 成就奖励：签名变化立即全扫；4 秒兜底全扫，防止服务器 Snapshot 缓存延迟导致漏领
    local sig = achSignature(state)
    local nowt = tick()
    local due = (nowt - (F._achSigT or 0)) >= 4
    if sig ~= "" and (due or sig ~= F._achSig) then
      for _, k in ipairs(ACH_KEYS) do
        task.wait(0.03)
        local okc, got = pcall(function() return rr:InvokeServer("ClaimAchievement", k) end)
        if okc and got == true then
          n = n + 1
          F.AchClaims = F.AchClaims + 1
          what[#what + 1] = "成就:" .. k
        end
      end
      F._achSig = sig
      F._achSigT = nowt
    end
    if n > 0 then
      F.Claims = F.Claims + n
      F.LastClaim = table.concat(what, ",")
    end
    return n, table.concat(what, ",")
  end

  -- 智能领奖：检测到可领立即申请，并级联复查直到清空（事件驱动、不再干等20秒）
  local function claimSmart()
    if F.Claiming then return 0, "领奖中" end
    F.Claiming = true
    local total, allWhat = 0, {}
    local guard = 0
    local ok = true
    while ok and guard < 12 do
      guard = guard + 1
      local n, what = claimRewards()
      if n and n > 0 then
        total = total + n
        if what and what ~= "" then allWhat[#allWhat + 1] = what end
        if F.ClaimBurst then
          task.wait(0.4)  -- 给服务器结算时间后立刻复查
        else
          ok = false
        end
      else
        ok = false
      end
    end
    F.Claiming = false
    if total > 0 then
      F.Phase = "领奖：+" .. tostring(total) .. " " .. table.concat(allWhat, ",")
    end
    return total, table.concat(allWhat, ",")
  end

  -- 有奖励信号时立刻领：回合结算 / 玩家属性变化都会调用
  local claimDebounce = 0
  local function fastClaim(reason)
    if not F.Enabled or not F.AutoClaim then return end
    local now = tick()
    if now - claimDebounce < 0.5 then return end  -- 防抖，避免同一信号重复触发
    claimDebounce = now
    task.spawn(function()
      task.wait(0.5)  -- 稍等服务器把奖励状态落定
      if F.Enabled and F.AutoClaim then
        local n = claimSmart()
        if n > 0 then F.LastClaim = F.LastClaim .. " [" .. tostring(reason or "事件") .. "]" end
      end
    end)
  end

