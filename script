      F.LastExit = nil
      return false
    end
    F.LastExit = exitPos
    F.ExitSrc = src
    if (not F._warnExit) or (F._warnExit - exitPos).Magnitude > 2
      or (os.clock() - (F._warnAt or 0)) > 10 then
      F._warnExit, F._warnAt = exitPos, os.clock()
      warn(string.format("[AUTOESCAPE] 前往逃离点 %.0f,%.0f,%.0f · 来源=%s",
        exitPos.X, exitPos.Y, exitPos.Z, src))
