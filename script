        pcall(function() id1 = tool:GetAttribute("DrinkId") end)
        pcall(function() id2 = tool:GetAttribute(D.TokenAttr) end)
        local drink, id = lookup(id1)
        if not drink then drink, id = lookup(id2) end
        if drink then
            show(drink, id)
        else
            buildGUI()
            if D.gui then pcall(function()
                D.title.Text = "🥤 饮料（未知）"
                D.desc.Text = "DrinkId=" .. tostring(id1) .. " Token=" .. tostring(id2) .. "（表中未找到）"
                D.box.Visible = true
            end) end
            D.Last = "未知 id=" .. tostring(id1) .. " token=" .. tostring(id2)
            D.hideAt = os.clock() + D.ShowTime
        end
    end

    local function watchChar(ch)
        if not ch then return end
        pcall(function()
            table.insert(D.conns, ch.ChildAdded:Connect(function(tool) task.defer(checkCup, tool) end))
        end)
    end

    local function startWatching()
        if LP then
            table.insert(D.conns, LP.CharacterAdded:Connect(watchChar))
            if LP.Character then watchChar(LP.Character) end
            pcall(function()
                local bg = LP:FindFirstChildOfClass("Backpack")
                if bg then table.insert(D.conns, bg.ChildAdded:Connect(function(tool) task.defer(checkCup, tool) end)) end
                table.insert(D.conns, LP.ChildAdded:Connect(function(o)
                    if o:IsA("Backpack") then table.insert(D.conns, o.ChildAdded:Connect(function(tool) task.defer(checkCup, tool) end)) end
                end))
                if LP.Character then
                    for _, tool in ipairs(LP.Character:GetChildren()) do checkCup(tool) end
                end
            end)
        end
        table.insert(D.conns, game:GetService("RunService").Heartbeat:Connect(function()
            if D.gui and D.box and D.box.Visible and os.clock() >= D.hideAt then
                pcall(function() D.box.Visible = false end)
            end
        end))
    end
    startWatching()

    D.SetEnabled = function(v)
        if v then
            if D.Enabled then return true end
            D.Enabled = true
            D.Status = "运行中"
            startWatching()
        else
            D.Enabled = false
            for _, c in ipairs(D.conns) do pcall(function() c:Disconnect() end) end
            D.conns = {}
            if D.gui and D.box then pcall(function() D.box.Visible = false end) end
            D.Status = "已关闭"
        end
        return D.Enabled
    end
    D.Off = function()
        D.Enabled = false
        for _, c in ipairs(D.conns) do pcall(function() c:Disconnect() end) end
        D.conns = {}
        if D.gui then pcall(function() D.gui:Destroy() end) end
        D.gui, D.box = nil, nil
        D.Status = "已关闭"
    end
    D.On = function()
        if D.gui then pcall(function() D.gui:Destroy() end) end
        D.gui, D.box = nil, nil
        for _, c in ipairs(D.conns) do pcall(function() c:Disconnect() end) end
        D.conns = {}
        D.Enabled = true
        D.Status = "运行中"
        startWatching()
    end
    D.SetTime = function(s) if type(s)=="number" and s>0 then D.ShowTime=s end return D.ShowTime end
    D.List = function()
        local out = {}
        if type(T)=="table" and type(T.ById)=="table" then
