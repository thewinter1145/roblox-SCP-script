      F.VotedThisPhase = false
      F.CountedThisRound = false
      F.Current = "无"
      F.Targets = 0
      F.LocalDone = {}
      F.LastExit = nil
      F.ExitSrc = "无"
      F._exitScanPos = nil
      F._exitScanAt = -10
      F._warnExit = nil
